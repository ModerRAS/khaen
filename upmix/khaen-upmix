def cmd_container(args):
    """生成 H16 容器输入相关产物：上混 profile（from 容器）、直通 profile、autodetect 配置。"""
    presets = load_presets(args.presets)
    in_layout = args.input_layout or "h16-7.1.4"
    fs = args.fs or 48000
    outdir = args.output
    prof_dir = os.path.join(outdir, "profiles")
    cam_dir = os.path.join(outdir, "camilladsp")
    os.makedirs(prof_dir, exist_ok=True)
    os.makedirs(cam_dir, exist_ok=True)
    files = []

    def add(p):
        files.append(p)

    ids = args.preset or sorted(presets["presets"])
    layouts_done = set()
    for pid in ids:
        if pid not in presets["presets"]:
            die("未知预设 %r" % pid)
        plan = build_plan(pid, presets, fs=fs, input_layout=in_layout, path="stereo")
        # C-22：容器 profile 与 2ch 同名会撞 WebUI/CLI 的 profile.name；内部名加 -h16 区分（文件名不变）
        plan["profile_name"] = plan["id"] + "-h16"
        plan["description"] = plan["description"] + "（H16 容器输入）"
        pfile = os.path.join(prof_dir, "%s-from-%s.yml" % (plan["id"], in_layout))
        write_text(pfile, profile_text(plan))
        add(pfile)
        layout = plan["layout"]
        if layout not in layouts_done:
            layouts_done.add(layout)
            pplan = build_plan(pid, presets, fs=fs, input_layout=in_layout, path="passthrough")
            ppfile = os.path.join(prof_dir, "passthrough-%s-to-%s.yml" % (in_layout, layout))
            write_text(ppfile, profile_text(pplan))
            add(ppfile)
        cap = args.capture_channels or plan["input_channels"]
        pb = args.playback_channels or 22
        devices = _devices_alsa(plan, args.chunksize or plan["chunksize"],
                                args.target_level or plan["target_level"],
                                args.adjust_period or plan["adjust_period"],
                                args.capture_device, args.capture_format,
                                args.playback_device, args.playback_format, pb, fs,
                                enable_rate_adjust=not args.no_rate_adjust,
                                capture_channels=cap)
        cfile = os.path.join(cam_dir, "autodetect-%s-%s.yml" % (plan["id"], in_layout))
        cfg = render_autodetect(plan, build_plan(pid, presets, fs=fs, input_layout=in_layout,
                                                 path="passthrough"),
                                devices, capture_channels=cap, fader_ramp=args.fader_ramp)
        write_text(cfile, autodetect_text(plan, cfg))
        add(cfile)
        print("生成：%s / %s" % (pfile, cfile))
    manifest = {"schema": "khaen-upmix-container/v1", "input_layout": in_layout, "fs": fs,
                "files": [{"path": os.path.relpath(f, outdir), "sha256": sha256_file(f),
                           "size": os.path.getsize(f)} for f in files]}
    mpath = os.path.join(outdir, "manifest.json")
    write_text(mpath, json.dumps(manifest, ensure_ascii=False, indent=2))
    print("清单：%s（%d 个文件）" % (mpath, len(files)))
    return 0


def _assert_builtin_consistency(layout_presets):
    """check 断言：内置布局必须与 layout-presets 逐项一致（唯一真相是板端 presets）。

    返回问题列表；layout-presets 缺失也算问题（check 不用内置映射自证）。
    """
    problems = []
    if not layout_presets or not os.path.isfile(layout_presets):
        return ["layout-presets 不存在：%r（内置映射不可作为唯一真相；板端 4.1.2 = "
                "FL0 FR1 SL2 SR3 HFL4 HFR5 SUB1=7）" % layout_presets]
    for lid in SUPPORTED_LAYOUTS:
        got = _layout_roles_from_presets(layout_presets, lid, "output")
        if not got:
            problems.append("%s: layout-presets 缺少 output_layouts" % lid)
            continue
        exp = [(rid, [int(ch)]) for rid, ch in BUILTIN_OUTPUT_LAYOUTS[lid]]
        if got != exp:
            problems.append("%s: 内置映射 %r != layout-presets %r（以 layout-presets 为准，需修 BUILTIN）"
                            % (lid, exp, got))
    got_in = _layout_roles_from_presets(layout_presets, "pc-2ch", "input")
    exp_in = [(rid, int(ch)) for rid, ch in BUILTIN_INPUT_LAYOUTS["pc-2ch"]]
    if got_in is not None and got_in != exp_in:
        problems.append("pc-2ch: 内置输入映射 %r != layout-presets %r" % (exp_in, got_in))
    return problems


def cmd_check(args):
    presets = load_presets(args.presets)
    fs = args.fs or 48000
    consistency = _assert_builtin_consistency(args.layout_presets)
    if consistency:
        print("内置布局与 layout-presets 一致性断言失败：")
        for x in consistency:
            print("  ERROR: " + x)
        return 3
    print("内置布局与 layout-presets 一致性断言通过（4.1.2/5.3.2/pc-2ch）")
    if args.profile:
        problems, warnings = [], []
        try:
            doc = load_yaml(args.profile)
        except Exception as e:
            die("读取 profile 失败：%s" % e)
        problems, warnings = _validate_profile(args.profile, args.layout_presets, fs)
        if not problems:
            print("profile 校验通过：%s（layout=%s fs=%d）"
                  % (args.profile, ((doc.get("output") or {}).get("layout")), fs))
        else:
            print("profile 校验失败：%s" % args.profile)
            for x in problems:
                print("  ERROR: " + x)
        for w in warnings:
            print("  " + w)
        return 0 if not problems else 3
    plan = build_plan(args.preset, presets, fs=args.fs,
                      fir_dir=args.fir_dir or DEFAULT_FIR_DIR)
    problems, warnings = self_check(plan)
    print(plan_summary(plan))
    print("")
    if problems:
        print("自检失败：")
        for x in problems:
            print("  ERROR: " + x)
    else:
        print("自检通过（参数范围/角色/输入源/低音管理）")
    for w in warnings:
        print("  WARN: " + w)
    if not args.no_cli and not problems:
        tmpdir = args.tmpdir or os.path.join(HERE, ".check")
        os.makedirs(tmpdir, exist_ok=True)
        path = os.path.join(tmpdir, plan["id"] + ".yml")
        write_text(path, profile_text(plan))
        ps, ws = _validate_profile(path, args.layout_presets, plan["fs"])
        for w in ws:
            print("  " + w)
        if ps:
            print("真实 CLI 校验失败：")
            for x in ps:
                print("  ERROR: " + x)
            return 3
        print("真实 CLI 校验通过（khaen-channelmap validate/render）")
    return 0 if not problems else 3


