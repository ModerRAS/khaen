def normalize_input_mode(v, allow_none=True):
    """auto|stereo|multichannel 归一化；接受 force-stereo/force-multichannel 等别名。"""
    if v is None:
        return None if allow_none else "auto"
    s = str(v).strip().lower()
    if s in ("auto", "自动"):
        return "auto"
    if s in ("stereo", "force-stereo", "2.0", "2ch", "force-2.0"):
        return "stereo"
    if s in ("multichannel", "force-multichannel", "multi", "mch", "force-multi"):
        return "multichannel"
    die("未知输入模式 %r（可用 auto|stereo|multichannel，或别名 force-stereo/force-multichannel）" % v)


def read_input_mode(mode_file=None):
    path = mode_file or DEFAULT_INPUT_MODE_FILE
    doc = _read_json_file(path)
    if not doc:
        return "auto"
    try:
        return normalize_input_mode(doc.get("mode"), allow_none=False)
    except SystemExit:
        return "auto"


def write_input_mode(mode, mode_file=None, updated_by="khaen-upmix"):
    path = mode_file or DEFAULT_INPUT_MODE_FILE
    doc = {"schema": INPUT_MODE_SCHEMA, "mode": normalize_input_mode(mode, allow_none=False),
           "updated_unix": int(time.time()), "updated_by": str(updated_by)}
    write_text(path, json.dumps(doc, ensure_ascii=False, indent=2) + "\n")
    return doc


def _db_round(v):
    try:
        f = float(v)
    except (TypeError, ValueError):
        return None
    if f != f:  # nan
        return None
    return round(f, 1)


DETECT_SECONDARY = ("C", "SL", "SR", "BL", "BR", "TFL", "TFR", "TRL", "TRR", "HFL", "HFR", "HRL", "HRR")


def detect_content(rms_db, threshold_db=-50.0, exit_db=None, stereo_roles=("FL", "FR"),
                   secondary_roles=None):
    """输入内容检测。rms_db: {角色: dB 或 None}。

    判据（Lead 2026-11-15）：只用 C/SL/SR/height 的活动判多声道，**LFE 不作判据**
    （H16 旧固件 2.0 内容会给 L/R+LFE；LFE 单独有能量仍是 2.0，要走板端上混）。
    返回 dict(detected, confidence, active_channels, rms_min_db, reason)。"""
    thr_in = float(threshold_db)
    thr_out = float(exit_db) if exit_db is not None else thr_in
    vals = {}
    for r, v in (rms_db or {}).items():
        if v is None:
            continue
        try:
            vals[r] = float(v)
        except (TypeError, ValueError):
            continue
    if not vals:
        return {"detected": "unknown", "confidence": 0.0, "active_channels": [],
                "rms_min_db": None, "reason": "no-data"}
    stereo = [r for r in stereo_roles if r in vals]
    if secondary_roles is None:
        secondary = [r for r in vals if r not in stereo_roles and r != "LFE"]
    else:
        secondary = [r for r in secondary_roles if r in vals]
    fl_max = max([vals[r] for r in stereo], default=None)
    sec_max = max([vals[r] for r in secondary], default=None)
    active = sorted([r for r in vals if vals[r] >= thr_in],
                    key=lambda r: -vals[r])
    if fl_max is None and sec_max is None:
        return {"detected": "unknown", "confidence": 0.0, "active_channels": [],
                "rms_min_db": None, "reason": "no-data"}
    if sec_max is not None and sec_max > thr_in:
        conf = max(0.05, min(1.0, (sec_max - thr_in) / 20.0 + 0.2))
        return {"detected": "multichannel", "confidence": round(conf, 2),
                "active_channels": active, "rms_min_db": round(sec_max, 1),
                "reason": "secondary-active"}
    if sec_max is not None and sec_max > thr_out:
        return {"detected": "unknown", "confidence": 0.0, "active_channels": active,
                "rms_min_db": round(sec_max, 1), "reason": "hysteresis-band"}
    if fl_max is not None and fl_max > thr_in:
        margin = min(20.0, thr_in - (sec_max if sec_max is not None else -240.0))
        conf = max(0.05, min(1.0, 0.5 + margin / 40.0))
        return {"detected": "stereo", "confidence": round(conf, 2),
                "active_channels": active, "rms_min_db": round(sec_max, 1) if sec_max is not None else None,
                "reason": "fl-fr-only"}
    return {"detected": "unknown", "confidence": 0.0, "active_channels": active,
            "rms_min_db": round(sec_max, 1) if sec_max is not None else None,
            "reason": "no-signal"}


def _h16_internal_upmix(detected):
    if detected == "multichannel":
        return True
    if detected == "stereo":
        return False
    return None


def build_content_state(content_mode, detected, override, confidence=0.0, active_channels=None,
                        rms_db=None, threshold_db=-50.0, hold_ms=2000, reason="",
                        container_layout=None, detector="energy"):
    return {
        "schema": INPUT_CONTENT_SCHEMA,
        "content_mode": content_mode if content_mode in INPUT_MODE_CHOICES else "auto",
        "detected": detected if detected in ("stereo", "multichannel") else "unknown",
        "override": override if override in INPUT_MODE_CHOICES else None,
        "confidence": round(float(confidence or 0.0), 2),
        "active_channels": list(active_channels or []),
        "rms_db": {k: _db_round(v) for k, v in (rms_db or {}).items() if _db_round(v) is not None},
        "threshold_db": float(threshold_db),
        "hold_ms": int(hold_ms),
        "reason": str(reason or ""),
        "h16_internal_upmix": _h16_internal_upmix(detected),
        "container_layout": container_layout,
        "detector": detector if detector in ("energy", "manual", "fallback") else "energy",
        "updated_unix": int(time.time()),
    }


