def die(msg, code=2):
    sys.stderr.write("khaen-upmix: %s\n" % msg)
    sys.exit(code)


def _rates_text():
    return "/".join(str(int(x)) for x in SUPPORTED_SAMPLE_RATES)


def check_fs(fs):
    """采样率白名单（禁 192k）：返回 int；违规 die（退出码 2 + 稳定错误码）。

    与板端 overlay 副本同一语义（F-01）：176400/192000 明确禁用，其他非白名单值
    报 E_UP_FS_UNSUPPORTED，非数值报 E_UP_FS_INVALID。
    """
    try:
        fs = int(fs)
    except (TypeError, ValueError):
        die("采样率非法：%r（仅支持 %s）[%s]" % (fs, _rates_text(), ERR_FS_INVALID))
    if fs in FORBIDDEN_SAMPLE_RATES:
        die("采样率 %d 已禁用：禁止 192k（176400/192000），仅支持 %s [%s]"
            % (fs, _rates_text(), ERR_FS_192K))
    if fs not in SUPPORTED_SAMPLE_RATES:
        die("采样率不支持：%r（仅支持 %s）[%s]"
            % (fs, _rates_text(), ERR_FS_UNSUPPORTED))
    return fs


def db_to_lin(db):
    return 10.0 ** (float(db) / 20.0)


def lin_to_db(x):
    x = abs(float(x))
    return -120.0 if x <= 0.0 else 20.0 * math.log10(x)


def is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def load_yaml(path):
    with open(path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def dump_yaml(obj):
    return yaml.safe_dump(obj, sort_keys=False, allow_unicode=True,
                          default_flow_style=False, width=120)


def write_text(path, text):
    d = os.path.dirname(os.path.abspath(path))
    if d:
        os.makedirs(d, exist_ok=True)
    tmp = path + ".tmp.%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    os.replace(tmp, path)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _find_default_presets(explicit=None):
    if explicit:
        if not os.path.isfile(explicit):
            die("预设文件不存在：%s" % explicit)
        return explicit
    for cand in DEFAULT_PRESET_CANDIDATES:
        if os.path.isfile(cand):
            return cand
    die("找不到 upmix 预设文件（可用 --presets 指定）：%s" % DEFAULT_PRESET_CANDIDATES)


def load_presets(path=None):
    path = _find_default_presets(path)
    doc = load_yaml(path)
    if not isinstance(doc, dict) or doc.get("schema") != SCHEMA:
        die("预设必须是 %s：%s" % (SCHEMA, path))
    presets = doc.get("presets") or {}
    if not isinstance(presets, dict) or not presets:
        die("预设为空：%s" % path)
    return {"path": path, "defaults": doc.get("defaults") or {}, "presets": presets}


