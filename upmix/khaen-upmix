def build_parser():
    ap = argparse.ArgumentParser(
        prog="khaen-upmix",
        description="2.0 立体声上混配置生成器（4.1.2 / 5.3.2，CamillaDSP + channelmap v2 profile）")
    ap.add_argument("--presets", default=None,
                    help="upmix 预设 YAML（默认项目内 presets/upmix-presets.yml）")
    ap.add_argument("--input-layout", default=None,
                    help="输入布局 id（默认 pc-2ch；H16 容器如 h16-7.1.4）")
    ap.add_argument("--path", default=None, choices=["stereo", "passthrough"],
                    help="生成上混(stereo)或多声道直通(passthrough)路径，默认 stereo")
    ap.add_argument("--allow-builtin", action="store_true",
                    help="允许在 layout-presets 缺失时使用内置布局（默认拒绝，避免 4.1.2 映射错位）")
    ap.add_argument("--layout-presets", default=DEFAULT_LAYOUT_PRESETS,
                    help="khaen layout-presets.yml（默认 %s）" % DEFAULT_LAYOUT_PRESETS)
    ap.add_argument("--version", action="version", version="khaen-upmix " + TOOL_VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("list", help="列出预设")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("show", help="显示预设解析结果")
    sp.add_argument("preset")
    sp.add_argument("--fs", type=int, default=None)
    sp.add_argument("--fir-dir", default=None)
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_show)

    sp = sub.add_parser("profile", help="生成 channelmap v2 profile")
    sp.add_argument("preset")
    sp.add_argument("-o", "--output", required=True)
    sp.add_argument("--fs", type=int, default=None)
    sp.add_argument("--fir-dir", default=None)
    sp.add_argument("--safe", action="store_true", help="渲染器安全变体（无源反相）")
    sp.set_defaults(func=cmd_profile)

    sp = sub.add_parser("camilla", help="生成独立 CamillaDSP ALSA 配置")
