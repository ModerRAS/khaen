def _layout_roles_from_presets(presets_path, layout_id, kind):
    if not presets_path or not os.path.isfile(presets_path):
        return None
    try:
        doc = load_yaml(presets_path)
    except Exception:
        return None
    if not isinstance(doc, dict):
        return None
    if kind == "output":
        lay = (doc.get("output_layouts") or {}).get(layout_id)
        if not isinstance(lay, dict):
            return None
        out = []
        for r in lay.get("roles") or []:
            if not isinstance(r, dict) or not r.get("id"):
                continue
            ov = r.get("outputs")
            if isinstance(ov, int):
                ov = [ov]
            if not isinstance(ov, list):
                ov = []
            out.append((str(r["id"]), [int(x) for x in ov if is_num(x)]))
        return out or None
    lay = (doc.get("input_layouts") or {}).get(layout_id)
    if not isinstance(lay, dict):
        return None
    streams = lay.get("streams") or []
    offsets, acc = [], 0
    for s in streams:
        offsets.append(acc)
        if is_num(s):
            acc += int(s)
    out = []
    for r in lay.get("roles") or []:
        if not isinstance(r, dict) or not r.get("id"):
            continue
        st = int(r.get("stream", 0) or 0)
        ch = int(r.get("channel", 0) or 0)
        idx = (offsets[st] + ch) if 0 <= st < len(offsets) else ch
        out.append((str(r["id"]), idx))
    return out or None


def resolve_output_roles(layout_id, layout_presets):
    if layout_id not in SUPPORTED_LAYOUTS:
        die("本工具只支持输出布局 %s（当前 %r）；不做 16ch/跨布局扩展"
            % ("/".join(SUPPORTED_LAYOUTS), layout_id))
    roles = _layout_roles_from_presets(layout_presets, layout_id, "output")
    if roles:
        return roles, "layout-presets:" + str(layout_presets)
    sys.stderr.write("khaen-upmix: 警告：未读到 layout-presets 中 %s 布局，用内置定义\n" % layout_id)
    # 内置表是 (role, 单通道) 形式；统一成与 presets 相同的 (role, [channels])
    return [(rid, [int(ch)]) for rid, ch in BUILTIN_OUTPUT_LAYOUTS[layout_id]], "builtin"


def resolve_input_layout(layout_id, layout_presets):
    """返回 {id, roles:{角色:全局通道}, channels, source}；支持多 flow（streams）布局。"""
    layout_id = layout_id or "pc-2ch"
    roles = _layout_roles_from_presets(layout_presets, layout_id, "input")
    source = "layout-presets:" + str(layout_presets)
    if not roles:
        if layout_id not in BUILTIN_INPUT_LAYOUTS:
            die("未知输入布局 %r（layout-presets 里没有；内置仅 pc-2ch）" % layout_id)
        sys.stderr.write("khaen-upmix: 警告：未读到 layout-presets 中 %s 布局，用内置定义\n" % layout_id)
        roles = BUILTIN_INPUT_LAYOUTS[layout_id]
        source = "builtin"
    channels = None
    if layout_presets and os.path.isfile(layout_presets):
        try:
            doc = load_yaml(layout_presets)
            lay = (doc.get("input_layouts") or {}).get(layout_id) or {}
            v = lay.get("channels")
            if is_num(v) and int(v) > 0:
                channels = int(v)
            sv = lay.get("streams")
            if channels is None and isinstance(sv, list) and sv and all(is_num(x) and int(x) > 0 for x in sv):
                channels = sum(int(x) for x in sv)
        except Exception:
            pass
    if channels is None:
        channels = max([c for _, c in roles] or [0]) + 1
    return {"id": layout_id, "roles": dict(roles), "channels": int(channels), "source": source}


def _xo(cfg, name, default_freq, default_order=4):
    if cfg is None:
        return None
    if not isinstance(cfg, dict):
        die("%s 必须是 {freq, order, type}" % name)
    freq = cfg.get("freq", default_freq)
    order = cfg.get("order", default_order)
    if not is_num(freq) or freq < 20 or freq >= 24000:
        die("%s.freq 必须在 [20, 24000)（48k 校验口径）：%r" % (name, freq))
    if order not in (2, 4, 6, 8):
        die("%s.order 必须是 2/4/6/8：%r" % (name, order))
    return {"freq": float(freq), "order": int(order), "type": "LinkwitzRiley"}


def _merge(base, override):
    out = dict(base or {})
    for k, v in (override or {}).items():
        out[k] = v
    return out


