            f.append("FIR")
        lines.append("%-5s %-8s %-30s %-24s %-11s %+6.2f %4s" % (
            r["id"], ",".join(str(o) for o in r["outputs"]),
            ",".join(srcs) if srcs else "-", ",".join(f) if f else "-",
            ("%.1f" % r["delay_ms"]) if r["delay_ms"] else "-",
            r["gain_db"], "Y" if r["enabled"] else "n"))
