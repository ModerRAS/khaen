# 独立 CamillaDSP 配置
# ---------------------------------------------------------------------------
def _rl(rid):
    return re.sub(r"[^a-z0-9]+", "_", rid.lower())


def _camilla_core(plan, out_channels=None):
    """out_channels = 播放设备通道数（MOTU 22）；pipeline 必须输出同样多通道。"""
    filters, mixers, pipeline = {}, {}, {}
    roles = plan["roles"]
    nout = int(out_channels or plan["output_channels"])
    bm = plan["bass_management"]
    sub_roles = plan["sub_roles"]
    in_ch = plan["input_roles"]

    def addf(name, typ, params):
        filters[name] = {"type": typ, "parameters": params}

    mx = {"description": "upmix：2.0 -> %s（%dch）" % (plan["layout"], nout),
          "channels": {"in": plan["input_channels"], "out": nout}, "mapping": []}
    for role in roles:
        for o in role["outputs"]:
            srcs = []
            for s in role["sources"]:
                d = {"channel": int(in_ch[s["src"]])}
                if abs(float(s["gain_db"])) > 1e-9:
                    d["gain"] = float(s["gain_db"])
                if s.get("inverted"):
                    d["inverted"] = True
                srcs.append(d)
            mx["mapping"].append({"dest": int(o), "sources": srcs})
    mixers["upmix"] = mx

    active = [r for r in roles if r["enabled"] and r["outputs"]]
    owner = {}
    for r in active:
        for o in r["outputs"]:
            owner[int(o)] = r

    if bm.get("enabled") and sub_roles:
        rd = bm.get("redirect") or {}
        n = len(sub_roles)
        mx_ext = {"description": "bass extract：主声道复制到临时通道",
                  "channels": {"in": nout, "out": nout + n}, "mapping": []}
        for o in range(nout):
            mx_ext["mapping"].append({"dest": o, "sources": [{"channel": o}]})
        for i, rid in enumerate(sub_roles):
            srcs = []
            for srid in rd.get("sources") or []:
                role = next((r for r in roles if r["id"] == srid), None)
                if role is None or not role["enabled"]:
                    continue
                for o in role["outputs"]:
                    srcs.append({"channel": int(o),
                                 "gain": float(rd.get("gain_db") or 0.0)})
            mx_ext["mapping"].append({"dest": nout + i, "sources": srcs})
        mixers["bass_extract"] = mx_ext
        lp_pairs = []
        for i, rid in enumerate(sub_roles):
            role = next((r for r in roles if r["id"] == rid), None)
            lpx = (role or {}).get("lowpass") or {
                "freq": bm["sub_lowpass_hz"], "order": bm["sub_lowpass_order"]}
            name = _rl(rid) + "_lp"
            addf(name, "BiquadCombo", {"type": "LinkwitzRileyLowpass",
                                       "freq": float(lpx["freq"]), "order": int(lpx["order"])})
            lp_pairs.append((nout + i, name))
        mx2 = {"description": "bass sum", "channels": {"in": nout + n, "out": nout},
               "mapping": []}
        for o in range(nout):
            own = owner.get(o)
            sub_idx = sub_roles.index(own["id"]) if own and own["id"] in sub_roles else None
            if sub_idx is not None:
                srcs = [{"channel": nout + sub_idx}]
                if own.get("polarity") == "invert":
                    srcs[0]["inverted"] = True
                item = {"dest": o, "sources": srcs}
                if own.get("mute"):
                    item["mute"] = True
                mx2["mapping"].append(item)
            else:
                mx2["mapping"].append({"dest": o, "sources": [{"channel": o}]})
        mixers["to_outputs"] = mx2
        pipeline = [{"type": "Mixer", "name": "upmix"},
                    {"type": "Mixer", "description": "bass extract", "name": "bass_extract"}]
        for ch, name in lp_pairs:
            pipeline.append({"type": "Filter", "description": "SUB lowpass（extract 后）",
                             "channels": [ch], "names": [name]})
        pipeline.append({"type": "Mixer", "description": "bass sum -> 输出",
                         "name": "to_outputs"})
    else:
        mixers["to_outputs"] = mx
        pipeline = [{"type": "Mixer", "name": "to_outputs"}]

    def role_filters(role):
        rl = _rl(role["id"])
        hp = lp = firn = gainn = delayn = None
        hp_xo = role.get("highpass")
        if bm.get("enabled") and role["id"] in (bm["redirect"].get("sources") or []) and hp_xo is None:
            hp_xo = {"freq": bm["mains_highpass_hz"], "order": bm["mains_highpass_order"]}
        if hp_xo:
            hp = rl + "_hp"
            addf(hp, "BiquadCombo", {"type": "LinkwitzRileyHighpass",
                                     "freq": float(hp_xo["freq"]), "order": int(hp_xo["order"])})
        lp_xo = role.get("lowpass")
        if bm.get("enabled") and role["id"] in sub_roles:
            lp_xo = None
        if lp_xo:
            lp = rl + "_lp"
            addf(lp, "BiquadCombo", {"type": "LinkwitzRileyLowpass",
                                     "freq": float(lp_xo["freq"]), "order": int(lp_xo["order"])})
        if role.get("fir"):
            firn = rl + "_fir"
            prm = {"type": "Wav", "filename": role["fir"]["path"]}
            if role["fir"].get("samplerate"):
                prm["samplerate"] = int(role["fir"]["samplerate"])
            addf(firn, "Conv", prm)
        if abs(float(role["gain_db"])) > 1e-9:
            gainn = rl + "_gain"
            addf(gainn, "Gain", {"gain": float(role["gain_db"])})
        if abs(float(role["delay_ms"])) > 1e-9:
            delayn = rl + "_delay"
            addf(delayn, "Delay", {"delay": float(role["delay_ms"]), "unit": "ms"})
        return hp, lp, firn, gainn, delayn

    steps = {"ap": [], "hp": [], "lp": [], "fir": [], "gain": [], "delay": []}
    # 级联 allpass 去相关（真实全通；仅独立配置）
    ap_specs = plan.get("allpass_specs") or {}
    for role in active:
        if role["id"] not in ap_specs:
            continue
        rl = _rl(role["id"])
        for i, (freq, q) in enumerate(ap_specs[role["id"]]):
            name = "%s_ap%d" % (rl, i)
            addf(name, "Biquad", {"type": "Allpass", "freq": float(freq), "q": float(q)})
            for o in role["outputs"]:
                steps["ap"].append((int(o), name))
    for role in active:
        hp, lp, firn, gainn, delayn = role_filters(role)
        outs = [int(o) for o in role["outputs"]]
        for key, val in (("hp", hp), ("lp", lp), ("fir", firn), ("gain", gainn), ("delay", delayn)):
            if val:
                steps[key] += [(o, val) for o in outs]

    # 关键：CamillaDSP 的 Filter step 会把 names 全部串到 channels 每个通道 → 每 filter 一步
    for key, desc in (("ap", "per-role allpass decorrelation"), ("hp", "per-role highpass"),
                      ("lp", "per-role lowpass"),
                      ("fir", "per-role FIR/decorrelation"), ("gain", "per-role gain"),
                      ("delay", "per-role delay")):
        by_name = {}
        for ch, name in steps[key]:
            by_name.setdefault(name, []).append(ch)
        for name, chans in by_name.items():
            pipeline.append({"type": "Filter", "description": desc,
                             "channels": chans, "names": [name]})
    return filters, mixers, pipeline


