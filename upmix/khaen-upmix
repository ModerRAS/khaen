def _systemctl(*argv):
    exe = shutil.which("systemctl")
    if not exe:
        return 1, "systemctl 不存在"
    p = subprocess.run([exe] + list(argv), capture_output=True, text=True, timeout=60)
    return p.returncode, (p.stdout + p.stderr).strip()


def _backup_file(path, backup_dir):
    if not os.path.isfile(path):
        return None
    os.makedirs(backup_dir, exist_ok=True)
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    dst = os.path.join(backup_dir, "%s-%s" % (os.path.basename(path), ts))
    shutil.copy2(path, dst)
    return dst


def _apply_config(plan, cfg_text, mode, config_target, backup_dir, restart, no_check=False):
    fs = plan["fs"]
    os.makedirs(os.path.dirname(os.path.abspath(config_target)), exist_ok=True)
    tmp = config_target + ".tmp.%d" % os.getpid()
    write_text(tmp, cfg_text)
    if not no_check:
        exe = shutil.which("camilladsp")
        if exe:
            p = subprocess.run([exe, "--check", tmp], capture_output=True, text=True, timeout=60,
                               encoding="utf-8", errors="replace")
            if p.returncode != 0:
                os.unlink(tmp)
                return 4, "camilladsp --check 失败：%s" % (p.stderr or p.stdout).strip()[:800], None
        else:
            sys.stderr.write("提示：未找到 camilladsp，跳过 --check\n")
    backup = _backup_file(config_target, backup_dir)
    os.replace(tmp, config_target)
    state = {"ok": True, "ts": datetime.datetime.now().astimezone().isoformat(),
             "preset": plan["id"], "layout": plan["layout"], "fs": fs, "mode": mode,
             "config": os.path.abspath(config_target), "backup": backup,
             "source": "khaen-upmix " + TOOL_VERSION}
    write_text(os.path.join(backup_dir, "state.json"),
               json.dumps(state, ensure_ascii=False, indent=2))
    if mode == "off":
        return 0, "已写入 %s（模式 off，未启动/重启 CamillaDSP）" % config_target, backup
    if not restart:
        return 0, "已写入 %s（--no-restart）" % config_target, backup
    rc, out = _systemctl("restart", UNIT)
    if rc != 0:
        if backup:
            shutil.copy2(backup, config_target)
        return 5, "systemctl restart %s 失败，已恢复备份：%s" % (UNIT, out), backup
    time.sleep(1.5)
    rc, out = _systemctl("is-active", UNIT)
    if rc != 0 or out.strip() != "active":
        if backup:
            shutil.copy2(backup, config_target)
        return 5, "%s 未 active（%s），已恢复备份" % (UNIT, out.strip()), backup
    return 0, "已应用并重启 %s（fs=%d，config=%s）" % (UNIT, fs, config_target), backup


def _path_mixing_maps(plan_stereo, plan_pass, capture_channels, out_channels, fader_ramp=200):
    """双路径：一个 mixer 把输入分别映射到 stereo 块(0..N-1) 与直通块(N..2N-1)；
    返回 (filters, mixers, pipeline)，pipeline 输出 out_channels。"""
    N = int(plan_stereo["output_channels"])
    if int(plan_pass["output_channels"]) != N:
        die("stereo/passthrough 输出通道数不一致")
    flt_a, mix_a, pipe_a = _camilla_core(plan_stereo, out_channels=N)
    stereo_steps = [s for s in pipe_a if s.get("type") == "Filter"]

    def _map(plan, dest_base):
        out = []
        for role in plan["roles"]:
            if not role.get("enabled"):
                continue
            for o in role["outputs"]:
                if int(o) >= N:
                    continue
                srcs = []
                for s in role["sources"]:
                    d = {"channel": int(plan["input_roles"][s["src"]])}
                    if abs(float(s["gain_db"])) > 1e-9:
                        d["gain"] = float(s["gain_db"])
                    if s.get("inverted"):
                        d["inverted"] = True
                    srcs.append(d)
                out.append({"dest": dest_base + int(o), "sources": srcs})
        return out

    mapping = _map(plan_stereo, 0) + _map(plan_pass, N)
    mixers = {
        "paths": {"description": "autodetect: stereo 上混路径(0..N-1) + 多声道直通路径(N..2N-1)",
                  "channels": {"in": int(capture_channels), "out": 2 * N}, "mapping": mapping},
    }
    filters = dict(flt_a)
    filters["aux_stereo"] = {"type": "Volume",
                             "parameters": {"fader": "Aux1", "ramp_time": int(fader_ramp)}}
    filters["aux_pass"] = {"type": "Volume",
                           "parameters": {"fader": "Aux2", "ramp_time": int(fader_ramp)}}
    pipeline = [{"type": "Mixer", "name": "paths"}]
    pipeline += stereo_steps
    pipeline.append({"type": "Filter", "description": "stereo 路径音量（Aux1；-150=静音）",
                     "channels": list(range(N)), "names": ["aux_stereo"]})
    pipeline.append({"type": "Filter", "description": "直通路径音量（Aux2；-150=静音）",
                     "channels": list(range(N, 2 * N)), "names": ["aux_pass"]})
    sum_map = []
    for o in range(int(out_channels)):
        srcs = []
        if o < N:
            srcs.append({"channel": o})
            srcs.append({"channel": N + o})
        sum_map.append({"dest": o, "sources": srcs})
    mixers["sum"] = {"description": "两路径求和 -> 输出", "channels": {"in": 2 * N, "out": int(out_channels)},
                     "mapping": sum_map}
    pipeline.append({"type": "Mixer", "name": "sum"})
    return filters, mixers, pipeline


def render_autodetect(plan_stereo, plan_pass, devices, capture_channels=None, fader_ramp=200,
                      content_mode="auto"):
    """content_mode=auto 双路径；stereo 只上混；multichannel 只直通。"""
    if content_mode == "stereo":
        return render_camilladsp(plan_stereo, devices)
    if content_mode == "multichannel":
        return render_camilladsp(plan_pass, devices)
    cap = int(capture_channels or plan_stereo["input_channels"])
    out_ch = int((devices.get("playback") or {}).get("channels") or plan_stereo["output_channels"])
    filters, mixers, pipeline = _path_mixing_maps(plan_stereo, plan_pass, cap, out_ch, fader_ramp)
    return {
        "title": "khaen-upmix autodetect %s（%s -> %s）" % (
            plan_stereo["id"], plan_stereo["input_layout"], plan_stereo["layout"]),
        "description": "输入内容检测双路径：Aux1=2.0 上混路径，Aux2=多声道直通路径；"
                       "daemon 按 GetCaptureSignalRms 判定切换（-120 dB=静音）。",
        "devices": devices, "filters": filters, "mixers": mixers, "pipeline": pipeline,
    }


