def cmd_autodetect(args):
    """daemon：读 CamillaDSP websocket 的 GetCaptureSignalRms，判定内容并切 Aux1/Aux2。"""
    in_info = resolve_input_layout(args.input_layout or "h16-7.1.4", _LAYOUT_PRESETS_OVERRIDE)
    state_path = args.state or DEFAULT_INPUT_STATE
    mode_file = args.mode_file or DEFAULT_INPUT_MODE_FILE
    thr = float(args.threshold_db)
    exit_db = thr - float(args.hysteresis_db)
    hold_ms = int(args.hold_ms)
    freeze_ms = int(getattr(args, "startup_freeze_ms", 2500) or 0)
    interval = max(0.05, float(args.interval_ms) / 1000.0)
    frames = None
    if args.simulate:
        try:
            doc = _read_json_file(os.path.abspath(args.simulate))
            if doc is None:
                die("simulate 文件必须是 JSON：%s" % args.simulate)
            frames = doc.get("frames") if "frames" in doc else doc
        except Exception as e:
            die("读取 simulate 文件失败：%s" % e)
        if not isinstance(frames, list):
            die("simulate 文件应为 [{rms_db:{...}}, ...] 或 {frames:[...]}")
    ws = None
    if frames is None:
        try:
            ws = WSClient(args.host, args.port, timeout=args.ws_timeout)
            ws.cmd({"SetUpdateInterval": int(args.interval_ms)})
        except Exception as e:
            st = build_content_state("auto", "unknown", _read_override(mode_file)[1],
                                     threshold_db=thr, hold_ms=hold_ms,
                                     reason="ws-error: %s" % e.strip(),
                                     container_layout=in_info["id"], detector="fallback")
            _apply_mute_state(args, st, in_info)
            print(json.dumps(st, ensure_ascii=False, indent=2))
            sys.stderr.write("khaen-upmix autodetect: 连接 CamillaDSP 失败：%s\n" % e)
            return 3

    current = None if frames is not None else "multichannel"  # auto 默认直通
    pending, pending_since = None, None
    last_fader = None
    vt = 0.0
    started = time.time()
    last_state = None
    try:
        while True:
            override_mode, override_field = _read_override(mode_file)
            manual = override_mode in ("stereo", "multichannel")
            if frames is not None:
                if not frames:
                    break
                frame = frames.pop(0)
                vt += interval
                if isinstance(frame, list):
                    raw = frame
                    rms_by_role = {}
                    for role, idx in in_info["roles"].items():
                        v = raw[idx] if idx < len(raw) else None
                        rms_by_role[role] = -240.0 if v is None else float(v)
                elif isinstance(frame, dict):
                    src = frame.get("rms_db") if isinstance(frame.get("rms_db"), dict) else frame
                    rms_by_role = {r: (float(src[r]) if src.get(r) is not None else None)
                                   for r in in_info["roles"]}
                else:
                    die("simulate frame 格式不支持：%r" % (frame,))
                now = vt
            else:
                rms_by_role = _ws_capture_rms(ws, in_info)
                now = time.time() - started

            frozen = (freeze_ms > 0 and now * 1000.0 < freeze_ms)
            det = detect_content(rms_by_role, thr, exit_db=exit_db)
            if manual:
                content_mode = override_mode
                reason = "override-" + override_mode
                detector = "manual"
            elif frozen:
                content_mode = "multichannel"   # 启动冻结：默认直通，等 H16/上游稳定
                detector = "energy"
                reason = "startup-freeze"
                pending, pending_since = None, None
            else:
                detector = "energy"
                cand = det["detected"] if det["detected"] in ("stereo", "multichannel") else None
                if current is None:
                    current = "multichannel"
                if cand is None:
                    pending, pending_since = None, None
                    reason = det["reason"]
                elif cand == current:
                    pending, pending_since = None, None
                    reason = det["reason"]
                else:
                    if pending != cand:
                        pending, pending_since = cand, now
                    if pending_since is not None and (now - pending_since) * 1000.0 >= hold_ms:
                        current = cand
                        pending, pending_since = None, None
                    reason = det["reason"]
                content_mode = current
            state = build_content_state(content_mode, det["detected"],
                                        override_field, confidence=det["confidence"],
                                        active_channels=det["active_channels"],
                                        rms_db=rms_by_role, threshold_db=thr,
                                        hold_ms=hold_ms, reason=reason,
                                        container_layout=in_info["id"], detector=detector)
            stereo_active = (content_mode == "stereo")
            if ws is not None and not args.dry_run and last_fader != stereo_active:
                try:
                    _set_faders(ws, stereo_active)
                    last_fader = stereo_active
                except Exception as e:
                    state["detector"] = "fallback"
                    state["reason"] = "fader-error: %s" % e
            _apply_mute_state(args, state, in_info)
            if args.simulate or args.once or args.verbose:
                print(json.dumps(state, ensure_ascii=False))
                sys.stdout.flush()
            last_state = state
            if args.once:
                break
            if frames is not None:
                if not frames:
                    break
                continue
            if args.max_seconds and (time.time() - started) >= args.max_seconds:
                break
            time.sleep(interval)
    except KeyboardInterrupt:
        sys.stderr.write("khaen-upmix autodetect: 收到中断，退出\n")
    finally:
        if ws is not None:
            ws.close()
    if last_state is None and frames == []:
        # 空 frames：给一个 unknown 状态
        st = build_content_state("auto", "unknown", _read_override(mode_file)[1],
                                 threshold_db=thr, hold_ms=hold_ms, reason="no-data",
                                 container_layout=in_info["id"], detector="energy")
        _apply_mute_state(args, st, in_info)
        print(json.dumps(st, ensure_ascii=False))
    return 0


