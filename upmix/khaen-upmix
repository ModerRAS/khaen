def self_check(plan):
    problems, warnings = [], []
    bm = plan["bass_management"]
    for r in plan["roles"]:
        if not r["outputs"]:
            problems.append("%s 没有输出通道" % r["id"])
        if not r["enabled"]:
            continue
        if not (-60.0 <= r["gain_db"] <= 12.0):
            problems.append("%s.gain_db=%s 越界" % (r["id"], r["gain_db"]))
        if not (0.0 <= r["delay_ms"] <= 200.0):
            problems.append("%s.delay_ms=%s 越界" % (r["id"], r["delay_ms"]))
        for s in r["sources"]:
            if not (-60.0 <= s["gain_db"] <= 12.0):
                problems.append("%s source %s gain=%s 越界" % (r["id"], s["src"], s["gain_db"]))
            if s["src"] not in plan["input_roles"]:
                problems.append("%s source %s 不在输入布局" % (r["id"], s["src"]))
        for key in ("highpass", "lowpass"):
            xo = r.get(key)
            if xo:
                if xo["order"] not in (2, 4, 6, 8):
                    problems.append("%s.%s order 非法" % (r["id"], key))
                if not (20 <= xo["freq"] < plan["fs"] / 2.0):
                    problems.append("%s.%s freq=%s 超过 fs/2" % (r["id"], key, xo["freq"]))
        if r["id"] in plan["sub_roles"] and bm.get("enabled") and r["sources"]:
            problems.append("%s 在 bass_management 下 sources 必须为空" % r["id"])
    if bm.get("enabled"):
        for rid in bm["redirect"]["targets"]:
            if rid not in plan["sub_roles"]:
                problems.append("bass target %r 不是 SUB 角色" % rid)
        if not bm["redirect"]["sources"]:
            problems.append("bass_management 打开但 redirect.sources 为空")
    if plan.get("bass_mode") == "matrix" and bm.get("enabled") is False and any(
            r["id"] in plan["sub_roles"] and not r["sources"] for r in plan["roles"]):
        warnings.append("SUB 角色无源（bass 关闭？）")
    if any(s.get("inverted") for r in plan["roles"] for s in r["sources"]):
        warnings.append("profile 含 sources[].inverted：当前 khaen-channelmap 渲染器会丢弃（待 patch），"
                        "独立 CamillaDSP 配置不受影响")
    return problems, warnings


