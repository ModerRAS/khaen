ALLPASS_BASE = [(180.0, 0.5), (720.0, 1.1), (2600.0, 0.7), (6800.0, 0.9)]


def _allpass_specs(preset_id, stages, seed):
    """每去相关角色一组 allpass Biquad（真实全通，相位扩散；不同角色不同频点）。"""
    specs = {}
    roles = ("SL", "SR", "HFL", "HFR")
    for idx, rid in enumerate(roles):
        cur = []
        for i in range(stages):
            f, q = ALLPASS_BASE[i % len(ALLPASS_BASE)]
            mult = 1.0 + 0.15 * (((seed + idx * 7 + i * 13) % 5) - 2) / 2.0
            qf = 0.9 + 0.1 * ((seed + idx + i) % 3)
            cur.append((round(f * mult, 1), round(q * qf, 3)))
        specs[rid] = cur
    return specs


def _coeff_sources(coeffs):
    out = []
    for src in ("FL", "FR"):
        if src not in coeffs:
            continue
        c = float(coeffs[src])
        if abs(c) < 1e-9:
            continue
        gain = round(lin_to_db(c), 3)
        if gain < -60.0:
            die("上混系数过小（%s %.2f dB），请调整 extract_gain_db/gain_db" % (src, gain))
        out.append({"src": src, "gain_db": gain, "inverted": c < 0.0, "mute": False})
    if not out:
        die("角色没有有效输入源（检查 extract_gain_db 是否低于 -60 dB）")
    return out


def _role(rid, outputs, sources=None, gain_db=0.0, delay_ms=0.0, polarity="normal",
          highpass=None, lowpass=None, fir=None, enabled=True):
    return {
        "id": rid, "outputs": list(outputs), "sources": sources or [],
        "gain_db": float(gain_db), "delay_ms": float(delay_ms), "polarity": polarity,
        "highpass": highpass, "lowpass": lowpass, "peq": [], "fir": fir,
        "enabled": bool(enabled),
    }


def _passthrough_roles(target_role_ids, outputs, in_roles, front_gain_db=0.0):
    """输入容器 -> 目标布局 的多声道直通/下混矩阵（按角色名映射；缺的声部留空）。"""
    def has(r):
        return r in in_roles

    def s(r, g):
        return {"src": r, "gain_db": float(g), "inverted": False, "mute": False}

    roles = []
    for rid in target_role_ids:
        ov = outputs.get(rid) or []
        srcs = []
        if rid == "FL":
            if has("FL"):
                srcs.append(s("FL", front_gain_db))
            if has("C"):
                srcs.append(s("C", -3.01))
        elif rid == "FR":
            if has("FR"):
                srcs.append(s("FR", front_gain_db))
            if has("C"):
                srcs.append(s("C", -3.01))
        elif rid == "C":
            if has("C"):
                srcs.append(s("C", 0.0))
        elif rid in ("SL", "SR"):
            prim = "SL" if rid == "SL" else "SR"
            fold = "BL" if rid == "SL" else "BR"
            if has(prim):
                srcs.append(s(prim, 0.0))
                if has(fold):
                    srcs.append(s(fold, -6.02))
            elif has(fold):
                srcs.append(s(fold, 0.0))
        elif rid.startswith(SUB_PREFIX):
            if has("LFE"):
                srcs.append(s("LFE", 0.0))
        elif rid in ("HFL", "HFR"):
            prim = "TFL" if rid == "HFL" else "TFR"
            alt = "HFL" if rid == "HFL" else "HFR"
            fold = "TRL" if rid == "HFL" else "TRR"
            p = prim if has(prim) else (alt if has(alt) else None)
            if p:
                srcs.append(s(p, 0.0))
            if has(fold):
                srcs.append(s(fold, -6.02))
        roles.append(_role(rid, ov, srcs, gain_db=0.0, highpass=None, lowpass=None))
    return roles


_LAYOUT_PRESETS_OVERRIDE = None
_INPUT_LAYOUT_OVERRIDE = None
_PATH_OVERRIDE = "stereo"


def build_plan(preset_id, presets, fs=None, fir_dir=None, layout_presets=None, compat="full",
               input_layout=None, path=None):
    input_layout = input_layout or _INPUT_LAYOUT_OVERRIDE
    path = path or _PATH_OVERRIDE
    p = _preset_params(presets, preset_id)
    if layout_presets:
        p["layout_presets"] = layout_presets
    elif _LAYOUT_PRESETS_OVERRIDE:
        p["layout_presets"] = _LAYOUT_PRESETS_OVERRIDE
    # F-01：与 overlay 副本统一走 check_fs（禁 176400/192000）。
    fs = check_fs(fs or p["samplerate"])
    _check_param_ranges(p)
    layout = p["layout"]
    out_roles, out_src = resolve_output_roles(layout, p["layout_presets"])
    in_info = resolve_input_layout(input_layout, p["layout_presets"])
    in_roles = in_info["roles"]
    role_ids = [rid for rid, _ in out_roles]
    outputs = {rid: ov for rid, ov in out_roles}
    if "FL" not in in_roles or "FR" not in in_roles:
        die("输入布局 %s 缺少 FL/FR 角色" % in_info["id"])
    for need in ("FL", "FR"):
        if need not in role_ids:
            die("输出布局 %s 缺少 %s 角色" % (layout, need))
    has_center = "C" in role_ids
    sub_roles = [rid for rid in role_ids if rid.startswith(SUB_PREFIX)]
    height_roles = [rid for rid in role_ids if rid in HEIGHT_ROLES]
    if layout == "4.1.2" and len(sub_roles) != 1:
        die("4.1.2 应有 1 个 SUB，实际 %s" % sub_roles)
    if layout == "5.3.2" and len(sub_roles) != 3:
        die("5.3.2 应有 3 个 SUB，实际 %s" % sub_roles)
    if len(height_roles) != 2:
        die("布局 %s 应有 HFL/HFR" % layout)
    nout = max([max(ov) for ov in outputs.values() if ov] or [0]) + 1

    # 多声道直通路径（输入容器 -> 目标布局；不走 2.0 上混）
    if path == "passthrough":
        roles = _passthrough_roles(role_ids, outputs, in_roles, p["front"]["gain_db"])
        bm_off = {"enabled": False, "lfe_role": "", "lfe_to": [], "lfe_gain_db": 0.0,
                  "redirect": {"enabled": True, "sources": [], "targets": [], "gain_db": 0.0},
                  "mains_highpass_hz": 80.0, "mains_highpass_order": 4,
                  "sub_lowpass_hz": 80.0, "sub_lowpass_order": 4, "sub_gain_db": 0.0}
        plan = {
            "id": preset_id, "label": p["label"], "description": p["description"],
            "layout": layout, "fs": fs, "input_layout": in_info["id"],
            "input_channels": in_info["channels"], "input_roles": in_roles,
            "output_channels": nout, "output_roles": role_ids, "roles": roles,
            "bass_management": bm_off, "sub_roles": sub_roles, "decor": p["decor"],
            "allpass_specs": {}, "chunksize": int(p["chunksize"]),
            "target_level": int(p["target_level"]), "adjust_period": int(p["adjust_period"]),
            "layout_source": out_src, "notes": [], "bass_mode": "off", "path": "passthrough",
        }
        plan["id"] = "passthrough-%s-to-%s" % (in_info["id"], layout)
        plan["label"] = "多声道直通/跨布局下混：%s -> %s" % (in_info["id"], layout)
        plan["description"] = ("跨布局下混（C 折入 FL/FR -3.01 dB；BL/BR/TRL/TRR 折入对应声道 -6.02 dB）；"
                                "不是同布局直通，也不含低音管理（与上混路径低频行为不同）")
        plan["notes"].append("跨布局下混路径：输入容器（%s，%dch）按角色映射到 %s；"
                             "C 折入 FL/FR（-3.01 dB），BL/BR/TRL/TRR 折入对应声道（-6.02 dB）；"
                             "无低音管理（FL/FR 全频、SUB 只收 LFE），与上混路径低频行为不同"
                             % (in_info["id"], in_info["channels"], layout))
        if compat == "safe":
            plan["id"] = plan["id"] + "-safe"
        return plan

    # 低音管理
    b = p["bass"]
    bm_enabled = bool(b.get("enabled"))
    bass_mode = b.get("mode", "matrix")
    mains_hp = _xo(b.get("mains_highpass"), "bass.mains_highpass", 80) if bm_enabled else None
    sub_lp = _xo(b.get("sub_lowpass"), "bass.sub_lowpass", 80) if bm_enabled else None
    bm_renderer = bm_enabled and bass_mode == "redirect"

    # 去相关：allpass 级联规格（真实全通 Biquad，仅独立 CamillaDSP 配置支持）
    decor = p["decor"]
    allpass_specs = {}
    if decor["mode"] == "allpass":
        allpass_specs = _allpass_specs(preset_id, int(decor.get("allpass_stages", 4)),
                                       int(decor.get("allpass_seed", 101)))

    roles = []

    # FL / FR（bass 启用时加高通；否则纯直通）
    for rid, srcname in (("FL", "FL"), ("FR", "FR")):
        roles.append(_role(rid, outputs.get(rid),
                           [{"src": srcname, "gain_db": 0.0, "inverted": False, "mute": False}],
                           gain_db=p["front"]["gain_db"], highpass=mains_hp))

    # C
    if has_center:
        c = p["center"]
        g = db_to_lin(c["extract_gain_db"])
        roles.append(_role(
            "C", outputs["C"], _coeff_sources({"FL": g, "FR": g}),
            gain_db=c["gain_db"], delay_ms=c["delay_ms"],
            highpass=_xo(c.get("highpass"), "center.highpass", 200),
            lowpass=_xo(c.get("lowpass"), "center.lowpass", 12000),
            enabled=bool(c.get("enabled", True))))

    # 环绕
    s = p["surround"]
    g = db_to_lin(s["extract_gain_db"])
    amb = s.get("ambience_gain_db")
    amb_lin = db_to_lin(amb) if amb is not None else 0.0
    if s["mode"] == "difference":
        sl = {"FL": g + amb_lin, "FR": -g + amb_lin}
        sr = {"FR": g + amb_lin, "FL": -g + amb_lin}
    else:
        sl = sr = {"FL": g + amb_lin, "FR": g + amb_lin}
    hp_n = _xo(s.get("highpass"), "surround.highpass", 100)
    lp_n = _xo(s.get("lowpass"), "surround.lowpass", 7000)
    roles.append(_role("SL", outputs["SL"], _coeff_sources(sl), gain_db=s["gain_db"],
                       delay_ms=s["delay_ms"], highpass=hp_n, lowpass=lp_n))
    roles.append(_role("SR", outputs["SR"], _coeff_sources(sr), gain_db=s["gain_db"],
                       delay_ms=s["delay_ms"] + s.get("delay_spread_ms", 0.0),
                       highpass=hp_n, lowpass=lp_n))

    # 高度
    h = p["height"]
    hg = db_to_lin(h["extract_gain_db"])
    if h["source"] == "mid":
        base = {"FL": hg * 0.5, "FR": hg * 0.5}
    else:
        base = {"FL": hg, "FR": -hg}
    w = float(h["width"])
    if h["source"] == "mid" and w > 0.0:
        hfl = {"FL": hg * ((1.0 - w) * 0.5 + w), "FR": hg * (1.0 - w) * 0.5}
        hfr = {"FR": hg * ((1.0 - w) * 0.5 + w), "FL": hg * (1.0 - w) * 0.5}
    else:
        hfl, hfr = dict(base), dict(base)
    bandlimited = h["mode"] == "bandlimited"
    hp_h = _xo(h.get("highpass"), "height.highpass", 1800) if bandlimited else None
    lp_h = _xo(h.get("lowpass"), "height.lowpass", 10000) if bandlimited else None
    hfl_id = [rid for rid in height_roles if rid.endswith("L")][0]
    hfr_id = [rid for rid in height_roles if rid.endswith("R")][0]
    roles.append(_role(hfl_id, outputs[hfl_id], _coeff_sources(hfl), gain_db=h["gain_db"],
                       delay_ms=h["delay_ms"], highpass=hp_h, lowpass=lp_h))
    roles.append(_role(hfr_id, outputs[hfr_id], _coeff_sources(hfr), gain_db=h["gain_db"],
                       delay_ms=h["delay_ms"] + h.get("delay_spread_ms", 0.0),
                       highpass=hp_h, lowpass=lp_h))

    # SUB
    redirect_from = b.get("redirect_from") or "auto"
    if redirect_from == "auto":
        redirect_from = [rid for rid in role_ids if rid in MAINS_ORDER]
    if not isinstance(redirect_from, list):
        die("bass.redirect_from 必须是 auto 或角色数组")
    for rid in redirect_from:
        if rid not in role_ids:
            die("bass.redirect_from 含未知输出角色 %r" % rid)
    trims = b.get("sub_trims") or []
    if len(trims) > len(sub_roles):
        die("bass.sub_trims 数量超过 SUB 数（%d > %d）" % (len(trims), len(sub_roles)))
    sub_g = db_to_lin(b.get("extract_gain_db", -6.02))
    for i, rid in enumerate(sub_roles):
        tr = trims[i] if i < len(trims) else {}
        if bm_enabled and bass_mode == "matrix":
            sub_sources = _coeff_sources({"FL": sub_g, "FR": sub_g})
            sub_lp_role = dict(sub_lp) if sub_lp else None
        else:
            sub_sources = []
            sub_lp_role = None
        roles.append(_role(
            rid, outputs[rid], sub_sources,
            gain_db=float(b.get("sub_gain_db", 0.0)) + float(tr.get("gain_db", 0.0)),
            delay_ms=float(tr.get("delay_ms", 0.0)),
            lowpass=sub_lp_role, enabled=bm_enabled))

    order = {rid: i for i, rid in enumerate(role_ids)}
    roles.sort(key=lambda r: order.get(r["id"], 99))

    bm = {
        "enabled": bm_renderer, "lfe_role": "", "lfe_to": [], "lfe_gain_db": 0.0,
        "redirect": {"enabled": True,
                     "sources": list(redirect_from) if bm_renderer else [],
                     "targets": list(sub_roles) if bm_renderer else [],
                     "gain_db": float(b.get("extract_gain_db", -6.02))},
        "mains_highpass_hz": float(_xo(b.get("mains_highpass"), "bass.mains_highpass", 80)["freq"]),
        "mains_highpass_order": int(_xo(b.get("mains_highpass"), "bass.mains_highpass", 80)["order"]),
        "sub_lowpass_hz": float(_xo(b.get("sub_lowpass"), "bass.sub_lowpass", 80)["freq"]),
        "sub_lowpass_order": int(_xo(b.get("sub_lowpass"), "bass.sub_lowpass", 80)["order"]),
        "sub_gain_db": 0.0,
    }

    plan = {
        "id": preset_id, "label": p["label"], "description": p["description"],
        "layout": layout, "fs": fs, "input_layout": in_info["id"],
        "input_channels": in_info["channels"], "input_roles": in_roles,
        "output_channels": nout, "output_roles": role_ids, "roles": roles,
        "bass_management": bm, "sub_roles": sub_roles, "decor": decor,
        "allpass_specs": allpass_specs,
        "chunksize": int(p["chunksize"]), "target_level": int(p["target_level"]),
        "adjust_period": int(p["adjust_period"]), "layout_source": out_src,
        "notes": [], "bass_mode": bass_mode, "path": "stereo",
    }
    _plan_notes(plan, p)
    if compat == "safe":
        _make_compat_safe(plan, p)
    elif compat != "full":
        die("compat 必须是 full|safe")
    return plan


def _make_compat_safe(plan, p):
    """safe 变体：只去掉 sources[].inverted（源反相）。环绕/高度改 mid；不能绕过渲染器 bug A。"""
    s, h = p["surround"], p["height"]
    g = db_to_lin(s["extract_gain_db"])
    amb = s.get("ambience_gain_db")
    amb_lin = db_to_lin(amb) if amb is not None else 0.0
    mid = _coeff_sources({"FL": g + amb_lin, "FR": g + amb_lin})
    for role in plan["roles"]:
        if role["id"] in ("SL", "SR"):
            role["sources"] = [dict(x) for x in mid]
    if h["source"] == "side":
        hg = db_to_lin(h["extract_gain_db"])
        hm = _coeff_sources({"FL": hg * 0.5, "FR": hg * 0.5})
        for role in plan["roles"]:
            if role["id"] in ("HFL", "HFR"):
                role["sources"] = [dict(x) for x in hm]
    plan["id"] = plan["id"] + "-safe"
    plan["label"] = plan["label"] + "（渲染器安全版）"
    plan["description"] = plan["description"] + "；safe：环绕/高度全用 mid 合成（无源反相）"
    plan["notes"].append("safe 变体：只去掉 sources[].inverted（源反相）依赖；**不能绕过旧渲染器 bug A**"
                         "（Filter step 的 channels/names 配对错，所有 per-role 滤波都会互相叠加）。"
                         "旧镜像（<OEM v5）唯一可用路径=独立 CamillaDSP 配置（khaen-upmix apply）或先打 patches/ 补丁；"
                         "safe 只用于“不想用源反相”的听感取舍。")


def _plan_notes(plan, p):
    notes = []
    s, h, c, b = p["surround"], p["height"], p["center"], p["bass"]
    if plan["layout"] == "4.1.2":
        notes.append("4.1.2 无中置：对白/中心内容保留在 FL/FR（虚拟中置）")
    if plan["layout"] == "5.3.2" and c.get("enabled", True):
        notes.append("中置 = mid=(L+R)/2 每源 %.2f dB，角色增益 %.1f dB" % (c["extract_gain_db"], c["gain_db"]))
    if s["mode"] == "difference":
        notes.append("环绕 = (L-R)/2 差信号（每源 %.2f dB，L/R 反相）总增益 %.1f dB + 延迟 %.1f ms%s"
                     % (s["extract_gain_db"], s["gain_db"], s["delay_ms"],
                        "，左右延迟差 %.1f ms" % s["delay_spread_ms"] if s.get("delay_spread_ms") else ""))
    else:
        notes.append("环绕 = mid 合成（每源 %.2f dB）总增益 %.1f dB + 延迟 %.1f ms"
                     % (s["extract_gain_db"], s["gain_db"], s["delay_ms"]))
    if h["mode"] == "bandlimited" and h.get("highpass") and h.get("lowpass"):
        height_kind = "带限 %.0f-%.0f Hz LR%d" % (h["highpass"]["freq"], h["lowpass"]["freq"],
                                                  h["highpass"]["order"])
    else:
        height_kind = "全频（不做高通/低通）"
    height_delay = (" + 延迟 %.1f ms" % h["delay_ms"]) if abs(h["delay_ms"]) > 1e-9 \
        else "（无人工去相关延迟）"
    notes.append("高度 = %s + %s%s%s" % (
        "mid=(L+R)/2" if h["source"] == "mid" else "side=(L-R)/2",
        height_kind, height_delay,
        "（width=%.2f 混入左右直达）" % h["width"] if h.get("width") else ""))
    if b.get("enabled"):
        if b.get("mode", "matrix") == "matrix":
            notes.append("低音管理（简化：仅 FL/FR mid 进 SUB，非完整矩阵 BM）：FL/FR 高通 %.0f Hz LR%d；"
                         "%s = 低通 %.0f Hz LR%d（源 %.2f dB）；C/SL/SR 低频不汇总"
                         "（redirect_from 仅校验不生效，真矩阵 BM 待做）"
                         % (b["mains_highpass"]["freq"], b["mains_highpass"]["order"],
                            "/".join(plan["sub_roles"]), b["sub_lowpass"]["freq"],
                            b["sub_lowpass"]["order"], b["extract_gain_db"]))
        else:
            notes.append("低音管理（渲染器 BM）：需要 khaen-channelmap BM 渲染修复后才能用此模式")
    if s["mode"] == "difference":
        notes.append("注意：环绕含 sources[].inverted——当前 khaen-channelmap 渲染器会丢弃（已知缺陷）；"
                     "旧镜像应走独立 CamillaDSP 配置（khaen-upmix apply）或先打 patches/ 补丁；"
                     "*-safe 只去掉源反相，不能绕过 bug A（Filter step 配对错误）")
    if plan["decor"]["mode"] == "allpass":
        notes.append("去相关：级联 allpass Biquad（真实全通、幅度不变；仅独立 CamillaDSP 配置支持，"
                     "channelmap profile 退化为固定延迟）")
    elif any([s.get("delay_spread_ms"), h.get("delay_spread_ms")]):
        notes.append("去相关：左右延迟差（环绕 %.1f ms / 高度 %.1f ms）"
                     % (s.get("delay_spread_ms", 0.0), h.get("delay_spread_ms", 0.0)))
    else:
        notes.append("去相关：仅固定延迟（左右对称）；需要扩散感用 wide 预设或 decor.mode=allpass")
    plan["notes"] = notes


