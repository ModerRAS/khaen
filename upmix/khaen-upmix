def _find_channelmap():
    exe = shutil.which("khaen-channelmap")
    if exe:
        return [exe]
    cand = os.path.join(HERE, "..", "audio", "overlay", "usr", "local", "bin", "khaen-channelmap")
    if os.path.isfile(cand):
        return [sys.executable, cand]
    return None


def _run_cli(cmd):
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=120,
                       encoding="utf-8", errors="replace")
    return p


def _rendered_audit(profile_doc, rendered):
    """审计渲染产物是否忠实于 profile（捕获渲染器已知 bug）。"""
    issues = []
    steps = rendered.get("pipeline") or []
    multi = [s for s in steps if s.get("type") == "Filter" and len(s.get("names") or []) > 1]
    if multi:
        issues.append("渲染器把多个滤波器放进同一 Filter step（CamillaDSP 语义会串到所有通道；"
                      "典型渲染器 bug）：%d 处" % len(multi))
    # 检查源反相是否保留
    want_inv = False
    for role in (profile_doc.get("output") or {}).get("roles") or []:
        for s in role.get("sources") or []:
            if s.get("inverted"):
                want_inv = True
    if want_inv:
        found = False
        for mx in (rendered.get("mixers") or {}).values():
            for m in mx.get("mapping") or []:
                if any(src.get("inverted") for src in m.get("sources") or []):
                    found = True
        if not found:
            issues.append("profile 的 sources[].inverted 在渲染产物中丢失（已知渲染器 bug）")
    return issues


def _validate_profile(path, layout_presets, fs):
    problems, warnings = [], []
    cli = _find_channelmap()
    if not cli:
        warnings.append("未找到 khaen-channelmap，跳过真实 CLI 校验")
        return problems, warnings
    p = _run_cli(cli + ["validate", path, "--samplerate", str(fs),
                        "--presets", layout_presets])
    if p.returncode != 0:
        problems.append("khaen-channelmap validate 失败（exit %d）：%s"
                        % (p.returncode, (p.stderr or p.stdout).strip()[:800]))
        return problems, warnings
    warnings.extend([l for l in (p.stderr or "").splitlines() if l.strip()])
    base = os.path.dirname(os.path.abspath(path))
    tmp = os.path.join(base, ".upmix-render-check.yml")
    cmd = cli + ["render", path, "--samplerate", str(fs), "--presets", layout_presets,
                 "-o", tmp, "--no-check"]
    q = _run_cli(cmd)
    if q.returncode != 0:
        problems.append("khaen-channelmap render 失败（exit %d）：%s"
                        % (q.returncode, (q.stderr or q.stdout).strip()[:800]))
        return problems, warnings
    try:
        rendered = load_yaml(tmp)
        doc = load_yaml(path)
        warnings.extend(_rendered_audit(doc, rendered))
    except Exception as e:
        warnings.append("渲染产物审计失败：%s" % e)
    try:
        os.unlink(tmp)
    except OSError:
        pass
    return problems, warnings


