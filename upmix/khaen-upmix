def cmd_apply(args):
    presets = load_presets(args.presets)
    mode = args.mode
    if mode == "auto":
        mode = _detect_mode()
    fs = args.fs
    if fs is None:
        fs = 96000 if mode == "dante" else 48000
    plan = build_plan(args.preset, presets, fs=fs,
                      fir_dir=args.fir_dir or DEFAULT_FIR_DIR)
    if mode == "dante":
        cap_dev = args.capture_device or "inferno"
        cap_fmt = args.capture_format or "S32_LE"
    else:
        cap_dev = args.capture_device or "hw:ravenna,0"
        cap_fmt = args.capture_format or "S32_LE"
    pb_ch = args.playback_channels or 22
    devices = _devices_alsa(plan, args.chunksize or plan["chunksize"],
                            args.target_level or plan["target_level"],
                            args.adjust_period or plan["adjust_period"],
                            cap_dev, cap_fmt, args.playback_device or "hw:motu,0",
                            args.playback_format or "S24_3_LE", pb_ch, fs,
                            enable_rate_adjust=not args.no_rate_adjust)
    cfg = render_camilladsp(plan, devices)
    text = camilla_text(plan, cfg)
    if args.dry_run:
        print("DRY: mode=%s fs=%d capture=%s(%s) playback=%s(%dch) -> %s"
              % (mode, fs, cap_dev, cap_fmt, devices["playback"]["device"], pb_ch,
                 args.config_target))
        print(text[:2000])
        return 0
    rc, msg, backup = _apply_config(plan, text, mode, args.config_target,
                                    args.backup_dir, restart=(not args.no_restart),
                                    no_check=args.no_check)
    print(("OK: " if rc == 0 else "ERROR: ") + msg)
    if backup:
        print("原配置备份：%s" % backup)
    return rc


def cmd_rollback(args):
    state_path = os.path.join(args.backup_dir, "state.json")
    try:
        with open(state_path, "r", encoding="utf-8") as fh:
            state = json.load(fh)
    except Exception:
        sys.stderr.write("没有可回滚状态：%s\n" % state_path)
        return 2
    backup = state.get("backup")
    if not backup or not os.path.isfile(backup):
        sys.stderr.write("备份文件不存在：%r\n" % backup)
        return 2
    target = args.config_target or state.get("config") or DEFAULT_CONFIG_TARGET
    if args.dry_run:
        print("DRY: 将用 %s 覆盖 %s" % (backup, target))
        return 0
    mode = state.get("mode", "off")
    shutil.copy2(backup, target)
    print("已恢复：%s -> %s" % (backup, target))
    if mode != "off" and not args.no_restart:
        rc, out = _systemctl("restart", UNIT)
        print(("重启 %s：%s" % (UNIT, out)) if rc == 0 else ("重启失败：%s" % out))
        return 0 if rc == 0 else 5
    return 0


