    sp.add_argument("--playback-format", default="S24_3_LE")
    sp.add_argument("--playback-channels", type=int, default=None)
    sp.add_argument("--no-rate-adjust", action="store_true")
    sp.add_argument("--fir-dir", default=None)
    sp.set_defaults(func=cmd_camilla)

    sp = sub.add_parser("file-config", help="生成 CamillaDSP 文件后端配置（测试）")
    sp.add_argument("preset")
    sp.add_argument("-o", "--output", required=True)
    sp.add_argument("--input", required=True, help="输入 2ch WAV")
    sp.add_argument("--out-wav", default=None, help="输出 WAV（默认 <config>.out.wav）")
    sp.add_argument("--fs", type=int, default=None)
    sp.add_argument("--chunksize", type=int, default=None)
    sp.add_argument("--fir-dir", default=None)
    sp.set_defaults(func=cmd_file_config)

    sp = sub.add_parser("detect", help="输入内容检测（离线 WAV 或读运行态 state；LFE 不作判据）")
    sp.add_argument("--wav", default=None, help="给 WAV 做离线检测（H16 容器多声道）")
    sp.add_argument("--input-layout", default=None, help="输入布局（默认 h16-7.1.4）")
    sp.add_argument("--window-ms", type=float, default=500.0)
    sp.add_argument("--threshold-db", type=float, default=-50.0)
    sp.add_argument("--hold-ms", type=int, default=2500)
    sp.add_argument("--json", action="store_true", help="输出 JSON（默认就是 JSON）")
    sp.add_argument("--write-state", action="store_true", help="把结果写到 --state（默认不写）")
    sp.add_argument("--state", default=None)
    sp.add_argument("--mode-file", default=None)
    sp.set_defaults(func=cmd_detect)

    sp = sub.add_parser("input-mode", help="输入模式覆盖（auto|stereo|multichannel，持久化）")
    isub = sp.add_subparsers(dest="action")
    g = isub.add_parser("get", help="读覆盖值 + 运行态")
    g.add_argument("--json", action="store_true")
    g.add_argument("--state", default=None)
    g.add_argument("--mode-file", default=None)
    g.set_defaults(func=cmd_input_mode_get)
    s = isub.add_parser("set", help="写覆盖值（接受 force-stereo/force-multichannel 别名）")
    s.add_argument("mode")
    s.add_argument("--state", default=None)
    s.add_argument("--mode-file", default=None)
    s.add_argument("--updated-by", default="webui")
    s.set_defaults(func=cmd_input_mode_set)
    sp.set_defaults(func=cmd_input_mode_help)

    sp = sub.add_parser("autodetect", help="内容检测 daemon（读 CamillaDSP RMS，切 Aux1/Aux2）")
    sp.add_argument("--input-layout", default=None, help="容器输入布局（默认 h16-7.1.4）")
    sp.add_argument("--host", default="127.0.0.1")
    sp.add_argument("--port", type=int, default=int(os.environ.get("KHAEN_CAMILLADSP_PORT", "1234") or 1234))
    sp.add_argument("--interval-ms", type=int, default=500)
    sp.add_argument("--threshold-db", type=float, default=-50.0)
    sp.add_argument("--hysteresis-db", type=float, default=6.0)
    sp.add_argument("--hold-ms", type=int, default=2500)
    sp.add_argument("--ws-timeout", type=float, default=3.0)
    sp.add_argument("--startup-freeze-ms", type=int, default=2500,
                    help="启动冻结（默认 2500ms，期间保持直通）")
    sp.add_argument("--state", default=None)
    sp.add_argument("--mode-file", default=None)
    sp.add_argument("--simulate", default=None, help="回放 RMS 序列（测试/文件后端）")
    sp.add_argument("--once", action="store_true", help="只处理一轮")
    sp.add_argument("--dry-run", action="store_true", help="只判定/写 state，不下发 fader 命令")
    sp.add_argument("--no-write", action="store_true", help="不写 state 文件")
    sp.add_argument("--verbose", action="store_true", help="每轮打印 state")
    sp.add_argument("--max-seconds", type=float, default=None)
    sp.set_defaults(func=cmd_autodetect)

    sp = sub.add_parser("autodetect-config", help="生成双路径 autodetect CamillaDSP 配置")
    sp.add_argument("preset")
    sp.add_argument("-o", "--output", required=True)
    sp.add_argument("--fader-ramp", type=int, default=200)
    sp.add_argument("--content-mode", default="auto", choices=["auto", "stereo", "multichannel"],
                    help="auto=双路径（默认）；stereo=只有上混；multichannel=只有直通")
    sp.add_argument("--input-layout", default=None)
    sp.add_argument("--capture-channels", type=int, default=None)
    sp.add_argument("--playback-channels", type=int, default=None)
    sp.add_argument("--chunksize", type=int, default=None)
    sp.add_argument("--target-level", type=int, default=None)
    sp.add_argument("--adjust-period", type=int, default=None)
    sp.add_argument("--input", default=None, help="文件后端：输入 WAV（容器多声道）")
    sp.add_argument("--out-wav", default=None)
    sp.add_argument("--capture-device", default="hw:ravenna,0")
    sp.add_argument("--capture-format", default="S32_LE")
    sp.add_argument("--playback-device", default="hw:motu,0")
    sp.add_argument("--playback-format", default="S24_3_LE")
    sp.add_argument("--no-rate-adjust", action="store_true")
    sp.add_argument("--fs", type=int, default=None)
    sp.set_defaults(func=cmd_autodetect_config)

    sp = sub.add_parser("container", help="生成 H16 容器输入的上混/直通 profile + autodetect 配置")
    sp.add_argument("-o", "--output", required=True)
    sp.add_argument("--preset", action="append", default=None)
    sp.add_argument("--input-layout", default=None)
    sp.add_argument("--capture-channels", type=int, default=None)
    sp.add_argument("--playback-channels", type=int, default=None)
    sp.add_argument("--chunksize", type=int, default=None)
    sp.add_argument("--target-level", type=int, default=None)
    sp.add_argument("--adjust-period", type=int, default=None)
    sp.add_argument("--capture-device", default="hw:ravenna,0")
    sp.add_argument("--capture-format", default="S32_LE")
    sp.add_argument("--playback-device", default="hw:motu,0")
    sp.add_argument("--playback-format", default="S24_3_LE")
    sp.add_argument("--no-rate-adjust", action="store_true")
    sp.add_argument("--fader-ramp", type=int, default=200)
    sp.add_argument("--fs", type=int, default=None)
    sp.set_defaults(func=cmd_container)

    sp = sub.add_parser("check", help="自检 + 真实 CLI 校验")
    sp.add_argument("preset", nargs="?", default=None)
    sp.add_argument("--profile", default=None, help="校验已有 profile")
    sp.add_argument("--fs", type=int, default=None)
    sp.add_argument("--fir-dir", default=None)
    sp.add_argument("--tmpdir", default=None)
    sp.add_argument("--no-cli", action="store_true")
    sp.set_defaults(func=cmd_check)

    sp = sub.add_parser("params", help="WebUI 参数视图 JSON")
    sp.add_argument("preset")
    sp.add_argument("--fs", type=int, default=None)
    sp.add_argument("--fir-dir", default=None)
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_params)

    sp = sub.add_parser("all", help="生成全部 profile + CamillaDSP 配置 + manifest")
    sp.add_argument("-o", "--output", required=True)
    sp.add_argument("--fs", type=int, default=None)
    sp.add_argument("--preset", action="append", default=None)
    sp.add_argument("--fir-dir", default=None)
    sp.add_argument("--capture-device", default="hw:ravenna,0")
    sp.add_argument("--capture-format", default="S32_LE")
    sp.add_argument("--playback-device", default="hw:motu,0")
    sp.add_argument("--playback-format", default="S24_3_LE")
    sp.add_argument("--playback-channels", type=int, default=None)
    sp.add_argument("--chunksize", type=int, default=None)
    sp.add_argument("--target-level", type=int, default=None)
    sp.add_argument("--adjust-period", type=int, default=None)
    sp.add_argument("--no-rate-adjust", action="store_true")
    sp.set_defaults(func=cmd_all)

    sp = sub.add_parser("apply", help="热应用独立 CamillaDSP 配置（备份+校验+可选重启）")
    sp.add_argument("preset")
    sp.add_argument("--fs", type=int, default=None)
    sp.add_argument("--mode", choices=["auto", "off", "dante", "aes67"], default="auto")
    sp.add_argument("--config-target", default=DEFAULT_CONFIG_TARGET)
    sp.add_argument("--backup-dir", default=DEFAULT_VAR_DIR)
    sp.add_argument("--capture-device", default=None)
    sp.add_argument("--capture-format", default=None)
    sp.add_argument("--playback-device", default=None)
    sp.add_argument("--playback-format", default=None)
    sp.add_argument("--playback-channels", type=int, default=None)
    sp.add_argument("--chunksize", type=int, default=None)
    sp.add_argument("--target-level", type=int, default=None)
    sp.add_argument("--adjust-period", type=int, default=None)
    sp.add_argument("--no-rate-adjust", action="store_true")
    sp.add_argument("--no-restart", action="store_true")
    sp.add_argument("--no-check", action="store_true")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--fir-dir", default=None)
    sp.set_defaults(func=cmd_apply)

    sp = sub.add_parser("rollback", help="回滚最近一次 apply 的配置")
    sp.add_argument("--config-target", default=None)
    sp.add_argument("--backup-dir", default=DEFAULT_VAR_DIR)
    sp.add_argument("--no-restart", action="store_true")
    sp.add_argument("--dry-run", action="store_true")
    sp.set_defaults(func=cmd_rollback)
    return ap


def main(argv=None):
    global _LAYOUT_PRESETS_OVERRIDE
    ap = build_parser()
    args = ap.parse_args(argv)
    _LAYOUT_PRESETS_OVERRIDE = args.layout_presets
    _INPUT_LAYOUT_OVERRIDE = args.input_layout
    _PATH_OVERRIDE = args.path or "stereo"
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
