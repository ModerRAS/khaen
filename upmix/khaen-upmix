def _profile_role(role):
    out = {
        "id": role["id"], "label": ROLE_LABELS.get(role["id"], role["id"]),
        "enabled": bool(role["enabled"]), "outputs": list(role["outputs"]),
        "sources": [dict({"source": s["src"], "gain_db": float(s["gain_db"])},
                         **({"inverted": True} if s.get("inverted") else {}))
                    for s in role["sources"]],
        "gain_db": float(role["gain_db"]), "delay_ms": float(role["delay_ms"]),
        "polarity": role["polarity"], "peq": list(role.get("peq") or []),
    }
    for key in ("highpass", "lowpass", "fir"):
        if role.get(key):
            out[key] = dict(role[key])
    return out


def render_profile(plan):
    return {
        "schema": PROFILE_SCHEMA, "version": 2,
        "profile": {"name": plan.get("profile_name", plan["id"]), "description": plan["description"]},
        "input": {"layout": plan.get("input_layout", "pc-2ch"), "channels": plan["input_channels"],
                  "presets": {}, "probe_order": None},
        "output": {"device": "auto", "channels": plan["output_channels"],
                   "layout": plan["layout"],
                   "roles": [_profile_role(r) for r in plan["roles"]]},
        "remap": {"preset": None, "routes": [], "drop_unused": True, "silence_unmapped": True},
        "bass_management": plan["bass_management"],
    }


def profile_text(plan):
    header = (
        "# khaen-upmix 生成：%s\n# %s\n"
        "# 输入 %s（%dch）-> 输出 %s（%dch）；schema %s；khaen-upmix %s\n# 参数：%s\n"
        % (plan["id"], plan["description"], plan.get("input_layout", "pc-2ch"),
           plan["input_channels"], plan["layout"], plan["output_channels"],
           PROFILE_SCHEMA, TOOL_VERSION, "；".join(plan["notes"])))
    return header + dump_yaml(render_profile(plan))


