def _check_param_ranges(p):
    def chk(cond, msg):
        if not cond:
            die("预设 %s 参数越界：%s" % (p["id"], msg))

    chk(-60.0 <= p["front"]["gain_db"] <= 12.0, "front.gain_db")
    c = p["center"]
    chk(-60.0 <= c["gain_db"] <= 12.0, "center.gain_db")
    chk(-60.0 <= c["extract_gain_db"] <= 12.0, "center.extract_gain_db")
    chk(0.0 <= c["delay_ms"] <= 200.0, "center.delay_ms")
    s = p["surround"]
    chk(s["mode"] in ("difference", "mid"), "surround.mode 必须是 difference|mid")
    chk(-60.0 <= s["gain_db"] <= 12.0, "surround.gain_db")
    chk(-60.0 <= s["extract_gain_db"] <= 12.0, "surround.extract_gain_db")
    if s.get("ambience_gain_db") is not None:
        chk(-60.0 <= s["ambience_gain_db"] <= 12.0, "surround.ambience_gain_db")
    chk(0.0 <= s["delay_ms"] <= 199.0 and 0.0 <= s["delay_spread_ms"] <= 50.0
        and s["delay_ms"] + s["delay_spread_ms"] <= 200.0,
        "surround.delay_ms/delay_spread_ms（合计 ≤200ms）")
    h = p["height"]
    chk(h["mode"] in ("bandlimited", "broadband"), "height.mode 必须是 bandlimited|broadband")
    chk(h["source"] in ("mid", "side"), "height.source 必须是 mid|side")
    chk(-60.0 <= h["gain_db"] <= 12.0, "height.gain_db")
    chk(-60.0 <= h["extract_gain_db"] <= 12.0, "height.extract_gain_db")
    chk(0.0 <= h["width"] <= 1.0, "height.width")
    chk(0.0 <= h["delay_ms"] <= 199.0 and 0.0 <= h["delay_spread_ms"] <= 50.0
        and h["delay_ms"] + h["delay_spread_ms"] <= 200.0,
        "height.delay_ms/delay_spread_ms（合计 ≤200ms）")
    b = p["bass"]
    chk(b.get("mode", "matrix") in ("matrix", "redirect"), "bass.mode 必须是 matrix|redirect")
    chk(-60.0 <= b["extract_gain_db"] <= 12.0, "bass.extract_gain_db")
    chk(-60.0 <= b["sub_gain_db"] <= 12.0, "bass.sub_gain_db")
    for tr in b.get("sub_trims") or []:
        chk(isinstance(tr, dict), "bass.sub_trims 项必须是 mapping")
        g = tr.get("gain_db", 0.0)
        d = tr.get("delay_ms", 0.0)
        chk(is_num(g) and -60.0 <= g <= 12.0, "bass.sub_trims[].gain_db")
        chk(is_num(d) and 0.0 <= d <= 200.0, "bass.sub_trims[].delay_ms")
    d = p["decor"]
    chk(d["mode"] in ("delay", "allpass"), "decor.mode 必须是 delay|allpass")
    chk(isinstance(d["allpass_stages"], int) and 2 <= d["allpass_stages"] <= 8, "decor.allpass_stages")
    chk(isinstance(d["allpass_seed"], int), "decor.allpass_seed")


