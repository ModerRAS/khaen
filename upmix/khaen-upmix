    return build_content_state(mode, "unknown", override, confidence=0.0,
                               reason="daemon-not-running", detector="fallback")


# ---------------------------------------------------------------------------
# 多声道容器 WAV：读最后窗口，算每通道 RMS
# ---------------------------------------------------------------------------
def _wav_fmt_info(f):
    fmt = struct.unpack("<HHIIHH", f.read(16))
    return {"format": fmt[0], "channels": fmt[1], "rate": fmt[2], "block_align": fmt[4], "bits": fmt[5]}


def read_wav_channel_rms(path, window_ms=500.0):
    """返回 (samplerate, channels, rms_db 列表)。只读最后 window_ms 的音频（省内存/时间）。"""
    with open(path, "rb") as f:
        head = f.read(12)
        if len(head) < 12 or head[:4] not in (b"RIFF", b"WAVE"):
            die("不是 WAV：%s" % path)
        info = None
        data_off = data_len = None
        while True:
            hdr = f.read(8)
            if len(hdr) < 8:
                break
            cid = hdr[:4]
            size = struct.unpack("<I", hdr[4:])[0]
            if cid == b"fmt ":
                info = _wav_fmt_info(f)
                if size > 16:
                    f.seek(size - 16, 1)
                continue
            if cid == b"data":
                data_off = f.tell()
                data_len = size
                break
            if size & 1:
                size += 1
            f.seek(size, 1)
        if info is None or data_off is None:
            die("WAV 缺少 fmt/data：%s" % path)
        ch = int(info["channels"])
        ba = int(info["block_align"] or (ch * max(1, int(info["bits"]) // 8)))
        frames = int(data_len) // ba if ba else 0
        win = int(info["rate"] * float(window_ms) / 1000.0)
        n = min(frames, max(1, win))
        f.seek(data_off + (frames - n) * ba)
        raw = f.read(n * ba)
    if int(info["bits"]) == 32 and int(info["format"]) == 3:
        arr = array.array("f")
        arr.frombytes(raw)
        samples = list(arr)
        scale = 1.0
    elif int(info["bits"]) == 32 and int(info["format"]) == 1:
        arr = array.array("i")
        arr.frombytes(raw)
        samples = [v / 2147483648.0 for v in arr]
        scale = 1.0
    elif int(info["bits"]) == 16:
        arr = array.array("h")
        arr.frombytes(raw)
        samples = [v / 32768.0 for v in arr]
        scale = 1.0
    elif int(info["bits"]) == 24 and int(info["format"]) == 1:
        samples = []
        for i in range(0, len(raw) - 2, 3):
            v = raw[i] | (raw[i + 1] << 8) | (raw[i + 2] << 16)
            if v & 0x800000:
                v -= 0x1000000
            samples.append(v / 8388608.0)
        scale = 1.0
    else:
        die("暂不支持的 WAV 格式：format=%s bits=%s" % (info["format"], info["bits"]))
    n_frames = len(samples) // ch
    rms = []
    for c in range(ch):
        acc = 0.0
        for i in range(c, n_frames * ch, ch):
            v = samples[i]
            acc += v * v
        rms.append(10.0 * math.log10(max(acc / max(1, n_frames), 1e-24)))
    return int(info["rate"]), ch, rms


def detect_wav(path, in_info, window_ms=500.0, threshold_db=-50.0):
    fs, channels, rms = read_wav_channel_rms(path, window_ms)
    rms_by_role = {}
    for role, idx in in_info["roles"].items():
        rms_by_role[role] = rms[idx] if idx < len(rms) else None
    res = detect_content(rms_by_role, threshold_db)
    res["rms_db"] = rms_by_role
    res["fs"] = fs
    res["channels"] = channels
    return res


# ---------------------------------------------------------------------------
# 最小 WebSocket 客户端（stdlib；CamillaDSP 控制口）
# ---------------------------------------------------------------------------
class WSClient(object):
    def __init__(self, host="127.0.0.1", port=1234, timeout=3.0):
        self.timeout = float(timeout)
        self.sock = socket.create_connection((host, int(port)), self.timeout)
        self.sock.settimeout(self.timeout)
        self.buf = b""
        key = base64.b64encode(os.urandom(16)).decode()
        req = ("GET / HTTP/1.1\r\n"
               "Host: %s:%d\r\n"
               "Upgrade: websocket\r\n"
               "Connection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\n"
               "Sec-WebSocket-Version: 13\r\n\r\n" % (host, int(port), key))
        self.sock.sendall(req.encode("utf-8"))
        data = b""
        while b"\r\n\r\n" not in data:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise IOError("websocket handshake closed")
            data += chunk
        head, rest = data.split(b"\r\n\r\n", 1)
        status = head.split(b"\r\n")[0]
        if b"101" not in status:
            raise IOError("websocket handshake failed: %r" % status)
        self.buf = rest

    def _recv_exact(self, n):
        out = b""
        if self.buf:
            out, self.buf = self.buf[:n], self.buf[n:]
        while len(out) < n:
            chunk = self.sock.recv(n - len(out))
            if not chunk:
                raise IOError("websocket closed")
            out += chunk
        return out

    def _send_frame(self, opcode, payload):
        header = bytearray([0x80 | opcode])
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header += struct.pack("!H", n)
        else:
            header.append(0x80 | 127)
            header += struct.pack("!Q", n)
        mask = os.urandom(4)
        header += mask
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(bytes(header) + masked)

    def send_text(self, text):
        self._send_frame(1, text.encode("utf-8"))

    def recv_text(self):
        while True:
            h = self._recv_exact(2)
            b1, b2 = h[0], h[1]
            op = b1 & 0x0F
            ln = b2 & 0x7F
            if ln == 126:
                ln = struct.unpack("!H", self._recv_exact(2))[0]
            elif ln == 127:
                ln = struct.unpack("!Q", self._recv_exact(8))[0]
            masked = bool(b2 & 0x80)
            mask = self._recv_exact(4) if masked else None
            payload = self._recv_exact(ln)
            if masked and mask:
                payload = bytes(x ^ mask[i % 4] for i, x in enumerate(payload))
            if op == 1:
                return payload.decode("utf-8", "replace")
            if op == 8:
                raise IOError("websocket closed by peer")
            if op == 9:
                self._send_frame(10, payload)
                continue
            if op == 10:
                continue

    def cmd(self, obj):
        want = obj if isinstance(obj, str) else next(iter(obj.keys()))
        self.send_text(json.dumps(obj))
        deadline = time.time() + self.timeout
        while time.time() < deadline:
            text = self.recv_text()
            try:
                reply = json.loads(text)
            except ValueError:
                continue
            if isinstance(reply, dict) and want in reply:
                return reply[want]
        raise IOError("timeout waiting for %s" % want)

    def close(self):
        try:
            self._send_frame(8, b"")
        except Exception:
            pass
        try:
            self.sock.close()
        except Exception:
            pass


def _ws_capture_rms(ws, in_info):
    reply = ws.cmd("GetCaptureSignalRms") or {}
    vals = reply.get("value") or []
    rms = {}
    for role, idx in in_info["roles"].items():
        v = vals[idx] if idx < len(vals) else None
        if v is None:
            rms[role] = -240.0
        else:
            try:
                rms[role] = float(v)
            except (TypeError, ValueError):
                rms[role] = -240.0
    return rms


def _set_faders(ws, stereo_active):
    out = []
    want = {FADER_STEREO: 0.0 if stereo_active else MUTE_DB,
            FADER_PASS: MUTE_DB if stereo_active else 0.0}
    for fader, vol in want.items():
        try:
            rep = ws.cmd({"SetFaderVolume": [int(fader), float(vol)]}) or {}
        except Exception as e:
            raise IOError("SetFaderVolume(%d) 失败：%s" % (fader, e))
        out.append((fader, vol, (rep or {}).get("result")))
    return out


