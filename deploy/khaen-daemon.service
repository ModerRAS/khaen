[Unit]
Description=khaen control daemon
Documentation=https://github.com/ModerRAS/khaen
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/khaen/current/bin/khaen-daemon
EnvironmentFile=-/etc/khaen/daemon.env
Environment=KHAEN_STATE_DIR=/var/lib/khaen
Restart=on-failure
RestartSec=2
StateDirectory=khaen
# 控制面不碰实时音频线程；实时侧由 rt-host 进程负责。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# linuxptp pmc 需要在 /run 下创建客户端 UDS；ProtectSystem=strict 会把它变成只读，
# 否则 /api/status.ptp 恒 unavailable（pmc: uds: bind failed: Read-only file system）。
ReadWritePaths=/var/lib/khaen /run

[Install]
WantedBy=multi-user.target
