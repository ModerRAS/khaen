# khaen-rt-host 环境变量示例
#
# 用法：复制到 /etc/khaen/rt-host.env（systemd 的 EnvironmentFile），按设备实际情况修改。
# 说明见 docs/DEPLOY.md 4.3；这个进程**独占 ALSA 设备**，运行前先停掉 v1/keeper/prod_bridge。

# ---- ALSA 输出 ----
# 设备名必须是本机存在的 PCM；先在设备上只读查询：aplay -l / aplay -L / cat /proc/asound/cards。
# N150 上 v1 审查记录 MOTU UltraLite-mk5 的 card id 是 UltraLitemk5（不是 MOTU），
# 对应写法是 hw:CARD=UltraLitemk5,DEV=0；照抄名字打不开设备。
KHAEN_ALSA_DEVICE=default
KHAEN_SAMPLE_RATE=48000
KHAEN_BLOCK_FRAMES=128
KHAEN_CHANNELS=2

# ---- AES67 输入（发送端参数，必须与流一致）----
KHAEN_AES67_GROUP=239.69.67.1
KHAEN_AES67_PORT=5004
KHAEN_AES67_PAYLOAD_TYPE=97
KHAEN_AES67_CHANNELS=2
KHAEN_AES67_MAP=0,1
KHAEN_JITTER_FRAMES=192

# ---- 方案与运行 ----
# 方案文件（ABI v3）；不设置时按 KHAEN_UNLOADED 策略运行（默认 silence，fail-closed）。
#KHAEN_PLAN=/var/lib/khaen/test.plan
KHAEN_UNLOADED=silence
# 0 = 一直运行；验证跑固定时长时设秒数（例如 1800 = 30 分钟 soak）。
KHAEN_RUN_SECONDS=0
KHAEN_STATS_EVERY_BLOCKS=4000

# ---- 设备监督器（可选；不配置就如实报告 absent，不猜速率）----
#KHAEN_DEVICE_ID=UltraLitemk5
#KHAEN_RATE_READ=/opt/khaen/current/bin/khaen-motu-read-rate
#KHAEN_RATE_ASSERT=/opt/khaen/current/bin/khaen-motu-set-rate {rate}
#KHAEN_CONTROL_COMMAND=/opt/khaen/current/bin/khaen-motu-net-up

# ---- 无人值守取证 / daemon 聚合 ----
# 每统计周期原子写状态 JSON（schema khaen-rt-status/v1）；daemon 的 /api/status 聚合读它。
# 必须与 daemon.env 的 KHAEN_RT_STATUS_FILE 指向同一路径。
KHAEN_STATUS_FILE=/var/lib/khaen/rt-host-status.json
