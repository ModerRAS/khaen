# khaen-rt-host 环境变量示例
#
# 用法：复制到 /etc/khaen/rt-host.env（systemd 的 EnvironmentFile），按设备实际情况修改。
# 说明见 docs/DEPLOY.md 4.3；这个进程**独占 ALSA 设备**，运行前先停掉 v1/keeper/prod_bridge。

# ---- ALSA 输出 ----
# 设备名必须是本机存在的 PCM；先在设备上只读查询：aplay -l / aplay -L / cat /proc/asound/cards。
# N150 上 v1 审查记录 MOTU UltraLite-mk5 的 card id 是 UltraLitemk5（不是 MOTU），
# 对应写法是 hw:CARD=UltraLitemk5,DEV=0；照抄名字打不开设备。
KHAEN_ALSA_DEVICE=default
KHAEN_SAMPLE_RATE=48000
KHAEN_BLOCK_FRAMES=128
KHAEN_CHANNELS=2
# IO I1：输入/输出宽度可分开；KHAEN_CHANNELS 同时作为两者的缺省值（向后兼容）。
# 例如 2 路输入、22 路 MOTU 输出时：KHAEN_INPUT_CHANNELS=2 / KHAEN_OUTPUT_CHANNELS=22，
# 且 KHAEN_AES67_MAP 的槽位必须 < 输入宽度。
#KHAEN_INPUT_CHANNELS=2
#KHAEN_OUTPUT_CHANNELS=22

# ---- AES67 输入（发送端参数，必须与流一致）----
KHAEN_AES67_GROUP=239.69.67.1
KHAEN_AES67_PORT=5004
KHAEN_AES67_PAYLOAD_TYPE=97
KHAEN_AES67_CHANNELS=2
KHAEN_AES67_MAP=0,1
# IO I2a/I2b：可选 SDP 文件作为以上 AES67 单流参数的来源（组播/单播地址、端口、PT、通道）。
# 若同时设置上面的 KHAEN_AES67_* 且与 SDP 不一致，进程启动失败（fail-closed）。
# 组播 SDP 走 join；单播 SDP 直接 bind SDP 的 c= 本端地址。ptime 2ms/4ms 只告警不拒收。
#KHAEN_AES67_SDP=/etc/khaen/rx.sdp
# 多路 AES67（IO I3c，启动期固定；JSON 数组，宽度/块长/速率继承主流）：
#KHAEN_AES67_ADDITIONAL_STREAMS=/etc/khaen/streams.json
# IO I4b：ALSA 采集输入（设置后替代 AES67 收包；与 SDP/多流互斥）
#KHAEN_ALSA_CAPTURE=hw:CARD=UltraLitemk5,DEV=0
#KHAEN_ALSA_CAPTURE_CHANNELS=2
#KHAEN_ALSA_CAPTURE_MAP=0,1
#KHAEN_ALSA_CAPTURE_PENDING_BLOCKS=4
KHAEN_JITTER_FRAMES=192

# ---- 方案与运行 ----
# 方案文件（ABI v3）；不设置时按 KHAEN_UNLOADED 策略运行（默认 silence，fail-closed）。
#KHAEN_PLAN=/var/lib/khaen/test.plan
KHAEN_UNLOADED=silence
# 0 = 一直运行；验证跑固定时长时设秒数（例如 1800 = 30 分钟 soak）。
KHAEN_RUN_SECONDS=0
KHAEN_STATS_EVERY_BLOCKS=4000

# ---- 无人值守取证：状态文件（daemon /api/status 聚合读取同一路径）----
# 生产固定用 /var/lib/khaen/rt-host-status.json（与 daemon.env 的 KHAEN_RT_STATUS_FILE 一致）；
# 目录必须在 unit 的 ReadWritePaths 里（见 khaen-rt-host.service）。
KHAEN_STATUS_FILE=/var/lib/khaen/rt-host-status.json

# ---- T70f 控制通道（daemon 代理上线前的本机控制/校准入口）----
# KHAEN_CONTROL=off 可关；socket 目录同样要在 ReadWritePaths 里。
KHAEN_CONTROL=on
KHAEN_CONTROL_SOCKET=/run/khaen/rt-host.sock

# ---- 设备监督器（可选；不配置就如实报告 absent，不猜速率）----
#KHAEN_DEVICE_ID=UltraLitemk5
#KHAEN_RATE_READ=/opt/khaen/current/bin/khaen-motu-read-rate
#KHAEN_RATE_ASSERT=/opt/khaen/current/bin/khaen-motu-set-rate {rate}
#KHAEN_CONTROL_COMMAND=/opt/khaen/current/bin/khaen-motu-net-up

# ---- 无人值守取证 / daemon 聚合 ----
# 每统计周期原子写状态 JSON（schema khaen-rt-status/v1）；daemon 的 /api/status 聚合读它。
# 必须与 daemon.env 的 KHAEN_RT_STATUS_FILE 指向同一路径。
KHAEN_STATUS_FILE=/var/lib/khaen/rt-host-status.json

# ---- 进程内校准播放（T70f-c；通道识别测试音复用同一播放 seam）----
# 开关：off/0/false 关闭；不设置 = 打开。未装配时 cal_* 如实进 not_wired。
#KHAEN_CAL=on
# 校准产物目录（默认 /var/lib/khaen/cal）。
#KHAEN_CAL_DIR=/var/lib/khaen/cal
# UMIK 采集（声明必填，缺任一项 -> mic_declaration_missing，不猜）。
#KHAEN_UMIK_DEVICE=hw:0,0
#KHAEN_UMIK_SERIAL=<umik-序列号>
#KHAEN_UMIK_CAL_FILE=<umik-校准文件>
#KHAEN_UMIK_CAL_SHA256=<64位小写hex>
# 采集读块通道数（UMIK-1 部分主机只暴露 2ch，默认 2；1ch 设备设 1）。
#KHAEN_CAL_CAPTURE_CHANNELS=2
# 播放通道列表（逗号分隔 DAC 号；默认旧 4.1.2 物理列表 0,1,2,3,4,5,7）。
#KHAEN_CAL_CHANNELS=0,1,2,3,4,5,7
# layout id（默认 4.1.2；新栈布局解析器未接线，通道列表是显式声明）。
#KHAEN_CAL_LAYOUT=4.1.2
# 驱动电平（dBFS；默认 -12，与旧 SWEEP_LEVEL 一致）。
#KHAEN_CAL_LEVEL_DBFS=-12
# 引擎选择（auto|fake；默认 auto。非 Linux 的 auto 降级 fake 并标 simulated）。
#KHAEN_CAL_ENGINE=auto