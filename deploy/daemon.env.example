# khaen-daemon 环境变量示例
#
# 用法：复制到 /etc/khaen/daemon.env（systemd 的 EnvironmentFile），按设备实际情况修改。
# 这个文件只影响控制面 daemon；实时音频线程由将来的 khaen-rt-host 进程负责。
#
# 注意：本文件里的辅助脚本路径（khaen-motu-*）目前**还不存在**——它们属于设备部署的一部分，
# 由装机时提供；没有这些脚本时 **不要**设置 KHAEN_RATE_READ/KHAEN_RATE_ASSERT，
# daemon 会如实把 device.wired 报成 false，而不是编造速率。

# ---- 控制面 ----
# 监听地址优先级：KHAEN_BIND > KHAEN_PORT > PORT > 默认 127.0.0.1:8730。
# 生产（WebUI 直接对局域网）用 KHAEN_BIND=0.0.0.0:80；只给端口时只绑 127.0.0.1。
# WebUI 的 dist 已编进二进制（含登录/setup），运行时不依赖 Node。
KHAEN_BIND=0.0.0.0:80
#KHAEN_PORT=8730
# 认证存储与将来的上传/向导状态（首次打开 WebUI 走 setup 设密码，argon2id 落盘，0600）。
KHAEN_STATE_DIR=/var/lib/khaen
# rt-host 状态文件（/api/status 聚合读取）；与 rt-host.env 的 KHAEN_STATUS_FILE 同一路径。
KHAEN_RT_STATUS_FILE=/var/lib/khaen/rt-host-status.json
KHAEN_BLOCK_FRAMES=128
KHAEN_SAMPLE_RATE=48000
# MOTU UltraLite-mk5 实测 22 声道；先只读 aplay -l / cat /proc/asound/cards 确认后再改。
KHAEN_CHANNELS=2

# ---- 设备监督器（可选）----
# 不设置 KHAEN_DEVICE_ID：/api/status 的 device 字段 = {"wired": false, "reason": ...}。
# 设置后按 /sys/class/sound/card*/id 的子串匹配声卡；先只读确认（aplay -l / cat /proc/asound/cards）。
# v1 审查记录里 N150 上 MOTU UltraLite-mk5 的 card id 是 UltraLitemk5；不要照抄 MOTU。
#KHAEN_DEVICE_ID=UltraLitemk5

# 读当前采样率：命令打印一个整数（例如从 CueMix 读回）。
#KHAEN_RATE_READ=/opt/khaen/current/bin/khaen-motu-read-rate

# 写采样率：{rate} 被替换成目标速率；不含占位符时速率作为最后一个参数追加。
#KHAEN_RATE_ASSERT=/opt/khaen/current/bin/khaen-motu-set-rate {rate}

# 可选：拉起控制通道（等价 v1 的 tspi-motu-net-up：网口 up、地址、ping/WS 就绪）。
#KHAEN_CONTROL_COMMAND=/opt/khaen/current/bin/khaen-motu-net-up

# 监督器轮询间隔（毫秒），默认 500。
KHAEN_DEVICE_POLL_MS=500

# ---- 控制通道目标（v1.2 起：daemon 与 rt-host 分进程）----
# 目标：rt-host（默认，经 UNIX socket 发给真正的数据面）| process（仅离线测试/演示，不碰设备）。
#KHAEN_RT_TARGET=rt-host
# 与 rt-host.env 的 KHAEN_CONTROL_SOCKET 必须一致。
#KHAEN_RT_SOCKET=/run/khaen/rt-host.sock
# 单次往返超时（毫秒）；必须大于 rt-host 的 5 s 块边界 ack 上限（默认 10000）。
#KHAEN_RT_TIMEOUT_MS=10000

# ---- v1.2 能力开关 ----
# 校准 job 后端：off/0 关闭 -> /api/meta 与 job 端点如实 not_wired + 原因；
# offline = 只跑离线闭环 job（默认）；rt-host = 真实 rt-host 测量 job（single_point_rt_host）；
# auto = 启动时只读探测一次 rt-host cal_status，成功进 rt-host，失败降级 offline 并把真实原因写进 status。
# 生产真实测量建议显式 rt-host（并保证 KHAEN_RT_TARGET=rt-host、control socket 可用）；auto 的探测只在启动时做一次。
#KHAEN_CAL_BACKEND=rt-host
# /api/system/restart 允许经 systemctl 重启 rt-host：默认关（403 restart_disabled）；设 1 才允许。
#KHAEN_ALLOW_RESTART=0
# 通道识别测试音：默认关；设 on 才允许 /api/speaker-test（仍受出声窗口与 audible+confirm 约束）。
#KHAEN_SPEAKER_TEST=off
# 出声窗口（HH:MM-HH:MM，逗号分隔；服务端本地时间）。窗口外测试音返回 403 sound_window_closed。
#KHAEN_SOUND_WINDOW=08:30-12:00,14:30-18:00
