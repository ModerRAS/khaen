# khaen-daemon 环境变量示例
#
# 用法：复制到 /etc/khaen/daemon.env（systemd 的 EnvironmentFile），按设备实际情况修改。
# 这个文件只影响控制面 daemon；实时音频线程由将来的 khaen-rt-host 进程负责。
#
# 注意：本文件里的辅助脚本路径（khaen-motu-*）目前**还不存在**——它们属于设备部署的一部分，
# 由装机时提供；没有这些脚本时 **不要**设置 KHAEN_RATE_READ/KHAEN_RATE_ASSERT，
# daemon 会如实把 device.wired 报成 false，而不是编造速率。

# ---- 控制面 ----
# 只绑本机回环；公网暴露由前置代理负责。
KHAEN_PORT=8730
KHAEN_BLOCK_FRAMES=128
KHAEN_SAMPLE_RATE=48000
KHAEN_CHANNELS=2

# ---- 设备监督器（可选）----
# 不设置 KHAEN_DEVICE_ID：/api/status 的 device 字段 = {"wired": false, "reason": ...}。
# 设置后按 /sys/class/sound/card*/id 的子串匹配声卡（MOTU UltraLite-mk5 的 id 含 "MOTU"）。
#KHAEN_DEVICE_ID=MOTU

# 读当前采样率：命令打印一个整数（例如从 CueMix 读回）。
#KHAEN_RATE_READ=/opt/khaen/current/bin/khaen-motu-read-rate

# 写采样率：{rate} 被替换成目标速率；不含占位符时速率作为最后一个参数追加。
#KHAEN_RATE_ASSERT=/opt/khaen/current/bin/khaen-motu-set-rate {rate}

# 可选：拉起控制通道（等价 v1 的 tspi-motu-net-up：网口 up、地址、ping/WS 就绪）。
#KHAEN_CONTROL_COMMAND=/opt/khaen/current/bin/khaen-motu-net-up

# 监督器轮询间隔（毫秒），默认 500。
KHAEN_DEVICE_POLL_MS=500
