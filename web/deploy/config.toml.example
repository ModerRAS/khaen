# tpsi-audio-web 配置文件示例
# 安装到 /etc/khaen-audio-web/config.toml（权限 0600，含 access token）。
# 首次启动时若本文件不存在，服务会自动生成一份并打印随机 token；
# 若 token 为空或仍为 CHANGE_ME，也会自动生成并写回本文件。

# 监听地址。生产默认 0.0.0.0:80：局域网直接 http://<设备IP>/，不用记端口；
# systemd unit 以 root 运行，可直接绑定 <1024；8080 留给 AES67 daemon 自带 Web UI。
# 如 80 被占用/无权限，改成 0.0.0.0:8088 回退（记得放行 8088）。
listen = "0.0.0.0:80"

# 访问 token。所有 API（/healthz 除外）都需要它。
# 修改后执行: systemctl restart khaen-audio-web
# 查看当前 token: sudo khaen-audio-web --config /etc/khaen-audio-web/config.toml --print-token
# 启动时会把当前 token 同步到环境变量 TSPI_WEB_TOKEN_FILE（默认 /etc/tspi/web-token，OEM 约定），
# 避免 first-boot 生成的 web-token 与 Web 自生成 token 不一致导致登录 401。
token = "CHANGE_ME"
# 管理密码哈希（Argon2id，0600；首次打开 Web 设置密码时创建）。
# 不存在 = 显示“首次设置管理密码”页；设置后密码登录，token 保留为恢复/CLI 兜底。
auth_file = "/etc/khaen-audio-web/auth.json"

# 登录会话有效期（秒），默认 12 小时。
session_ttl_secs = 43200
# 仅当经 HTTPS 反代访问时开启（给 Cookie 加 Secure）。
cookie_secure = false
# journalctl 默认读取行数。
log_lines = 100
# 登录失败锁定时间（秒）。
login_lockout_secs = 60

[camilladsp]
# CamillaDSP websocket API（HEnquist/camilladsp，-p 1234 启动）。
ws_url = "ws://127.0.0.1:1234"
# OEM v2 实际单元名（tspi-*；通用名 camilladsp.service 在板上不存在）
service = "tspi-camilladsp.service"
# 当前生效配置（切换配置时同步写此处，保证重启后仍是同一份）。
config_file = "/etc/camilladsp/config.yml"
config_dir = "/etc/camilladsp/configs"
ws_timeout_ms = 3000

[ptp]
conf_file = "/etc/ptp4l.conf"
pmc_bin = "pmc"
# linuxptp 服务（仅方案 B2：本机 ptp4l 做 GM 时使用；B1 下不启动）
ptp4l_service = "tspi-ptp4l-master.service"
phc2sys_service = "tspi-phc2sys.service"
# PTPv1（Dante/Inferno 使用的 Statime）
statime_service = "tspi-statime-inferno.service"
# |offset| 小于该值才算锁定（纳秒）。
lock_offset_threshold_ns = 1000000

[aes67]
# holoplot/aes67-linux-daemon 的服务名与配置路径以实际部署为准，可在此修改。
service = "tspi-aes67-daemon.service"
config_files = ["/etc/aes67-daemon/aes67-daemon.json", "/etc/aes67-daemon.json"]
webui_url = "http://127.0.0.1:8080"
log_lines = 100

[inferno]
# Inferno（Dante 兼容）本身是 ALSA 插件（libasound_module_pcm_inferno），没有独立 systemd 服务；
# 这里指向 PTPv1 从时钟单元（OEM v2 的 tspi-statime-inferno.service）仅用于状态/日志展示，
# 服务状态页会明确标注“ALSA 插件，无独立服务”。下面两个路径仅用于只读展示。
service = "tspi-statime-inferno.service"
config_files = ["/etc/default/inferno", "/etc/asound.conf"]
webui_url = ""
log_lines = 100

[alsa]
aplay_bin = "aplay"
# 空 = 自动优先选择 MOTU UltraLite-mk5，其次第一个 playback 设备。
default_device = ""

[system]
# 电源操作默认关闭；开启后 Web 端仍需二次确认。
allow_reboot = false
allow_shutdown = false

[channelmap]
# 声道分配/校准页。契约由 audio-stack 提供（schema tspi-channelmap/v2 + tspi-layout-presets/v2）：
#   active  /etc/tspi-audio/channelmap.yml（首启无此文件，用页面向导生成）
#   presets /etc/tspi-audio/layout-presets.yml（只读）
#   profiles /etc/tspi-audio/profiles/*.yml
# apply/rollback 走 tspi-channelmap（见下方 cli_bin）；mode/音频服务仍由 tspi-mode 控制。
enabled = true
config_file = "/etc/tspi-audio/channelmap.yml"
profiles_dir = "/etc/tspi-audio/profiles"
render_file = "/run/tspi/camilladsp.yml"
fir_dir = "/etc/tspi-audio/coeffs"
# apply 调用 tspi-mode channelmap apply --file <config_file>；rollback 调 tspi-mode channelmap rollback
script = "/usr/local/bin/tspi-mode"
# 兼容保留字段：现已不使用（校验/渲染统一走下方 cli_bin；CLI 缺失时 Web 返回 503，不再回退内置规则）
validate_bin = "/usr/local/bin/tspi-channelmap"
# 布局预设文件（audio-stack 提供；不存在时用内置 2.0/5.1/7.1.4 等预设）
presets_file = "/etc/tspi-audio/layout-presets.yml"
# tspi-channelmap CLI（probe/validate/print/render/apply/rollback/profiles）。板端唯一权威；
# 校验/渲染/apply 全部委托它，CLI 缺失时 API 返回 503，不以内置规则放行。
cli_bin = "/usr/local/bin/tspi-channelmap"
# 输入内容检测（auto / 2.0 / multichannel）：tspi-upmix 检测器写运行态，WebUI 只读 + 写覆盖文件。
# 字段由 audio-stack/upmix 提供；WebUI 不改 channelmap schema。
input_state_file = "/run/tspi/input-content.json"
input_mode_file = "/etc/tspi-audio/input-mode.json"
# tspi-upmix CLI（可选；存在时 input-mode set 优先走 CLI，失败/不存在则 WebUI 直接写覆盖文件）
upmix_bin = "/usr/local/bin/tspi-upmix"
# 输入通道检测（SDP 目录；不存在时回退 CamillaDSP 配置）
sdp_dir = "/etc/aes67/sdp"
default_layout = "5.3.2"
# 空 = 自动优先 MOTU / 第一个 playback 设备
output_device = ""

[mode]
# 运行模式切换（dante / aes67 / off）。
enabled = true
# 持久化当前模式；重启后按 restore_on_start 恢复。
state_file = "/etc/khaen-audio-web/state.json"
# audio-stack 提供的统一切换脚本：tspi-mode <dante|aes67|off> --json
# 状态查询：tspi-mode status --json（schema=tspi-audio/v1，含 ptp_role/ptp_lock/pid 及嵌套 ptp/aoip/camilladsp/alsa/last_error）
# 退出码：0 就绪 / 2 参数 / 3 前置 / 4 设备 / 5 PTP未锁 / 7 DSP启动失败 / 8 自检失败 / 9 已回滚 / 10 另一切换进行中
# 为空或文件不存在时，使用 Web 服务内置编排（systemctl + CamillaDSP 配置重载）。
switch_script = "/usr/local/bin/tspi-mode"
# D4：默认开机不自动恢复音频模式（audio off，用户手动切换）。
# 若需要开机恢复上次模式，改为 true；Web 服务在启动时才会调用 tspi-mode 切换。
restore_on_start = false
switch_timeout_secs = 180
ptp_lock_timeout_secs = 60
aoip_ready_timeout_secs = 30
camilla_ready_timeout_secs = 30
poll_ms = 500

[mode.dante]
label = "Dante（Inferno / PTPv1）"
ptp_version = "PTPv1"
# Dante 模式：PTPv1 由 Statime 提供（从 Inferno/Statime 读锁定状态）
ptp_services = ["tspi-statime-inferno.service"]
ptp_source = "statime"
ptp_role = "slave"
# Inferno 是 ALSA 插件、无独立服务；这里与 ptp_services 指向同一 PTPv1 单元仅用于启停编排/状态
aoip_service = "tspi-statime-inferno.service"
camilla_config = "/etc/camilladsp/configs/dante.yml"
# 输入：Dante 96 kHz / 24-bit（支持 16-bit 输入），输出 MOTU 24-bit。
input_sample_rate = 96000
input_bit_depth = 24
channels = 2
output_sample_rate = 96000
output_bit_depth = 24
default_chunksize = 128
default_target_level = 2048

[mode.aes67]
label = "AES67（aes67-daemon / PTPv2）"
ptp_version = "PTPv2"
# 方案 B1（默认）：本机不做 PTP master，aes67-daemon 自带 PTPv2 slave；
# 因此不启动 ptp4l/phc2sys，PTP 锁定状态从 aes67 daemon（与 tspi-mode status）读取。
# 方案 B2（本机 ptp4l 做 GM）改为：
#   ptp_services = ["ptp4l.service", "phc2sys.service"]
#   ptp_source = "linuxptp"
#   ptp_role = "master"
ptp_services = []
ptp_source = "aes67-daemon"
ptp_role = "slave"
aoip_service = "tspi-aes67-daemon.service"
camilla_config = "/etc/camilladsp/configs/aes67.yml"
# 输入：AES67 48 kHz / 24-bit（支持 16-bit 输入），输出 MOTU 24-bit。
input_sample_rate = 48000
input_bit_depth = 24
channels = 2
output_sample_rate = 48000
output_bit_depth = 24
default_chunksize = 128
default_target_level = 2048

[motu]
# CueMix / UltraLite-mk5。写入前快照目录，只保留最近 20 份。mock 模式不落盘、不执行 ip。
snapshot_dir = "/var/lib/khaen-audio-web/motu-snapshots"
link_local_cidr = "169.254.111.200/16"
cache_ttl_ms = 12000
discover_timeout_ms = 2500
read_timeout_ms = 5000
idle_ms = 250
ws_port = 1280
