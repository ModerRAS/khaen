# T28/T71 —— khaen-irq-affinity.service（task-192；IRQ 亲和持久化 oneshot）
#
# 背景（task-189 实测，证据 evidence/board-irq-affinity/）：
#   T45 scheduler plan() 要求 worker 依赖 IRQ（bit0/1 USB、bit2 PTP、bit3 eth）不落在 DSP_CPUS={4,5,6,7}；
#   把 IRQ58(xhci/MOTU)→CPU1、IRQ56(end0/PTP)→CPU2、IRQ57(end0 第二队列)→CPU3 后 plan accepted，
#   但 **irqbalance 会在 ≤25s 内把它们搬回 A72** → 迁移不持久。因此：
#     1) 04-install-release.sh 停用 irqbalance 并写内核 IRQ 亲和；
#     2) 本 oneshot 在 khaen-rt-host 启动前**再钉一次**并回读校验，覆盖开机/irqbalance 被手动拉回等场景。
#
# 设计约束：
#   * 只写 /proc/irq/<irq>/smp_affinity_list；不碰 USB/网口配置、不打开音频、不改旧 C；
#   * 失败即 exit nonzero：khaen-rt-host.service Requires= 本单元，钉核失败时不启动 host（fail-safe，
#     避免用「IRQ 落在 DSP 核」的拓扑跑 T45 admission）；
#   * B1（2026-11-20 板窗 release-v11 实测）：开机 ~4s 时本 oneshot 先执行，end0 的 IRQ56/57 节点
#     尚未注册（stmmac/网络枚举晚于 target），apply fail-closed（"FAIL IRQ56 不存在"）→ host 因
#     Requires= 整栈起不来。修复：ExecStartPre 先等依赖 IRQ 节点就绪（irq-affinity-pin wait，
#     上限 KHAEN_IRQ_WAIT_SECS 默认 60s），超时仍 fail-closed，不启动 host；
#     既有板端 live-only drop-in（khaen-irq-affinity.service.d/10-wait-irq.conf）由 04 安装时
#     迁移到 evidence/migrated-dropins/ 并删除（本 unit 已内置同一语义，避免陈旧硬编码 IRQ 等待）；
#   * 回滚见 deploy/README.md「IRQ 亲和持久化」：disable 本单元 + systemctl enable --now irqbalance + 写回原值。
[Unit]
Description=KHAEN IRQ affinity persistence (T45 USB/PTP/eth IRQs -> A53 control cores; pre-host pin)
Documentation=file:///opt/khaen-rt-stack/current/README.deploy.md
Before=khaen-rt-host.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
EnvironmentFile=-/etc/khaen-rt-stack/irq-affinity.env
# B1：开机先等依赖 IRQ 的 /proc/irq 节点就绪，再由 ExecStart 钉核并回读校验。
ExecStartPre=/usr/local/lib/khaen/irq-affinity-pin wait
ExecStart=/usr/local/lib/khaen/irq-affinity-pin apply
# 等待窗口（默认 60s）之后仍需留出钉核/回读时间；超时总预算 120s。
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=khaen-rt-stack.target
