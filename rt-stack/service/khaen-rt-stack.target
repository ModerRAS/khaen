# T28/T155 —— khaen-rt-stack.target（新栈总目标，F-18/T28-P0-1 修复）
#
# 只 Wants 自研 host + daemon；不得 Wants/After 任何旧 C unit（deploy/tests/check_unit_syntax.py 会拒收）。
# 安装：deploy/bin/04-install-release.sh 从 release bundle 的 units/ 复制到 /etc/systemd/system/。
#
# F-18 修复（2026-11-17）：target 显式 Wants/After host+daemon。
#   只 enable/start target 即可拉起 host+daemon；service 的 WantedBy=khaen-rt-stack.target 只生成
#   target.wants/ 链接，不能代替 target 自身的 Wants=。05-atomic-switch.sh 在 start target 后
#   逐个校验 host/daemon active（T28-P0-a）。
[Unit]
Description=KHAEN RT-first DSP stack (own host + control/calibration daemon; no CamillaDSP)
Documentation=file:///opt/khaen-rt-stack/current/README.deploy.md
After=network-online.target khaen-irq-affinity.service khaen-rt-host.service khaen-rt-daemon.service
Wants=network-online.target khaen-irq-affinity.service khaen-rt-host.service khaen-rt-daemon.service

[Install]
WantedBy=multi-user.target
