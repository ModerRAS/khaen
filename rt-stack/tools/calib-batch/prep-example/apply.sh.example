#!/usr/bin/env bash
# KHAEN 校准批量窗口：apply 包装（示例；窗口前冻结 REST/命令细节与 hash）
# 用法（由 plan 生成的 argv 调用）：apply.sh <step_dir>
# 约束：真实 apply 目前依赖 B1/B4（T71 签发 + CalibrationPort）；未解锁时必须
#       记录 503/NOT_RUN 并回退 last-good，不得启动 CamillaDSP（C 永不回退）。
set -u
if [ $# -lt 1 ]; then echo "usage: apply.sh <step_dir>" >&2; exit 2; fi
STEP_DIR="$1"
mkdir -p "$STEP_DIR"
OUT="$STEP_DIR/applied.json"
LOG="$STEP_DIR/apply.log"
echo "# khaen-cal-batch apply $(date -Is)" | tee "$LOG"

TOKEN_FILE="$KHAEN_DAEMON_AUTH"
if [ -z "$TOKEN_FILE" ]; then TOKEN_FILE=/etc/khaen-rt-stack/daemon-auth.json; fi
BASE_URL="$KHAEN_DAEMON_URL"
if [ -z "$BASE_URL" ]; then BASE_URL=http://127.0.0.1:80; fi
TOKEN=""
if [ -r "$TOKEN_FILE" ]; then
  TOKEN=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("token",""))' "$TOKEN_FILE" 2>/dev/null || true)
fi

# 示例流程（与 runbook §5.2 R4/R5/R7 对齐，NOT_RUN 直到板端窗口）：
# 1) POST /api/calibration/jobs {"kind":"full","auto_apply":false}
# 2) 轮询状态到 prepared/awaiting_apply
# 3) POST /api/calibration/jobs/<id>/apply
# 4) 校验 applied_version 非空；失败 -> 回退 last-good/mute
# 本示例不伪造结果：无 token/端点在 503 时直接 exit 3 并写 NOT_RUN。
RC=0
if [ -z "$TOKEN" ]; then
  echo "NOT_RUN 缺少 daemon token：$TOKEN_FILE" | tee -a "$LOG"
  RC=3
else
  echo "NOT_RUN 真实 apply 接线由窗口任务完成（B4：CalibrationPort 未挂 -> 预期 503）" | tee -a "$LOG"
  RC=3
fi
cat > "$OUT" <<EOF
{"schema":"khaen-cal-batch-apply-cmd/v1","step_dir":"$STEP_DIR","rc":$RC,
 "applied_version":null,"not_run":["真实 apply：B1/B4 未解锁；本示例不伪造 applied_version"]}
EOF
exit "$RC"
