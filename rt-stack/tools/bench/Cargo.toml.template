# TSPI offline perf harness staging manifest (generated by run-bench.ps1 into %TEMP%).
# The rt-stack repo allows exactly ONE Cargo root (README section 1/3), so this harness does
# NOT create any Cargo.toml inside rt-stack; the temp crate only path-depends on crates/core.

[package]
name = "tspi-perf-harness"
version = "0.1.0"
edition = "2021"
publish = false

[workspace]

[dependencies]
tspi-dsp-core = { path = "@CORE_PATH@" }

[profile.release]
debug = false
lto = false
codegen-units = 1
