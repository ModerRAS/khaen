#!/bin/sh
# khaen-ptp-master-start -- ExecStart wrapper for khaen-ptp-master.service.
# Resolves the interface, chooses hardware (PHC) or software timestamping per KHAEN_PTP_HW_TS,
# then exec()s the bundled ptp4l. No shell wrapper state remains after exec.
set -eu

LIB=/usr/local/lib/khaen/ptp-lib.sh
if [ ! -r "$LIB" ]; then
    echo "khaen-ptp: ERROR: $LIB missing (bundle lib/ not installed)" >&2
    exit 78
fi
# shellcheck source=ptp-lib.sh
. "$LIB"

KHAEN_PTP_CONF=${KHAEN_PTP_CONF:-/etc/khaen-ptp/ptp4l-master.conf}
IFACE=$(resolve_ptp_iface) || exit 78
if [ ! -r "$KHAEN_PTP_CONF" ]; then
    ptp_log "ERROR: config not readable: $KHAEN_PTP_CONF"
    exit 78
fi

MODE=${KHAEN_PTP_HW_TS:-auto}
case "$MODE" in
    auto)
        if PHC=$(detect_ptp_phc "$IFACE"); then
            TSFLAG=-H
            ptp_log "iface=$IFACE timestamping=hardware phc=$PHC conf=$KHAEN_PTP_CONF"
        else
            TSFLAG=-S
            ptp_log "WARN: no PHC/hardware timestamping on $IFACE -> software timestamp fallback (KHAEN_PTP_HW_TS=auto)"
        fi
        ;;
    on)
        if ! PHC=$(detect_ptp_phc "$IFACE"); then
            ptp_log "ERROR: KHAEN_PTP_HW_TS=on but $IFACE has no hardware timestamping/PHC"
            exit 78
        fi
        TSFLAG=-H
        ptp_log "iface=$IFACE timestamping=hardware phc=$PHC conf=$KHAEN_PTP_CONF"
        ;;
    off)
        TSFLAG=-S
        ptp_log "WARN: iface=$IFACE timestamping=software forced by KHAEN_PTP_HW_TS=off (diagnostics only)"
        ;;
    *)
        ptp_log "ERROR: invalid KHAEN_PTP_HW_TS=$MODE (allowed: auto|on|off)"
        exit 64
        ;;
esac

if [ ! -d /run/khaen-ptp ]; then
    mkdir -p /run/khaen-ptp || { ptp_log "ERROR: cannot create /run/khaen-ptp"; exit 73; }
fi
PTP4L=/opt/khaen-rt-stack/ptp/current/bin/ptp4l
if [ ! -x "$PTP4L" ]; then
    ptp_log "ERROR: $PTP4L missing or not executable (bundle bin/ not installed)"
    exit 78
fi

set -- "$PTP4L" -f "$KHAEN_PTP_CONF" -i "$IFACE" "$TSFLAG" -m
if [ -n "${KHAEN_PTP_EXTRA_ARGS:-}" ]; then
    # Word splitting is intentional: extra ptp4l CLI flags come from the env file.
    # shellcheck disable=SC2086
    set -- "$@" $KHAEN_PTP_EXTRA_ARGS
fi
ptp_log "exec: $*"
exec "$@"
