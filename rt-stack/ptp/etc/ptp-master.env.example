# /etc/tspi-ptp/ptp-master.env -- TSPI PTPv2 grandmaster runtime knobs.
# Installed once by deploy/bin/09-install-ptp-gm.sh (never overwritten afterwards).
# Read by tspi-ptp-master.service / tspi-ptp-phc2sys.service through EnvironmentFile=.
#
# Interface to serve PTP on. auto = interface carrying the IPv4 default route.
# TSPI board (Rockchip RK3576 / TSPI 3M): end0 (stmmac GMAC, PHC /dev/ptp0).
TSPI_PTP_IFACE=auto
#
# PTP profile config file. The bundle installs two variants:
#   /etc/tspi-ptp/ptp4l-master.conf      UDP/IPv4 (default, lab-validated)
#   /etc/tspi-ptp/ptp4l-master-l2.conf   IEEE 802.3 (L2/Ethernet, lab-validated)
# The transport MUST match what the slaves listen to; decide per deployed ecosystem.
TSPI_PTP_CONF=/etc/tspi-ptp/ptp4l-master.conf
#
# Hardware timestamping policy:
#   auto = use the NIC PHC when hardware timestamping is advertised, otherwise software fallback
#   on   = require a PHC; fail loudly instead of silently degrading (recommended on the board)
#   off  = force software timestamping (diagnostics only; tens of us level, not for AES67 production)
TSPI_PTP_HW_TS=auto
#
# TAI-UTC offset in seconds, passed to phc2sys -O. 37 since 2017-01-01; update on a leap second.
# The PTP timescale is TAI: without this offset slaves see a fake ~37 s offset (B2 board finding).
TSPI_PTP_UTC_OFFSET=37
#
# Clock used as the GM time base. CLOCK_REALTIME lets NTP/manual UTC discipline the PHC.
TSPI_PHC2SYS_SRC=CLOCK_REALTIME
#
# Explicit PHC device override (e.g. /dev/ptp0). Empty = auto-detect from the interface.
#TSPI_PTP_PHC=
#
# Extra ptp4l command line arguments (word-split; e.g. "-l 7"). Keep empty in production.
#TSPI_PTP_EXTRA_ARGS=
