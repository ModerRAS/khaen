# TSPI IRQ 亲和持久化配置（task-192；由 04-install-release.sh 首次安装到
# /etc/tspi-rt-stack/irq-affinity.env，不覆盖既有文件）
#
# 依据：evidence/board-irq-affinity/（task-189 板端实测 20:01-20:08）
#   IRQ58 = xhci-hcd:usb1（MOTU+UMIK USB）  → CPU1（A53）
#   IRQ56 = end0 stmmac（PTP + eth-AoIP）     → CPU2（A53）
#   IRQ57 = end0 stmmac 第二队列（无流量）     → CPU3（A53）
#   迁移后 T45 plan() accepted（affinity_hash=7f1dda556b4b582b）；irqbalance 重启 ≤25s 会搬回 A72(7/3/5)。
#
# 格式：<irq>:<cpu> 空格分隔；多个 pin 用空格分隔。修改后：systemctl restart tspi-irq-affinity.service
TSPI_IRQ_PINS="58:1 56:2 57:3"
#
# T45 依赖 IRQ 映射（只读检查用；对应 scheduler bits 0/1 usb、2 ptp、3 eth）
TSPI_IRQ_T45_MAP="usb=58,ptp=56,eth=56"
#
# DSP 核集合（T45 DSP_CPUS；依赖 IRQ 不得落在这些 CPU）
TSPI_IRQ_DSP_CPUS="4,5,6,7"
#
# 开机竞态等待（B1；2026-11-20 板窗 release-v11 实测）：oneshot 在 host 之前执行，但 end0 的
# IRQ56/57 节点可能尚未注册（stmmac 枚举晚于 target），直接 apply 会 fail-closed → host 不启动。
# tspi-irq-affinity.service 的 ExecStartPre 调用 `irq-affinity-pin wait` 轮询等待这些节点：
#   * 默认 60（秒）；0 = 只检查一次、不等待；超时仍 fail-closed（不启动 host，避免错误拓扑）。
#   * 仅首次安装时落盘，不覆盖既有文件；板端已有 env 缺该键时使用脚本默认 60。
TSPI_IRQ_WAIT_SECS="60"
