# /etc/tspi-rt-stack/rt-host-nsp7.toml —— tspi-rt-host：NSP 真实 7ch 4.1.2 AES67 -> plan-arena -> MOTU
# schema: tspi-rt-host/v1（未启用/未安装；生产切换前必须先跑手动 run --config 并通过 RUNBOOK §7 验收）
# 安全前提：CueMix koTrim[0..11]=100 + kMainTrim=100（物理静音），或 MOTU/功放已物理静音；
#           tspi-rt-host 本身不控制 MOTU 静音，禁止在未静音时启动本配置。
[host]
block_size = 128              # AES67 userspace 固定 128 帧块
sample_rate = 48000           # AES67 profile 固定 48k
workers = 4
graph = "plan-arena"          # 4.1.2 校准图（n_in=8 / n_out=8）
safe_mode = "normal"

[alsa]
backend = "alsa"
io_mode = "synth"
device = "hw:UltraLitemk5,0"  # 48k: 22ch playback / 20ch capture（S24_3LE）
capture_channels = 20
playback_channels = 22
period_frames = 128
buffer_frames = 1024

[rt]
dsp_cpus = "0-3"              # 4C 板；apply_affinity=true 时需要 >= workers 个 CPU
dsp_priority = 70
io_priority = 80
irq_priority = 90
tick_freq_hz = 1000000000
apply_affinity = false        # 首次切换先 false；生产验收再 true（mlockall/SCHED_FIFO/亲和，失败 fail-closed）

[web]
bind = "127.0.0.1:8090"

[control]
url = "http://127.0.0.1:8090"

[daemon]
config = ""

[paths]
last_good = "/var/lib/tspi-rt-stack/last-good.json"
plan = "/var/lib/tspi-rt-stack/plans/plan-412-identity.bin"   # 生产用已验收 plan（本任务测试 plan 的 sha 见 RUNBOOK §6）

[run]
max_blocks = 0
duration_ms = 0

[capture]
source = "aes67"
mode = "aes67"
aes67_transport = "userspace"
# NSP 每次会话把自身 SDP 写到 <session>/observed/aes67.sdp；生产可固定一份拷贝：
#   cp <NSP session>/observed/aes67.sdp /var/lib/tspi-rt-stack/nsp-aes67.sdp
aes67_sdp = "/var/lib/tspi-rt-stack/nsp-aes67.sdp"   # 7ch L24/48k ts-refclk:localmac SMPTE2110.(41,2)
aes67_iface = "192.0.2.222"
aes67_stall_blocks = 400      # 约 2.1 s 失流门限（板端网络抖动窗口）
ptp_lock = "unlocked"         # userspace UsrvClock，非 PTP（报告 ptp:"not-wired"）
# 抖动缓冲（默认 AES67 4 ms / 8192 帧；实测 1–2 ms 更低 not_due，生产建议先默认再复核）：
#aes67_jitter_latency_us = 4000
#aes67_jitter_ring_frames = 8192
