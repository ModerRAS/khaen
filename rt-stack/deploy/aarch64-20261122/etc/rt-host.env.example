# /etc/tspi-rt-stack/rt-host.env —— T28 草案（安装时从 .example 复制；不得覆盖已存在文件）
# **T155 已冻结**：khaen-rt-host run --config 读取这些变量（覆盖 rt-host.toml）；不得改名。
# 纪律：不得在此写 CamillaDSP/旧栈路径；不得用 C 作为回退（G-no-C）。
TSPI_HOST_BLOCK=128
TSPI_HOST_RATE=48000
TSPI_HOST_WORKERS=4
# DSP_CPUS 默认 A72 全核 4-7（RK3576 CPU4-7）；2-5 混 A53/A72 实测慢 3.1×（planrt-20261119）。
# T45 依赖 IRQ 仍钉 A53（IRQ58/56/57 -> CPU1/2/3；见 irq-affinity.env）。
TSPI_HOST_DSP_CPUS=4-7
# F6/task-216：T45 调度真实写内核（mlockall + SCHED_FIFO + CPU 亲和；启动期一次，失败 fail-closed）。
# 板端真实播放验收必须 true（否则 kernel_applied=false + 持续 xrun）；无 CAP_SYS_NICE/非 Linux 调试环境改 false。
TSPI_HOST_APPLY_AFFINITY=true
# 可选：主/I-O 线程 CPU（默认自动取首个非 DSP_CPUS 的在线 CPU；板端 DSP_CPUS=4-7 -> 预期 main_cpu=0）
#TSPI_HOST_IO_CPU=0
# 可选：mlockall 开关（默认 true；仅 TSPI_HOST_APPLY_AFFINITY=true 时生效）
#TSPI_HOST_MLOCKALL=true
TSPI_HOST_MOTU_CARD_ID=UltraLitemk5
TSPI_HOST_DEVICE=hw:UltraLitemk5,0
TSPI_HOST_PLAYBACK_CHANNELS=22
TSPI_HOST_CAPTURE_CHANNELS=20
# normal|mute；mute 仅由回滚兜底 drop-in 覆盖，正常启动必须 normal
TSPI_HOST_SAFE_MODE=normal
TSPI_HOST_LAST_GOOD=/var/lib/tspi-rt-stack/last-good.json
