# /etc/tspi-rt-stack/rt-host-nsp7.env —— tspi-rt-host NSP 7ch 配置的环境覆盖（可选；覆盖 rt-host-nsp7.toml）
# 纪律：不得出现 CamillaDSP/旧栈路径；回退只用自研 last-good 或 mute（G-no-C）。
TSPI_HOST_BLOCK=128
TSPI_HOST_RATE=48000
TSPI_HOST_WORKERS=4
TSPI_HOST_DSP_CPUS=0-3
TSPI_HOST_APPLY_AFFINITY=false
TSPI_HOST_MOTU_CARD_ID=UltraLitemk5
TSPI_HOST_DEVICE=hw:UltraLitemk5,0
TSPI_HOST_PLAYBACK_CHANNELS=22
TSPI_HOST_CAPTURE_CHANNELS=20
# normal|mute（mute 仅由 safe-mute drop-in 覆盖；正常启动必须 normal）
TSPI_HOST_SAFE_MODE=normal
TSPI_HOST_LAST_GOOD=/var/lib/tspi-rt-stack/last-good.json
TSPI_HOST_ALSA_IO_MODE=synth
TSPI_HOST_CONFIG=/etc/tspi-rt-stack/rt-host-nsp7.toml
