# /etc/tspi-rt-stack/rt-host.toml —— khaen-rt-host 配置模板（schema khaen-rt-host/v1，T155 冻结）
# 安装时由 04-install-release.sh 从 .example 复制；不得覆盖已存在文件。
# 纪律：不得出现 CamillaDSP/旧栈路径；回退只用自研 last-good 或 mute（G-no-C）。
[host]
block_size = 128              # runtime 仅 64/128（core-v1 Q-11）
sample_rate = 48000           # 48000/96000
workers = 4                   # 4 生产 / 2 独立降级 profile
graph = "stereo_identity"     # stereo_identity | 2x2_offdiag（真实校准图加载 NOT_WIRED）
safe_mode = "normal"          # normal | mute（mute 仅由 90-safe-mute drop-in 覆盖）

[alsa]
# fake = 本构建唯一已接线 backend（真实 ALSA open/duplex NOT_WIRED，见 deploy/README §7）
backend = "fake"
device = "hw:UltraLitemk5,0"
capture_channels = 20
playback_channels = 22
period_frames = 128
buffer_frames = 1024

[rt]
dsp_cpus = "4-7"              # 默认 A72 全核（RK3576 CPU4-7）；2-5 混 A53/A72 实测慢 3.1×
                              # （planrt-20261119）；T45 依赖 IRQ 仍钉 A53（见 irq-affinity.env）。
dsp_priority = 70             # FIFO 初值；dsp < io <= irq
io_priority = 80
irq_priority = 90
tick_freq_hz = 1000000000     # T19 标定值；0 = 拒启
apply_affinity = false        # true = 启动期真实写 mlockall/SCHED_FIFO/亲和（F6/task-216；失败 fail-closed）；
                              # 板端播放验收用 EnvironmentFile TSPI_HOST_APPLY_AFFINITY=true 覆盖（无需改本行）

[web]
bind = "127.0.0.1:8090"       # host 只记录/探测；Web 由 tspi-rt-daemon unit 提供

[control]
url = "http://127.0.0.1:8090"

[daemon]
# 非空 = 单进程 dev/验证模式：run 会拉起同目录 tspi-rt-daemon 并探测端口（deploy 用两 unit，保持空）
config = ""

[paths]
last_good = "/var/lib/tspi-rt-stack/last-good.json"

[run]
max_blocks = 0                # 0 = 直到 SIGINT/SIGTERM（daemon 模式）
duration_ms = 0               # 0 = 不限时；>0 到点优雅退出
