# khaen-rt-host-nsp7.service —— 常驻服务：NSP 真实 7ch 4.1.2 AES67 -> plan-arena DSP -> MOTU
#
# 状态（2026-11-22 aes67-daemon 任务）：安装并验证；与旧 khaen-rt-host.service 互斥（Conflicts）。
# 唯一 ALSA owner + 唯一 5004 接收者：启动前必须已停 standalone aes67-rx supervisor。
# 安全：本 unit 不控制 MOTU 静音。前提 = CueMix koTrim[0..11]=100 + kMainTrim=100。
# NSP-first：ExecStart 是 nsp7-wait-stream.sh，等 udp/5004 的 NSP RTP 出现后才 exec host。
# 主机二进制：/usr/local/lib/khaen-rt-stack/f510ed64/khaen-rt-host
#   sha256 f510ed64ecb1ec06ff02bccf237236d6e543f10885f13460359abe8c2e7e8ce6（task-284 修复版）
#   /opt/khaen-rt-stack/current/bin/khaen-rt-host (775bdb23…) 未替换：它早于 AES67 userspace/ABI v2 消费路径。
[Unit]
Description=KHAEN RT host - NSP 7ch AES67 -> plan-arena DSP -> MOTU (single ALSA owner, silent-safe)
Documentation=file:///opt/khaen-rt-stack/current/README.deploy.md
After=network-online.target khaen-irq-affinity.service khaen-rt-host.service
Wants=network-online.target
Requires=khaen-irq-affinity.service
PartOf=khaen-rt-stack.target
# 与旧 host unit 互斥：同一时刻只允许一个 ALSA owner
Conflicts=khaen-rt-host.service
# 允许无限次自动重启：NSP 会话中断/时钟漂移 fail-closed 后由 wrapper 重新等流再起
StartLimitIntervalSec=0
# 旧 C/旧编排入口未清理时拒绝启动（防止双音频 owner）
ConditionPathExists=!/run/khaen/camilladsp.yml
ConditionPathExists=!/etc/khaen/last-mode
# 前置检查：配置/ SDP / plan / 二进制必须存在（缺失时 unit 不空跑）
ConditionPathExists=/etc/khaen-rt-stack/rt-host-nsp7.toml
ConditionPathExists=/var/lib/khaen-rt-stack/nsp-aes67.sdp
ConditionPathExists=/var/lib/khaen-rt-stack/plans/plan-412-identity.bin
ConditionPathExists=/usr/local/lib/khaen-rt-stack/f510ed64/khaen-rt-host

[Service]
Type=simple
User=root
Environment=KHAEN_HOST_CONFIG=/etc/khaen-rt-stack/rt-host-nsp7.toml
Environment=KHAEN_HOST_BIN=/usr/local/lib/khaen-rt-stack/f510ed64/khaen-rt-host
Environment=KHAEN_AES67_IFACE=enp2s0
Environment=KHAEN_AES67_PORT=5004
ExecStart=/usr/local/lib/khaen-rt-stack/nsp7-wait-stream.sh
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
RuntimeDirectory=khaen-rt-stack
StateDirectory=khaen-rt-stack
LogsDirectory=khaen-rt-stack
DeviceAllow=char-alsa rw
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=false
ReadWritePaths=/run/khaen-rt-stack /var/lib/khaen-rt-stack /var/log/khaen-rt-stack
LimitRTPRIO=99
LimitMEMLOCK=infinity
# 运行期 JSON 报告按次追加（host 每次退出写一份 JSON；evidence 直接取该文件）
StandardOutput=append:/var/log/khaen-rt-stack/host-nsp7-run.jsonl
StandardError=append:/var/log/khaen-rt-stack/host-nsp7-run.err

[Install]
WantedBy=khaen-rt-stack.target
