[Unit]
Description=khaen MOTU 48k keeper (silent 1s, forbids 192k idle)
After=sound.target
Before=khaen-rt-host.service
ConditionPathExists=/proc/asound/cards

[Service]
Type=oneshot
ExecStart=/usr/local/lib/khaen/motu-48k-keeper
TimeoutStartSec=20
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
