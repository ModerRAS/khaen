# tspi MOTU 速率守护开关（由 /usr/local/lib/tspi/motu-48k-keeper 读取）
# 默认 0：只读观测 + 告警。CueMix 写 kSampleRate 是否被 UltraLite-mk5 接受 = NOT_YET_PROVEN，
# 必须在白天窗口做一次受控探针（读->写->回读，全程 ALSA 空闲）证实后才允许置 1。
WRITE_BACK=0
# MOTU CueMix WS：板端 USB 网卡 enx0001f2fe7e6f = 169.254.111.200/16，设备 = 169.254.111.126
WS_HOST=169.254.111.126
WS_PORT=1280
# 允许的设备采样率（逗号分隔）。44.1 必须允许：光纤源常为 44.1 kHz，设备若固定 48k 会失锁 -> 高频爆音。
ALLOWED_RATES=44100,48000
# 需要纠偏（越界）时的目标速率
PREFERRED_RATE=48000
# 说明：176400/192000 永远不允许（用户硬禁）。

# follow = device rate tracks digital source (44.1/48/88.2/96, bit-perfect, no resampling); fixed = correct only when out of ALLOWED_RATES
RATE_MODE=follow
