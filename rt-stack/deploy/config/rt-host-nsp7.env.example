# /etc/khaen-rt-stack/rt-host-nsp7.env —— khaen-rt-host NSP 7ch 配置的环境覆盖（可选；覆盖 rt-host-nsp7.toml）
# 纪律：不得出现 CamillaDSP/旧栈路径；回退只用自研 last-good 或 mute（G-no-C）。
KHAEN_HOST_BLOCK=128
KHAEN_HOST_RATE=48000
KHAEN_HOST_WORKERS=4
KHAEN_HOST_DSP_CPUS=0-3
KHAEN_HOST_APPLY_AFFINITY=false
KHAEN_HOST_MOTU_CARD_ID=UltraLitemk5
KHAEN_HOST_DEVICE=hw:UltraLitemk5,0
KHAEN_HOST_PLAYBACK_CHANNELS=22
KHAEN_HOST_CAPTURE_CHANNELS=20
# normal|mute（mute 仅由 safe-mute drop-in 覆盖；正常启动必须 normal）
KHAEN_HOST_SAFE_MODE=normal
KHAEN_HOST_LAST_GOOD=/var/lib/khaen-rt-stack/last-good.json
KHAEN_HOST_ALSA_IO_MODE=synth
KHAEN_HOST_CONFIG=/etc/khaen-rt-stack/rt-host-nsp7.toml
# T239-crackle（userspace AES67 hold/内部重锚/看门狗；等价 toml 键，二者择一即可）
#KHAEN_HOST_CAPTURE_AES67_STAY_ON_STREAM_END=true
#KHAEN_HOST_CAPTURE_AES67_SILENCE_HOLD_MS=80
#KHAEN_HOST_CAPTURE_AES67_STALL_FAIL_CLOSE_MS=10000
#KHAEN_HOST_CAPTURE_AES67_REANCHOR_WATCHDOG=true
# task-320（可选）：AES67/组播监听面（等价 toml 键；二者择一即可）
#KHAEN_HOST_CAPTURE_AES67_IFACE=192.0.2.222          # IPv4/网卡名；多接口用逗号分隔
#KHAEN_HOST_CAPTURE_AES67_GROUP_ALLOW=239.69.16.146     # 组播组白名单（SDP 组不在列表 → fail-closed）
#KHAEN_HOST_CAPTURE_AES67_SOURCE_ALLOW=192.0.2.0/24  # RTP 来源白名单（IPv4/CIDR）
