# /etc/tspi-rt-stack/rt-daemon.env —— T28 草案（安装时从 .example 复制；不得覆盖已存在文件）
# **T155 已冻结**：tspi-rt-daemon serve --config 读取这些变量（覆盖 rt-daemon.toml）；不得改名。
TSPI_DAEMON_LISTEN=0.0.0.0:80
TSPI_DAEMON_STATE_DIR=/var/lib/tspi-rt-stack
TSPI_DAEMON_AUTH_FILE=/etc/tspi-rt-stack/daemon-auth.json
TSPI_DAEMON_JOB_DIR=/var/lib/tspi-rt-stack/calibration
TSPI_RT_HOST_CONTROL_URL=http://127.0.0.1:8090
