# /etc/khaen-rt-stack/rt-daemon.env —— T28 草案（安装时从 .example 复制；不得覆盖已存在文件）
# **T155 已冻结**：khaen-rt-daemon serve --config 读取这些变量（覆盖 rt-daemon.toml）；不得改名。
KHAEN_DAEMON_LISTEN=0.0.0.0:80
KHAEN_DAEMON_STATE_DIR=/var/lib/khaen-rt-stack
KHAEN_DAEMON_AUTH_FILE=/etc/khaen-rt-stack/daemon-auth.json
KHAEN_DAEMON_JOB_DIR=/var/lib/khaen-rt-stack/calibration
KHAEN_RT_HOST_CONTROL_URL=http://127.0.0.1:8090
