# /etc/tspi-ptp/ptp4l-master.conf -- TSPI PTPv2 grandmaster, UDP/IPv4 profile (default).
# Basis: AES67 interop profile (IEEE 1588-2008 default profile, TAI timescale, E2E delay).
#   domain 0, announce 1/s, sync 4/s (logSyncInterval -2), delay req 1/s, DSCP 46, UDP TTL 16.
# linuxptp config parser has no inline-comment support: keep every comment on its own line.
# The interface is selected by the wrapper with "-i <iface>" (do NOT add [ethX] sections).
# CLI options from tspi-ptp-master-start override the timestamping mode (hardware/software).
#
# Check: pmc -s /run/tspi-ptp/ptp4l.uds -u -b 0 'GET PORT_DATA_SET'
# Live check of the PHC:   phc_ctl /dev/ptp0 get   (should be ~37 s ahead of UTC system time)

[global]
twoStepFlag                 1
clientOnly                  0
serverOnly                  1
domainNumber                0
priority1                   0
priority2                   0
clockClass                  248
clockAccuracy               0xFE
offsetScaledLogVariance     0xFFFF
clock_type                  OC
network_transport           UDPv4
delay_mechanism             E2E
time_stamping               hardware
logAnnounceInterval         0
logSyncInterval             -2
logMinDelayReqInterval      0
announceReceiptTimeout      3
syncReceiptTimeout          0
transportSpecific           0x0
ptp_dst_mac                 01:1B:19:00:00:00
udp_ttl                     16
dscp_event                  46
dscp_general                46
socket_priority             0
tx_timestamp_timeout        10
free_running                0
kernel_leap                 1
uds_address                 /run/tspi-ptp/ptp4l.uds
