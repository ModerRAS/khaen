fn input_with_overlay<'a>(
    fx: &'a Fixture,
    overlay: &'a OverlayDacBinding,
) -> ArtifactInput<'a> {
    ArtifactInput::new(
        &fx.target,
        ArtifactSolution::Regularized(&fx.regularize),
        overlay,
        fx.tool.clone(),
        fx.provenance.clone(),
    )
    .with_post(&fx.baseline)
    .with_holdout(&fx.holdout)
}

#[test]
fn t54_artifact_overlay_mismatch_rejected() {
    let fx = fixture();

    // 缂?SUB1銆?    let missing = OverlayDacBinding::new(
        P1_LAYOUT_4_1_2,
        sha256_hex(b"t54-overlay-missing"),
        8,
        vec![
            OverlayRole::new("FL", vec![0]).unwrap(),
            OverlayRole::new("FR", vec![1]).unwrap(),
            OverlayRole::new("SL", vec![2]).unwrap(),
            OverlayRole::new("SR", vec![3]).unwrap(),
            OverlayRole::new("HFL", vec![4]).unwrap(),
            OverlayRole::new("HFR", vec![5]).unwrap(),
        ],
    )
    .unwrap();
    let error = build_artifact(&input_with_overlay(&fx, &missing)).expect_err("missing SUB1 must be rejected");
    assert_eq!(error.kind(), ArtifactErrorKind::Overlay);

    // overlay 棣栨Ы浣嶄笌 participants DAC 涓嶇锛團L 澹版槑涓?2锛夈�?    let swapped = OverlayDacBinding::new(
        P1_LAYOUT_4_1_2,
        sha256_hex(b"t54-overlay-swapped"),
        8,
        vec![
            OverlayRole::new("FL", vec![2]).unwrap(),
            OverlayRole::new("FR", vec![1]).unwrap(),
            OverlayRole::new("SL", vec![0]).unwrap(),
            OverlayRole::new("SR", vec![3]).unwrap(),
            OverlayRole::new("HFL", vec![4]).unwrap(),
            OverlayRole::new("HFR", vec![5]).unwrap(),
            OverlayRole::new("SUB1", vec![7]).unwrap(),
        ],
    )
    .unwrap();
    let error = build_artifact(&input_with_overlay(&fx, &swapped)).expect_err("swapped DAC must be rejected");
    assert_eq!(error.kind(), ArtifactErrorKind::Overlay);

    // ch6 闈炵┖锛堥澶?AUX 鍗?6锛?> 4.1.2 蹇呴』鎷掔粷锛屼笉闈欓粯鎹㈡槧灏勩�?    let ch6_used = OverlayDacBinding::new(
        P1_LAYOUT_4_1_2,
        sha256_hex(b"t54-overlay-ch6"),
        8,
        vec![
            OverlayRole::new("FL", vec![0]).unwrap(),
            OverlayRole::new("FR", vec![1]).unwrap(),
            OverlayRole::new("SL", vec![2]).unwrap(),
            OverlayRole::new("SR", vec![3]).unwrap(),
            OverlayRole::new("HFL", vec![4]).unwrap(),
            OverlayRole::new("HFR", vec![5]).unwrap(),
            OverlayRole::new("SUB1", vec![7]).unwrap(),
            OverlayRole::new("AUX", vec![6]).unwrap(),
        ],
    )
    .unwrap();
    let error = build_artifact(&input_with_overlay(&fx, &ch6_used)).expect_err("ch6 used must be rejected");
    assert_eq!(error.kind(), ArtifactErrorKind::Overlay);

    // layout 涓嶄竴鑷淬�?    let wrong_layout = OverlayDacBinding::new(
        "5.3.2",
        sha256_hex(b"t54-overlay-layout"),
        8,
        vec![
            OverlayRole::new("FL", vec![0]).unwrap(),
            OverlayRole::new("FR", vec![1]).unwrap(),
            OverlayRole::new("SL", vec![2]).unwrap(),
            OverlayRole::new("SR", vec![3]).unwrap(),
            OverlayRole::new("HFL", vec![4]).unwrap(),
            OverlayRole::new("HFR", vec![5]).unwrap(),
            OverlayRole::new("SUB1", vec![7]).unwrap(),
        ],
    )
    .unwrap();
    let error = build_artifact(&input_with_overlay(&fx, &wrong_layout)).expect_err("layout mismatch must be rejected");
    assert_eq!(error.kind(), ArtifactErrorKind::Layout);

    // overlay source sha256 闈炴硶锛堟瀯閫犳湡鎷掔粷锛夈�?    let bad = OverlayDacBinding::new(
        P1_LAYOUT_4_1_2,
        "not-a-sha256",
        8,
        vec![OverlayRole::new("FL", vec![0]).unwrap()],
    )
    .expect_err("invalid overlay sha must be rejected");
    assert_eq!(bad.kind(), ArtifactErrorKind::Overlay);
}

