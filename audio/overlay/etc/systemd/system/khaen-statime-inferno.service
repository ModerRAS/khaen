[Unit]
Description=khaen-audio: Statime PTPv1 follower (Inferno/Dante)
Documentation=file:///etc/statime/inferno-ptpv1.toml
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/khaen/active-dante
PartOf=khaen-audio.target

[Service]
Type=simple
ExecStart=/usr/local/bin/statime -c /run/khaen/statime.toml
Restart=on-failure
RestartSec=2

# RT 权限硬门槛（Debian 默认 ulimit -r=0）
LimitRTPRIO=99
LimitMEMLOCK=infinity
Nice=-10

# statime 需要：绑 319/320、硬件时间戳 raw socket、调整时钟、mlock
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_TIME CAP_SYS_NICE CAP_IPC_LOCK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=no
ReadWritePaths=/run/khaen /tmp
ProtectClock=no
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
