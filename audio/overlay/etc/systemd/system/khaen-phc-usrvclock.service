[Unit]
Description=khaen-audio: PHC -> usrvclock bridge (B2 板端 GM 的 Inferno 媒体时钟)
Documentation=file:///usr/local/lib/khaen/phc-usrvclock
After=khaen-phc2sys.service
ConditionPathExists=/run/khaen/active-aes67-master
# statime（Dante/PTPv1）与 B2 GM 时钟链互斥：两者都占用 /tmp/ptp-usrvclock
Conflicts=khaen-statime-inferno.service
PartOf=khaen-audio.target

[Service]
Type=simple
# KHAEN_IFACE / KHAEN_PHC_DEV 来自镜像默认值；socket 路径固定给 Inferno 的 INFERNO_CLOCK_PATH
EnvironmentFile=-/etc/default/khaen-audio
Environment=KHAEN_USRVCLOCK_SOCKET=/tmp/ptp-usrvclock
ExecStart=/usr/local/lib/khaen/phc-usrvclock
Restart=on-failure
RestartSec=2
# socket 必须与 khaen-camilladsp 共享（Inferno CLOCK_PATH=/tmp/ptp-usrvclock），不能 PrivateTmp
PrivateTmp=no
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/tmp
ProtectClock=no
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
