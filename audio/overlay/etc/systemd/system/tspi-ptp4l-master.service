[Unit]
Description=tspi-audio: ptp4l PTPv2 grandmaster (B2 板端 GM；tspi-mode b2)
Documentation=file:///etc/ptp4l-master-aes67.conf
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/tspi/active-aes67-master
# 互斥（B2 只有本条 + phc2sys 时钟链）：daemon/LKM 是 PTP slave-only 且 LKM 会在
# PRE_ROUTING 截走 PTP 包；statime 会改写系统时钟，与 phc2sys 抢时钟。
Conflicts=tspi-statime-inferno.service tspi-aes67-daemon.service tspi-ravenna-lkm.service
PartOf=tspi-audio.target

[Service]
Type=simple
EnvironmentFile=/etc/default/tspi-audio
ExecStart=/usr/sbin/ptp4l -H -i ${TSPI_IFACE} -f /etc/ptp4l-master-aes67.conf -m
Restart=on-failure
RestartSec=2
LimitRTPRIO=99
LimitMEMLOCK=infinity
Nice=-10
# CAP_NET_ADMIN: SIOCSHWTSTAMP/SIOCGHWTSTAMP on end0 (hardware timestamping)
# RuntimeDirectory: writable dir for the ptp4l UDS (uds_address=/run/ptp4l/uds)
RuntimeDirectory=ptp4l
RuntimeDirectoryMode=0755
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_TIME CAP_SYS_NICE CAP_IPC_LOCK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=no
# AF_NETLINK: ptp4l needs it for link/interface monitoring (getifaddrs)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
