[Unit]
Description=tspi-audio: AES67 Linux daemon (RAVENNA/AES67, PTPv2 slave)
Documentation=file:///etc/aes67-daemon/daemon.conf
After=network-online.target tspi-ravenna-lkm.service
Wants=network-online.target tspi-ravenna-lkm.service
ConditionPathExists=/run/tspi/active-aes67
PartOf=tspi-audio.target

[Service]
Type=notify
WatchdogSec=10
TimeoutStartSec=60
ExecStart=/usr/local/bin/aes67-daemon -c /run/tspi/aes67-daemon.conf
Restart=on-failure
RestartSec=2

LimitRTPRIO=99
LimitMEMLOCK=infinity
Nice=-10

# 需要 netlink 与内核模块通信、绑 PTP/RTP 端口、读 /dev/snd
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_NICE CAP_IPC_LOCK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/tspi /var/lib/aes67-daemon /tmp
DeviceAllow=/dev/snd/* rw
ProtectClock=no
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
