#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""khaen-channelmap v2 — 通用布局/remap/动态通道的 DSP 路由与校准配置工具。

不写死布局、输入/输出通道数（5.3.2/16/22 都只是 preset 值）。
子命令：probe | validate | print | render | apply | rollback | profiles | save-profile | load-profile | export | import
退出码：0 ok；2 schema/用法；3 取值/校验；4 渲染/camilladsp --check；5 apply/重启；9 回滚。
版本：2.1.0（2026-11-17 起禁 192k：仅 44.1/48/88.2/96k，生产默认 48k）。
契约文档：configs/channelmap.md
"""
import argparse
import copy
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import time

try:
    import yaml
except ImportError:  # pragma: no cover
    sys.stderr.write("khaen-channelmap: 需要 python3-yaml（Debian 包 python3-yaml）\n")
    sys.exit(2)

ACTIVE = os.environ.get("KHAEN_CHANNELMAP_ACTIVE", "/etc/khaen-audio/channelmap.yml")
PRESETS = os.environ.get("KHAEN_CHANNELMAP_PRESETS", "/etc/khaen-audio/layout-presets.yml")
PROFILES_DIR = os.environ.get("KHAEN_CHANNELMAP_PROFILES_DIR", "/etc/khaen-audio/profiles")
VAR_DIR = os.environ.get("KHAEN_CHANNELMAP_VAR_DIR", "/var/lib/khaen/channelmap")
RUN_DIR = os.environ.get("KHAEN_CHANNELMAP_RUN_DIR", "/run/khaen")
CAMILLA_YML = os.path.join(RUN_DIR, "camilladsp.yml")
STATE_JSON = os.path.join(RUN_DIR, "channelmap-state.json")
UNIT = "khaen-camilladsp.service"
TOOL_VERSION = "2.1.0"

# 采样率白名单（用户硬约束 2026-11-17：禁 192k；生产只用 48/96k，默认 48k）。
# 176400/192000 一律显式拒绝（稳定错误码），不再保留 192k 的 altset 通道映射。
SUPPORTED_SAMPLE_RATES = (44100, 48000, 88200, 96000)
FORBIDDEN_SAMPLE_RATES = (176400, 192000)
ERR_FS_192K = "E_CM_FS_192K_DISABLED"
ERR_FS_UNSUPPORTED = "E_CM_FS_UNSUPPORTED"
ERR_FS_INVALID = "E_CM_FS_INVALID"
ERR_FIR_FS_192K = "E_CM_FIR_FS_192K_DISABLED"


class SampleRateError(ValueError):
    """采样率不在白名单（禁 192k）。main() 统一打印 ERROR [value] 并返回 rc=3。"""


def _rates_text():
    return "/".join(str(int(x)) for x in SUPPORTED_SAMPLE_RATES)


def validate_sample_rate(fs):
    """采样率白名单（禁 192k）：返回 int；违规抛 SampleRateError（稳定错误码）。"""
    try:
        fs = int(fs or 48000)
    except (TypeError, ValueError):
        raise SampleRateError("采样率非法：%r（仅支持 %s）[%s]"
                              % (fs, _rates_text(), ERR_FS_INVALID))
    if fs in FORBIDDEN_SAMPLE_RATES:
        raise SampleRateError("采样率 %d 已禁用：禁止 192k（176400/192000），仅支持 %s [%s]"
                              % (fs, _rates_text(), ERR_FS_192K))
    if fs not in SUPPORTED_SAMPLE_RATES:
        raise SampleRateError("采样率不支持：%r（仅支持 %s）[%s]"
                              % (fs, _rates_text(), ERR_FS_UNSUPPORTED))
    return fs


TOP_KEYS = {"schema", "version", "profile", "input", "output", "remap", "bass_management"}
PROFILE_KEYS = {"name", "description"}
INPUT_KEYS = {"layout", "channels", "presets", "probe_order"}
OUTPUT_KEYS = {"device", "channels", "layout", "roles"}
REMAP_KEYS = {"preset", "routes", "drop_unused", "silence_unmapped"}
ROUTE_KEYS = {"src", "dest", "gain_db", "mute", "mode"}
SRC_KEYS = {"source", "src", "gain_db", "inverted", "mute"}
ROLE_KEYS = {"id", "label", "enabled", "mute", "outputs", "sources", "gain_db", "delay_ms", "polarity",
             "highpass", "lowpass", "peq", "fir", "link_to"}
XO_KEYS = {"freq", "order", "type"}
PEQ_KEYS = {"freq", "q", "gain_db", "type"}
# peq[].type 白名单；缺省 peaking。shelf 的 q 是 RBJ slope S（见 CONTRACT §4.2），
# 渲染到 CamillaDSP 时 slope = 12*q（dB/oct），不是 Q。
# 裁决 5：peaking 的 q ∈ [0.1, 10]；shelf 的 S ∈ [0.1, 1.0]（slope=12S 不得超过 12）。
PEQ_TYPES = ("peaking", "low_shelf", "high_shelf")
FIR_KEYS = {"path", "samplerate", "channel"}
BM_KEYS = {"enabled", "lfe_role", "lfe_to", "lfe_gain_db", "redirect",
           "mains_highpass_hz", "mains_highpass_order", "sub_lowpass_hz",
           "sub_lowpass_order", "sub_gain_db"}
REDIRECT_KEYS = {"enabled", "sources", "targets", "gain_db"}
PRESET_TOP = {"schema", "input_layouts", "output_layouts", "remap_presets"}
INPUT_LAYOUT_KEYS = {"label", "description", "channels", "streams", "roles"}
INPUT_ROLE_KEYS = {"id", "label", "channel", "stream"}
OUTPUT_LAYOUT_KEYS = {"label", "description", "roles"}
OUTPUT_ROLE_KEYS = {"id", "label", "outputs", "enabled"}
REMAP_PRESET_KEYS = {"label", "description", "input", "output", "routes"}

ROLE_DEFAULTS = {"enabled": True, "mute": False, "gain_db": 0.0, "delay_ms": 0.0,
                 "polarity": "normal", "highpass": None, "lowpass": None,
                 "peq": [], "fir": None, "link_to": None, "_fir": None}
ROUTE_MODES = ("direct", "fold", "duplicate", "mix", "drop", "silence")
# FIR 文件名元数据探测（只读）：命中 192k 不是可接受采样率，_resolve_fir 会显式拒绝（禁 192k）。
FIR_FS_RE = re.compile(r"(?:^|[^0-9])(48|96|192)k(?:[^0-9]|$)", re.IGNORECASE)


def err(lst, kind, path, msg):
    lst.append({"kind": kind, "path": path, "msg": msg})


def is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def check_keys(obj, allowed, path, errors):
    if not isinstance(obj, dict):
        err(errors, "schema", path, "必须是 mapping")
        return False
    for k in obj:
        if k not in allowed:
            err(errors, "schema", path + "." + str(k), "未知字段（v2 严格校验，请检查拼写）")
    return True


def num_range(v, lo, hi, path, errors):
    if not is_num(v):
        err(errors, "value", path, "必须是数字")
        return False
    if v < lo or v > hi:
        err(errors, "value", path, "取值 %s 超出 [%s, %s]" % (v, lo, hi))
        return False
    return True


def load_yaml(path):
    with open(path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def load_presets(path=None):
    path = path or PRESETS
    doc = load_yaml(path)
    if not isinstance(doc, dict) or doc.get("schema") != "khaen-layout-presets/v2":
        raise ValueError("layout-presets 必须是 khaen-layout-presets/v2：%s" % path)
    return {"input_layouts": doc.get("input_layouts") or {},
            "output_layouts": doc.get("output_layouts") or {},
            "remap_presets": doc.get("remap_presets") or {},
            "path": path}


def _resolve_fir(fir, base_dir):
    if fir is None:
        return None, None, None
    if isinstance(fir, str):
        path, fsr = fir, None
    elif isinstance(fir, dict):
        for k in fir:
            if k not in FIR_KEYS:
                return None, None, "FIR 未知字段 %s" % k
        path, fsr = fir.get("path"), fir.get("samplerate")
    else:
        return None, None, "FIR 必须是 null/字符串/对象"
    if not isinstance(path, str) or not path:
        return None, None, "FIR path 必须是非空字符串"
    if not os.path.isabs(path):
        path = os.path.join(base_dir, path)
    if fsr is None:
        for side in (path + ".meta.json", path + ".meta.yaml"):
            if os.path.isfile(side):
                try:
                    if side.endswith(".json"):
                        fsr = json.load(open(side, encoding="utf-8")).get("samplerate")
                    else:
                        fsr = (load_yaml(side) or {}).get("samplerate")
                    if fsr:
                        break
                except Exception:
                    pass
        if fsr is None:
            m = FIR_FS_RE.search(os.path.basename(path))
            if m:
                fsr = int(m.group(1)) * 1000
    if fsr is None:
        return path, None, "FIR 缺少采样率元数据（{path,samplerate}/sidecar/文件名 *_48k）"
    if not is_num(fsr) or int(fsr) <= 0:
        return path, None, "FIR samplerate 非法"
    fsr = int(fsr)
    if fsr in FORBIDDEN_SAMPLE_RATES:
        return path, None, ("FIR 采样率 %d 已禁用：禁止 192k（176400/192000），仅支持 %s [%s]"
                            % (fsr, _rates_text(), ERR_FIR_FS_192K))
    return path, fsr, None


# ---------------- 解析 + 校验（布局/remap/角色/低音管理） ----------------
def resolve_and_validate(doc, presets, fs=48000, capture_channels=None, playback_channels=None,
                         check_files=False, allow_fs_mismatch=False, base_dir=None,
                         require_channels=True):
    errors, warnings = [], []
    fs = validate_sample_rate(fs)
    strict_fs = min(48000, fs)
    if not isinstance(doc, dict):
        err(errors, "schema", "$", "顶层必须是 mapping")
        return False, errors, warnings, None
    check_keys(doc, TOP_KEYS, "$", errors)
    if doc.get("schema") != "khaen-channelmap/v2":
        err(errors, "schema", "schema", "必须是 khaen-channelmap/v2")
    if doc.get("version") != 2:
        err(errors, "schema", "version", "必须是 2")
    base_dir = base_dir or os.path.dirname(os.path.abspath(ACTIVE))
    prof = doc.get("profile") or {}
    check_keys(prof, PROFILE_KEYS, "profile", errors)
    if not isinstance(prof.get("name"), str) or not prof.get("name"):
        err(errors, "value", "profile.name", "必须是非空字符串")

    # ---------- 输入布局 ----------
    inp = doc.get("input") or {}
    check_keys(inp, INPUT_KEYS, "input", errors)
    local_in = inp.get("presets") or {}
    if not isinstance(local_in, dict):
        err(errors, "schema", "input.presets", "必须是 mapping")
        local_in = {}
    input_layouts = dict(presets["input_layouts"] or {})
    for k, v in local_in.items():
        input_layouts[k] = v
    in_layout_id = inp.get("layout")
    in_layout = None
    if not isinstance(in_layout_id, str) or in_layout_id not in input_layouts:
        err(errors, "value", "input.layout", "必须是已定义输入布局（内置或 input.presets）")
        in_roles = []
    else:
        in_layout = input_layouts[in_layout_id] or {}
        if not isinstance(in_layout, dict):
            err(errors, "schema", "input.layouts.%s" % in_layout_id, "必须是 mapping")
            in_layout = {}
        check_keys(in_layout, INPUT_LAYOUT_KEYS, "input.layouts.%s" % in_layout_id, errors)
        in_roles = in_layout.get("roles") or []
        if not isinstance(in_roles, list) or not in_roles:
            err(errors, "value", "input.layouts.%s.roles" % in_layout_id, "必须是非空 roles 数组")
            in_roles = []
    # 输入通道数解析：参数 > input.channels > layout.channels
    cap = capture_channels if isinstance(capture_channels, int) and capture_channels > 0 else None
    if cap is None and isinstance(inp.get("channels"), int) and not isinstance(inp.get("channels"), bool):
        cap = inp.get("channels")
    if cap is None and in_layout is not None:
        lv = in_layout.get("channels")
        if isinstance(lv, int) and not isinstance(lv, bool) and lv > 0:
            cap = lv
        if cap is None:
            sv0 = in_layout.get("streams")
            if isinstance(sv0, list) and sv0 and all(isinstance(x, int) and not isinstance(x, bool) and x > 0 for x in sv0):
                cap = sum(sv0)
    if cap is None:
        if require_channels:
            err(errors, "value", "input.channels", "auto 未解析：需探测/传入 --capture-channels 或 WebUI 选输入通道数")
        else:
            warnings.append({"kind": "warn", "path": "input.channels", "msg": "channels=auto 待运行时解析（未提供 capture-channels）"})
    elif cap < 1 or cap > 64:
        err(errors, "value", "input.channels", "必须在 1..64")
        cap = None
    in_role_ch = {}
    streams = []
    if in_layout is not None:
        sv = in_layout.get("streams")
        if isinstance(sv, list) and sv:
            for i, n in enumerate(sv):
                if not isinstance(n, int) or isinstance(n, bool) or n <= 0:
                    err(errors, "value", "input.layouts.%s.streams[%d]" % (in_layout_id, i), "必须是正整数（每 flow 通道数）")
                else:
                    streams.append(n)
            if cap is None and streams:
                cap = sum(streams)
                warnings.append({"kind": "warn", "path": "input.streams", "msg": "按 streams 合计 %d 声道（SDP 只给每流通道数，角色需用户选）" % cap})
    for i, r in enumerate(in_roles):
        pth = "input.layouts.%s.roles[%d]" % (in_layout_id, i)
        if not isinstance(r, dict):
            err(errors, "schema", pth, "必须是 mapping")
            continue
        check_keys(r, INPUT_ROLE_KEYS, pth, errors)
        rid = r.get("id")
        if not isinstance(rid, str) or not rid:
            err(errors, "value", pth + ".id", "必须是非空字符串")
            continue
        if rid in in_role_ch:
            err(errors, "value", pth + ".id", "输入角色 id 重复：%s" % rid)
            continue
        ch = r.get("channel")
        st = r.get("stream", 0)
        if not isinstance(st, int) or isinstance(st, bool) or st < 0:
            err(errors, "value", pth + ".stream", "必须是非负整数")
            continue
        if streams:
            if st >= len(streams):
                err(errors, "value", pth + ".stream", "stream %d >= streams 数 %d" % (st, len(streams)))
                continue
            if not isinstance(ch, int) or isinstance(ch, bool) or ch < 0 or ch >= streams[st]:
                err(errors, "value", pth + ".channel", "flow %d 内通道必须 0..%d" % (st, streams[st] - 1))
                continue
            idx = sum(streams[:st]) + ch
        else:
            idx = ch
        if not isinstance(idx, int) or isinstance(idx, bool) or idx < 0:
            err(errors, "value", pth + ".channel", "必须是非负整数")
        elif cap is not None and idx >= cap:
            err(errors, "value", pth + ".channel", "全局通道 %d >= 实测输入通道数 %d（输入布局/流与设备不匹配）" % (idx, cap))
        else:
            in_role_ch[rid] = idx

    # ---------- 输出布局 ----------
    out = doc.get("output") or {}
    check_keys(out, OUTPUT_KEYS, "output", errors)
    pb = playback_channels if isinstance(playback_channels, int) and playback_channels > 0 else None
    if pb is None and isinstance(out.get("channels"), int) and not isinstance(out.get("channels"), bool):
        pb = out.get("channels")
    if pb is None:
        if require_channels:
            err(errors, "value", "output.channels", "auto 未解析：需探测/传入 --playback-channels 或 WebUI 选输出通道数")
        else:
            warnings.append({"kind": "warn", "path": "output.channels", "msg": "channels=auto 待运行时解析（未提供 playback-channels）"})
    out_layout_id = out.get("layout")
    out_roles_raw = out.get("roles")
    out_role_defs = []
    out_role_source = "none"
    if isinstance(out_roles_raw, list) and out_roles_raw:
        out_role_defs = out_roles_raw
        out_role_source = "explicit"
    elif isinstance(out_layout_id, str) and out_layout_id in (presets["output_layouts"] or {}):
        ol = presets["output_layouts"][out_layout_id] or {}
        out_role_defs = ol.get("roles") or []
        out_role_source = "layout:" + out_layout_id
    else:
        err(errors, "value", "output.layout", "必须是已定义输出布局 id，或提供显式 roles 列表")
    resolved_roles = {}
    used_out = {}
    for i, rd in enumerate(out_role_defs):
        pth = "output.roles[%d]" % i
        if not isinstance(rd, dict):
            err(errors, "schema", pth, "必须是 mapping")
            continue
        allowed = ROLE_KEYS | (OUTPUT_ROLE_KEYS if out_role_source != "explicit" else set())
        check_keys(rd, allowed, pth, errors)
        rid = rd.get("id")
        if not isinstance(rid, str) or not rid:
            err(errors, "value", pth + ".id", "必须是非空字符串")
            continue
        if rid in resolved_roles:
            err(errors, "value", pth + ".id", "角色 id 重复：%s" % rid)
            continue
        role = copy.deepcopy(ROLE_DEFAULTS)
        if rd.get("label") is not None:
            role["label"] = rd["label"]
        for k in ("enabled", "mute", "gain_db", "delay_ms", "polarity", "highpass", "lowpass", "peq", "fir", "link_to"):
            if k in rd and rd[k] is not None:
                role[k] = rd[k]
        if "outputs" in rd and rd["outputs"] is not None:
            ov = rd["outputs"]
            if isinstance(ov, int) and not isinstance(ov, bool):
                ov = [ov]
            if not isinstance(ov, list) or any((not isinstance(x, int)) or isinstance(x, bool) or x < 0 for x in ov):
                err(errors, "value", pth + ".outputs", "必须是 0..N 整数（或数组）")
                ov = []
        else:
            nxt = 0
            while nxt in used_out:
                nxt += 1
            ov = [nxt]
        role["outputs"] = ov
        if not isinstance(role["enabled"], bool):
            err(errors, "value", pth + ".enabled", "必须是 bool")
        if not isinstance(role["mute"], bool):
            err(errors, "value", pth + ".mute", "必须是 bool")
        if role["enabled"]:
            if not ov:
                err(errors, "value", pth + ".outputs", "enabled 角色必须至少映射一个输出通道")
            if pb is not None:
                for o in ov:
                    if o >= pb:
                        err(errors, "value", pth + ".outputs",
                            "输出通道 %d >= 实测播放通道数 %d（设备不够：禁用角色/换布局/改映射）" % (o, pb))
                    elif o in used_out:
                        err(errors, "value", pth + ".outputs", "输出通道 %d 与 %s 冲突" % (o, used_out[o]))
                    else:
                        used_out[o] = rid
        num_range(role["gain_db"], -60, 12, pth + ".gain_db", errors)
        num_range(role["delay_ms"], 0, 200, pth + ".delay_ms", errors)
        if role["polarity"] not in ("normal", "invert"):
            err(errors, "value", pth + ".polarity", "必须是 normal|invert")
        if role.get("link_to") is not None and role["link_to"] == rid:
            err(errors, "value", pth + ".link_to", "不能指向自己")
        # 分频/PEQ/FIR
        def xo(v, path):
            if v is None:
                return None
            if not isinstance(v, dict):
                err(errors, "schema", path, "null 或 {freq,order,type}")
                return None
            check_keys(v, XO_KEYS, path, errors)
            typ = v.get("type", "LinkwitzRiley")
            if typ != "LinkwitzRiley":
                err(errors, "value", path + ".type", "v2 只支持 LinkwitzRiley")
            order = v.get("order", 4)
            if order not in (2, 4, 6, 8):
                err(errors, "value", path + ".order", "必须是 2/4/6/8")
            fq = v.get("freq")
            if not is_num(fq) or fq < 20 or fq >= strict_fs / 2.0:
                err(errors, "value", path + ".freq", "必须在 [20, %s)（最严 48k 校验）" % (strict_fs / 2.0))
            return {"freq": float(fq) if is_num(fq) else None, "order": order, "type": typ}
        if "sources" in rd and rd["sources"] is not None:
            ex = rd["sources"]
            if not isinstance(ex, list):
                err(errors, "schema", pth + ".sources", "必须是数组（output-centric 路由矩阵）")
                ex = []
            norm = []
            for j, sr in enumerate(ex):
                sp = pth + ".sources[%d]" % j
                if not isinstance(sr, dict):
                    err(errors, "schema", sp, "必须是 mapping")
                    continue
                check_keys(sr, SRC_KEYS, sp, errors)
                if "source" not in sr and "src" not in sr:
                    err(errors, "value", sp, "必须含 source 或 src（输入布局中的源角色名）")
                    continue
                srcname = sr.get("source") or sr.get("src")
                if not isinstance(srcname, str) or not srcname:
                    err(errors, "value", sp + ".source", "必须是非空字符串")
                if in_layout_id and srcname not in in_role_ch:
                    err(errors, "value", sp + ".source", "未知输入源 %r（输入布局 %s）" % (srcname, in_layout_id))
                if "gain_db" in sr:
                    num_range(sr["gain_db"], -60, 12, sp + ".gain_db", errors)
                norm.append({"src": srcname, "gain_db": float(sr.get("gain_db") or 0.0),
                             "inverted": bool(sr.get("inverted") or False), "mute": bool(sr.get("mute") or False)})
            role["_explicit_sources"] = norm
        role["highpass"] = xo(role["highpass"], pth + ".highpass")
        role["lowpass"] = xo(role["lowpass"], pth + ".lowpass")
        peq = role.get("peq") or []
        if not isinstance(peq, list):
            err(errors, "schema", pth + ".peq", "必须是数组")
            peq = []
        if len(peq) > 32:
            err(errors, "value", pth + ".peq", "最多 32 条")
        peq_out = []
        for j, item in enumerate(peq[:32]):
            pp = pth + ".peq[%d]" % j
            if not isinstance(item, dict):
                err(errors, "schema", pp, "必须是 mapping")
                continue
            check_keys(item, PEQ_KEYS, pp, errors)
            fq, q, g = item.get("freq"), item.get("q"), item.get("gain_db")
            typ = item.get("type", "peaking")
            if not isinstance(typ, str) or typ not in PEQ_TYPES:
                # 未知 type = schema error（rc=2），不降级为 Peaking
                err(errors, "schema", pp + ".type",
                    "必须是 %s（缺省 peaking）" % "/".join(PEQ_TYPES))
                continue
            if not (is_num(fq) and 20 <= fq < strict_fs / 2.0):
                err(errors, "value", pp + ".freq", "必须在 [20, %s)" % (strict_fs / 2.0))
            # 裁决 5：shelf 的 q 是 RBJ slope S，CamillaDSP slope=12*S 且 check_slope 拒绝 >12。
            if typ == "peaking":
                if not (is_num(q) and 0.1 <= q <= 10):
                    err(errors, "value", pp + ".q", "必须在 [0.1, 10]")
            elif not (is_num(q) and 0.1 <= q <= 1.0):
                err(errors, "value", pp + ".q",
                    "shelf 的 q 是 RBJ slope S，必须在 [0.1,1.0]（CamillaDSP slope=12q 上限 12 dB/oct）")
            if not (is_num(g) and -24 <= g <= 24):
                err(errors, "value", pp + ".gain_db", "必须在 [-24, 24]")
            if is_num(fq) and is_num(q) and is_num(g):
                norm = {"freq": float(fq), "q": float(q), "gain_db": float(g)}
                if typ != "peaking":
                    norm["type"] = typ
                peq_out.append(norm)
        role["peq"] = peq_out
        if role.get("fir") is not None:
            p, fsf, ferr = _resolve_fir(role["fir"], base_dir)
            if ferr:
                err(errors, "value", pth + ".fir", ferr)
            else:
                if check_files and not os.path.isfile(p):
                    err(errors, "value", pth + ".fir", "FIR 文件不存在：%s" % p)
                elif not check_files and not os.path.isfile(p):
                    warnings.append({"kind": "warn", "path": pth + ".fir", "msg": "FIR 文件当前不存在：%s" % p})
                if fsf != int(fs):
                    m = "FIR 采样率 %d != 当前模式 %d（按模式分 profile 或 --allow-fir-fs-mismatch）" % (fsf, int(fs))
                    if allow_fs_mismatch:
                        warnings.append({"kind": "warn", "path": pth + ".fir", "msg": m})
                    else:
                        err(errors, "value", pth + ".fir", m)
                role["_fir"] = {"path": p, "samplerate": fsf,
                                "channel": (role["fir"].get("channel") if isinstance(role["fir"], dict) else None)}
        resolved_roles[rid] = role

    # ---------- remap ----------
    rmp = doc.get("remap") or {}
    check_keys(rmp, REMAP_KEYS, "remap", errors)
    routes = []
    rmp_preset = rmp.get("preset")
    if rmp_preset is not None:
        rp = (presets["remap_presets"] or {}).get(rmp_preset)
        if not isinstance(rp, dict):
            err(errors, "value", "remap.preset", "未知 remap preset")
        else:
            proutes = rp.get("routes") or []
            if not isinstance(proutes, list):
                err(errors, "value", "remap.presets.%s.routes" % rmp_preset, "必须是数组")
                proutes = []
            routes = copy.deepcopy(proutes)
            warnings.append({"kind": "warn", "path": "remap.preset",
                             "msg": "使用 remap preset %r（输入/输出版本需匹配）" % rmp_preset})
    explicit_routes = rmp.get("routes")
    if isinstance(explicit_routes, list):
        routes = copy.deepcopy(explicit_routes)
    norm_routes = []
    for i, r in enumerate(routes):
        pth = "remap.routes[%d]" % i
        if not isinstance(r, dict):
            err(errors, "schema", pth, "必须是 mapping")
            continue
        check_keys(r, ROUTE_KEYS, pth, errors)
        mode = r.get("mode", "direct")
        if mode not in ROUTE_MODES:
            err(errors, "value", pth + ".mode", "必须是 %s" % "/".join(ROUTE_MODES))
        src, dest = r.get("src"), r.get("dest")
        item = {"mode": mode, "gain_db": float(r.get("gain_db") or 0.0), "mute": bool(r.get("mute") or False)}
        if "gain_db" in r and not num_range(r["gain_db"], -60, 12, pth + ".gain_db", errors):
            pass
        if mode == "silence":
            if dest is None:
                err(errors, "value", pth, "silence 路由必须指定 dest")
            elif dest not in resolved_roles:
                err(errors, "value", pth + ".dest", "未知输出角色 %r" % dest)
            item["dest"] = dest
        elif mode == "drop":
            if src is None:
                err(errors, "value", pth, "drop 路由必须指定 src")
            elif in_layout_id and src not in in_role_ch:
                err(errors, "value", pth + ".src", "未知输入角色 %r" % src)
            item["src"] = src
        else:
            if src is None or dest is None:
                err(errors, "value", pth, "必须同时指定 src 与 dest")
            else:
                if in_layout_id and src not in in_role_ch:
                    err(errors, "value", pth + ".src", "未知输入角色 %r" % src)
                if dest not in resolved_roles:
                    err(errors, "value", pth + ".dest", "未知输出角色 %r" % dest)
            item["src"], item["dest"] = src, dest
        norm_routes.append(item)
    # 未映射检查
    if in_layout_id:
        routed_src = {r.get("src") for r in norm_routes if r.get("src")}
        for _r in resolved_roles.values():
            for _src in (_r.get("_explicit_sources") or []):
                if _src.get("src"):
                    routed_src.add(_src["src"])
        dropped = {r.get("src") for r in norm_routes if r.get("mode") == "drop"}
        for rid in in_role_ch:
            if rid not in routed_src and rid not in dropped:
                if rmp.get("drop_unused"):
                    warnings.append({"kind": "warn", "path": "remap", "msg": "输入角色 %r 未映射，已按 drop_unused 丢弃" % rid})
                else:
                    warnings.append({"kind": "warn", "path": "remap.routes",
                                     "msg": "输入角色 %r 未被使用（加路由或显式 drop；也可在 WebUI 忽略）" % rid})
        if not norm_routes:
            warnings.append({"kind": "warn", "path": "remap",
                             "msg": "无 remap 路由，按输入/输出角色同名 1:1 自动映射"})
    dest_routed = {r.get("dest") for r in norm_routes if r.get("dest")}
    for rid in resolved_roles:
        if rid not in dest_routed and resolved_roles[rid]["enabled"] and not resolved_roles[rid]["mute"]:
            if rmp.get("silence_unmapped", True):
                warnings.append({"kind": "warn", "path": "remap", "msg": "输出角色 %r 无路由，将静音（如非预期请加 silence/路由）" % rid})
            else:
                err(errors, "value", "remap.routes", "输出角色 %r 无路由（silence_unmapped=false）" % rid)

    # ---------- bass management（作用于输出角色 / remap 之后） ----------
    bm = doc.get("bass_management") or {}
    check_keys(bm, BM_KEYS, "bass_management", errors)
    bm_res = {"enabled": False, "lfe_role": "LFE", "lfe_to": [], "lfe_gain_db": 0.0,
              "redirect": {"enabled": True, "sources": [], "targets": [], "gain_db": 0.0},
              "mains_highpass_hz": 80.0, "mains_highpass_order": 4,
              "sub_lowpass_hz": 80.0, "sub_lowpass_order": 4, "sub_gain_db": 0.0}
    for k, v in bm.items():
        if k == "redirect" and isinstance(v, dict):
            check_keys(v, REDIRECT_KEYS, "bass_management.redirect", errors)
            bm_res["redirect"].update({kk: vv for kk, vv in v.items()})
        elif k in bm_res:
            bm_res[k] = v
    if not isinstance(bm_res["enabled"], bool):
        err(errors, "value", "bass_management.enabled", "必须是 bool")
    if bm_res["enabled"]:
        for field in ("lfe_to", "redirect.sources", "redirect.targets"):
            if field.startswith("redirect."):
                v = bm_res["redirect"].get(field.split(".")[1])
            else:
                v = bm_res.get(field)
            if not isinstance(v, list) or any(not isinstance(x, str) for x in v):
                err(errors, "value", "bass_management.%s" % field, "必须是字符串数组")
                continue
            for x in v:
                if x not in resolved_roles:
                    err(errors, "value", "bass_management.%s" % field, "未知输出角色 %r" % x)
        lr = bm_res.get("lfe_role")
        if not isinstance(lr, str) or (lr and lr not in resolved_roles):
            warnings.append({"kind": "warn", "path": "bass_management.lfe_role", "msg": "lfe_role 未在输出角色中，LFE 将不参与低音管理"})
        num_range(bm_res["lfe_gain_db"], -60, 12, "bass_management.lfe_gain_db", errors)
        num_range(bm_res["sub_gain_db"], -60, 12, "bass_management.sub_gain_db", errors)
        num_range(bm_res["mains_highpass_hz"], 20, strict_fs / 2.0, "bass_management.mains_highpass_hz", errors)
        num_range(bm_res["sub_lowpass_hz"], 20, strict_fs / 2.0, "bass_management.sub_lowpass_hz", errors)
        if bm_res["mains_highpass_order"] not in (2, 4, 6, 8):
            err(errors, "value", "bass_management.mains_highpass_order", "必须是 2/4/6/8")
        if bm_res["sub_lowpass_order"] not in (2, 4, 6, 8):
            err(errors, "value", "bass_management.sub_lowpass_order", "必须是 2/4/6/8")

    if bm_res.get("enabled"):
        for rid in (bm_res.get("redirect", {}).get("targets") or []) + (bm_res.get("lfe_to") or []):
            r = resolved_roles.get(rid)
            if r and r.get("_explicit_sources"):
                err(errors, "value", "output.roles.%s.sources" % rid,
                    "bass_management enabled 时该 SUB 的 sources 必须省略/为空（由渲染器自动生成 LFE+redirect）")
    resolved = {
        "schema": "khaen-channelmap/v2", "name": prof.get("name"),
        "input_layout": in_layout_id, "output_layout": (out_layout_id if out_role_source != "explicit" else "custom"),
        "input": {"channels": cap, "roles": in_role_ch},
        "output": {"device": out.get("device"), "channels": pb, "roles": resolved_roles,
                   "role_source": out_role_source},
        "remap": {"routes": norm_routes, "preset": rmp_preset,
                  "drop_unused": bool(rmp.get("drop_unused")), "silence_unmapped": bool(rmp.get("silence_unmapped", True))},
        "bass_management": bm_res,
        "fs": int(fs),
    }
    return (len(errors) == 0), errors, warnings, resolved

# ---------------- 渲染 ----------------
def _finalize_sources(resolved, errors):
    """把 remap 路由物化为 output roles 的 sources；bass_management enabled 时接管 SUB 输入。"""
    roles = resolved["output"]["roles"]
    routes = resolved["remap"]["routes"]
    bm = resolved["bass_management"]
    explicit = {rid: r for rid, r in roles.items() if r.get("_explicit_sources")}
    if explicit and routes:
        err(errors, "value", "remap",
            "roles[].sources 与 remap.preset/routes 同时存在（二选一：sources 是最终矩阵，remap 只用于生成/套用预设）")
        return
    if routes:
        for rid, r in roles.items():
            r["sources"] = []
        for rt in routes:
            if rt.get("mode") == "drop":
                continue
            if rt.get("mode") == "silence":
                roles[rt["dest"]]["sources"] = []
                roles[rt["dest"]]["_silenced"] = True
                continue
            dest = rt.get("dest")
            if dest not in roles:
                continue
            if rt.get("mode") == "duplicate":
                rt = dict(rt)
            roles[dest]["sources"].append({"src": rt["src"], "gain_db": rt.get("gain_db", 0.0),
                                           "inverted": bool(rt.get("mute")) and False,
                                           "mute": bool(rt.get("mute"))})
    elif explicit:
        for r in roles.values():
            if r.get("_explicit_sources"):
                r["sources"] = r["_explicit_sources"]
    else:
        # 自动 1:1：输入/输出同名角色
        for rid, r in roles.items():
            r["sources"] = [{"src": rid, "gain_db": 0.0, "mute": False}]
            if rid not in resolved["input"]["roles"]:
                r["sources"] = []
    # bass_management 接管 target SUB 输入与 mains HP
    if bm.get("enabled"):
        for rid in (bm.get("redirect", {}).get("targets") or []) + (bm.get("lfe_to") or []):
            r = roles.get(rid)
            if not r:
                continue
            if r.get("_explicit_sources") or r.get("sources"):
                err(errors, "value", "roles[].sources",
                    "bass_management enabled 时 %s 的 sources 必须为空或省略（由渲染器自动生成 LFE+redirect）" % rid)
            r["_bass_auto"] = True
    # 未使用输入 warning
    used = set()
    for r in roles.values():
        for s in r.get("sources") or []:
            used.add(s["src"])
    for rid in resolved["input"]["roles"]:
        if rid not in used and not bm.get("enabled"):
            pass  # 已在 validate 报 warning/error
    # enabled 角色空 sources -> 静音 warning
    resolved.setdefault("warnings_extra", [])
    for rid, r in roles.items():
        if r.get("enabled") and not r.get("sources") and not r.get("_bass_auto") and not r.get("_silenced"):
            resolved["warnings_extra"].append("输出角色 %r 无输入路由（将静音）" % rid)


def build_camilladsp(resolved, samplerate, chunksize, target_level, adjust_period,
                     capture_device, capture_format, playback_device, playback_format,
                     enable_rate_adjust=True):
    cap = resolved["input"]["channels"]
    pb = resolved["output"]["channels"]
    roles = resolved["output"]["roles"]
    bm = resolved["bass_management"]
    in_role_ch = resolved["input"]["roles"]
    mapping = {}
    for rid, ch in in_role_ch.items():
        mapping[rid] = ch
    filters, pipeline, mixers = {}, [], {}

    def addf(name, typ, params):
        filters[name] = {"type": typ, "parameters": params}

    active = [rid for rid in roles if roles[rid].get("enabled") and roles[rid].get("outputs")]
    targets = set(bm.get("redirect", {}).get("sources") or [])  # 需要 HP 的主声道 = redirect sources
    sub_targets = set((bm.get("redirect", {}).get("targets") or [])) if bm.get("enabled") else set()
    lfe_role = bm.get("lfe_role") if bm.get("enabled") else None

    # 每个输出角色 -> 每输出通道的 sources（输入通道索引）
    def role_sources(rid):
        r = roles[rid]
        out = []
        if r.get("_bass_auto"):
            return None
        for s in r.get("sources") or []:
            src = s.get("src")
            if src not in in_role_ch:
                continue
            out.append({"channel": in_role_ch[src], "gain_db": float(s.get("gain_db") or 0.0),
                        "inverted": bool(s.get("inverted")), "mute": bool(s.get("mute"))})
        return out

    def role_filters(rid):
        r = roles[rid]
        rl = re.sub(r"[^a-z0-9]+", "_", rid.lower())
        hp = lp = firn = gainn = delayn = None
        hp_xo = r.get("highpass")
        if bm.get("enabled") and rid in targets and hp_xo is None:
            hp_xo = {"freq": bm["mains_highpass_hz"], "order": bm["mains_highpass_order"], "type": "LinkwitzRiley"}
        if hp_xo:
            hp = rl + "_hp"
            addf(hp, "BiquadCombo", {"type": "LinkwitzRileyHighpass", "freq": hp_xo["freq"], "order": hp_xo["order"]})
        lp_xo = r.get("lowpass")
        if bm.get("enabled") and rid in sub_targets and lp_xo is None:
            lp_xo = {"freq": bm["sub_lowpass_hz"], "order": bm["sub_lowpass_order"], "type": "LinkwitzRiley"}
        if lp_xo:
            lp = rl + "_lp"
            addf(lp, "BiquadCombo", {"type": "LinkwitzRileyLowpass", "freq": lp_xo["freq"], "order": lp_xo["order"]})
        peq_names = []
        for i, p in enumerate(r.get("peq") or []):
            n = "%s_peq%d" % (rl, i)
            typ = p.get("type", "peaking")
            if typ == "low_shelf":
                # CamillaDSP Slope 单位 dB/oct；effective S = slope/12 = q（RBJ shelf slope）
                prm = {"type": "Lowshelf", "freq": p["freq"], "slope": round(12.0 * p["q"], 6),
                       "gain": p["gain_db"]}
            elif typ == "high_shelf":
                prm = {"type": "Highshelf", "freq": p["freq"], "slope": round(12.0 * p["q"], 6),
                       "gain": p["gain_db"]}
            else:
                prm = {"type": "Peaking", "freq": p["freq"], "q": p["q"], "gain": p["gain_db"]}
            addf(n, "Biquad", prm)
            peq_names.append(n)
        if r.get("_fir"):
            firn = rl + "_fir"
            prm = {"filename": r["_fir"]["path"]}
            if r["_fir"].get("channel") is not None:
                prm["channel"] = r["_fir"]["channel"]
            addf(firn, "Conv", {"type": "Wav", **prm})
        if abs(float(r.get("gain_db") or 0.0)) > 1e-9:
            gainn = rl + "_gain"
            addf(gainn, "Gain", {"gain": float(r["gain_db"])})
        if abs(float(r.get("delay_ms") or 0.0)) > 1e-9:
            delayn = rl + "_delay"
            addf(delayn, "Delay", {"delay": float(r["delay_ms"]), "unit": "ms"})
        return hp, lp, peq_names, firn, gainn, delayn

    def dest_sources(rid):
        """返回该角色对每个输出通道的 sources 列表（含 polarity/mute）。"""
        r = roles[rid]
        inv = r.get("polarity") == "invert"
        mute = bool(r.get("mute"))
        srcs = role_sources(rid)
        if srcs is None:
            srcs = []
        out = []
        for s in srcs:
            d = {"channel": s["channel"]}
            if abs(s["gain_db"]) > 1e-9:
                d["gain"] = s["gain_db"]
            if inv != bool(s.get("inverted")):
                d["inverted"] = True
            if float(s["gain_db"]) >= -60 and s.get("mute"):
                pass
            out.append(d)
        return out, mute

    # 1) 主 remap mixer：输入 -> 输出角色（每个输出通道一个 dest）
    mx = {"description": "remap：输入角色 -> 输出角色（多源求和/每源 gain/invert）",
          "channels": {"in": cap, "out": pb}, "mapping": []}
    role_chain = {}
    for rid in active:
        for o in roles[rid]["outputs"]:
            srcs, mute = dest_sources(rid)
            item = {"dest": o, "sources": srcs}
            if mute:
                item["mute"] = True
            mx["mapping"].append(item)
    # bass management：extract（从输出通道复制 mains）-> LP -> sum
    if bm.get("enabled") and sub_targets:
        sub_list = [rid for rid in active if rid in sub_targets]
        if sub_list:
            rd = bm.get("redirect") or {}
            n = len(sub_list)
            mx_ext = {"description": "bass extract：主声道（remap 后）复制到临时声道",
                      "channels": {"in": pb, "out": pb + n}, "mapping": []}
            for o in range(pb):  # 未映射输出=静音，主声道必须显式直通
                mx_ext["mapping"].append({"dest": o, "sources": [{"channel": o}]})
            for i, rid in enumerate(sub_list):
                srcs = []
                if rd.get("enabled", True):
                    for s in rd.get("sources") or []:
                        if s in roles and s not in sub_targets:
                            for o in roles[s]["outputs"]:
                                srcs.append({"channel": o, "gain": float(rd.get("gain_db") or 0.0)})
                mx_ext["mapping"].append({"dest": pb + i, "sources": srcs})
            mixers["bass_extract"] = mx_ext
            pipeline.append({"type": "Mixer", "name": "bass_extract"})
            # extract 声道 LP（role.lowpass 覆盖 sub_lowpass_hz）
            lp_pairs = []
            for i, rid in enumerate(sub_list):
                lpx = roles[rid].get("lowpass") or {"freq": bm["sub_lowpass_hz"],
                                                    "order": bm["sub_lowpass_order"],
                                                    "type": "LinkwitzRiley"}
                nm = re.sub(r"[^a-z0-9]+", "_", rid.lower()) + "_lp"
                addf(nm, "BiquadCombo", {"type": "LinkwitzRileyLowpass",
                                         "freq": lpx["freq"], "order": lpx["order"]})
                lp_pairs.append((pb + i, nm))
            for ch, nm in lp_pairs:
                pipeline.append({"type": "Filter", "description": "SUB lowpass（extract 后）",
                                 "channels": [ch], "names": [nm]})
            # 第二级 mixer：非 SUB 直通 + SUB = extract + LFE
            mx2 = {"description": "bass sum：SUB = extract（+ LFE/lfe_to），其余通道直通",
                   "channels": {"in": pb + n, "out": pb}, "mapping": []}
            for o in range(pb):
                owner = None
                sub_idx = None
                for rid in active:
                    if o in roles[rid]["outputs"]:
                        owner = rid
                        if rid in sub_targets:
                            sub_idx = sub_list.index(rid) if rid in sub_list else None
                        break
                if owner is not None and sub_idx is not None:
                    srcs = [{"channel": pb + sub_idx}]
                    inv = roles[owner].get("polarity") == "invert"
                    for sidx in srcs:
                        if inv:
                            sidx["inverted"] = True
                    if owner in (bm.get("lfe_to") or []) and lfe_role in roles:
                        for lo in roles[lfe_role]["outputs"]:
                            d = {"channel": lo, "gain": float(bm.get("lfe_gain_db") or 0.0)}
                            if inv:
                                d["inverted"] = True
                            srcs.append(d)
                    item = {"dest": o, "sources": srcs}
                    if roles[owner].get("mute"):
                        item["mute"] = True
                    mx2["mapping"].append(item)
                else:
                    mx2["mapping"].append({"dest": o, "sources": [{"channel": o}]})
            mixers["to_outputs"] = mx2
            # 主链在 bass 模式下的直通 mixer 先于 extract：这里 remap 已出 pb 通道，
            # 因此 extract 取自 remap 结果；最终输出用 mx2。
            pipeline = [{"type": "Mixer", "name": "bass_extract"},
                        {"type": "Filter", "description": "SUB lowpass（extract 后）",
                         "channels": [p[0] for p in lp_pairs], "names": [p[1] for p in lp_pairs]},
                        {"type": "Mixer", "name": "to_outputs"}]
            mixers["remap_outputs"] = mx
            # 需要 remap 的 tmp mixer：remap_outputs 输出 -> 直通进 bass_extract? 
            # 正确顺序：Mixer(remap) -> Mixer(bass_extract) -> Filter(LP) -> Mixer(to_outputs)
            pipeline = [{"type": "Mixer", "name": "remap_outputs"},
                        {"type": "Mixer", "name": "bass_extract"},
                        {"type": "Filter", "description": "SUB lowpass（extract 后）",
                         "channels": [p[0] for p in lp_pairs], "names": [p[1] for p in lp_pairs]},
                        {"type": "Mixer", "name": "to_outputs"}]
    else:
        mixers["to_outputs"] = mx
        pipeline.append({"type": "Mixer", "name": "to_outputs"})

    # 2) 角色滤波链（HP -> PEQ -> FIR -> gain -> delay；SUB 的 LP 已在 bass 阶段处理）
    def add_step(desc, pairs):
        # CamillaDSP 的 Filter step 会把 names 中所有滤波器串到 channels 的每个通道上；
        # 因此 (channel, filter) 必须拆成每 filter 一步（同 filter 多通道才合并）。
        by_name = {}
        for ch, name in pairs:
            by_name.setdefault(name, []).append(ch)
        for name, chans in by_name.items():
            pipeline.append({"type": "Filter", "description": desc,
                             "channels": chans, "names": [name]})

    hp_pairs, peq_groups, fir_pairs, gain_pairs, delay_pairs = [], {}, [], [], []
    lp_pairs2 = []
    for rid in active:
        r = roles[rid]
        hp, lp, peq_names, firn, gainn, delayn = role_filters(rid)
        outs = r["outputs"]
        if hp:
            hp_pairs += [(o, hp) for o in outs]
        if lp:
            if bm.get("enabled") and rid in sub_targets:
                pass
            else:
                lp_pairs2 += [(o, lp) for o in outs]
        for i, nm in enumerate(peq_names):
            peq_groups.setdefault(i, []).extend((o, nm) for o in outs)
        if firn:
            fir_pairs += [(o, firn) for o in outs]
        if gainn:
            gain_pairs += [(o, gainn) for o in outs]
        if delayn:
            delay_pairs += [(o, delayn) for o in outs]
    add_step("per-role highpass", hp_pairs)
    add_step("per-role lowpass", lp_pairs2)
    for i in sorted(peq_groups):
        add_step("per-role PEQ[%d]" % i, peq_groups[i])
    add_step("per-role FIR", fir_pairs)
    add_step("per-role gain", gain_pairs)
    add_step("per-role delay", delay_pairs)

    cfg = {
        "devices": {
            "samplerate": int(samplerate), "chunksize": int(chunksize),
            "target_level": int(target_level), "adjust_period": int(adjust_period),
            "enable_rate_adjust": bool(enable_rate_adjust), "queuelimit": 4,
            "resampler": {"type": "AsyncSinc", "profile": "Balanced"},
            "capture": {"type": "Alsa", "channels": cap, "device": capture_device, "format": capture_format},
            "playback": {"type": "Alsa", "channels": pb, "device": playback_device, "format": playback_format},
        },
        "filters": filters, "mixers": mixers, "pipeline": pipeline,
    }
    return cfg


def camilladsp_check(cfg_path):
    exe = shutil.which("camilladsp")
    if not exe:
        return None, "未找到 camilladsp，跳过 --check"
    try:
        p = subprocess.run([exe, "--check", cfg_path], capture_output=True, text=True, timeout=30)
    except Exception as e:
        return False, "camilladsp --check 执行失败：%s" % e
    if p.returncode == 0:
        return True, "camilladsp --check 通过"
    return False, "camilladsp --check 失败：%s %s" % (p.stdout.strip(), p.stderr.strip())


# ---------------- probe ----------------
def _parse_hw_params(text):
    info = {"channels": [], "formats": [], "rates": []}
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("CHANNELS:"):
            nums = re.findall(r"\d+", s.split(":", 1)[1])
            if nums:
                info["channels"] = [int(x) for x in nums]
        elif s.startswith("FORMAT:"):
            info["formats"] = re.findall(r"[A-Z][A-Z0-9_]+", s.split(":", 1)[1])
        elif s.startswith("RATE:"):
            info["rates"] = re.findall(r"\d+", s.split(":", 1)[1])
    return info


def cmd_probe(args):
    res = {"ok": False, "playback": None, "capture": None, "cards": [], "notes": [],
           "needs_user_choice": False}
    try:
        with open("/proc/asound/cards", "r", encoding="utf-8", errors="replace") as f:
            res["cards"] = [l.strip() for l in f if l.strip()]
    except Exception:
        pass

    def probe_dev(dev, tool):
        if not dev:
            return None
        exe = shutil.which(tool)
        if not exe:
            res["notes"].append("%s 不存在，无法探测 %s" % (tool, dev))
            return None
        try:
            cmd = [exe, "-D", dev, "--dump-hw-params"] + (["/dev/zero"] if tool == "aplay" else ["/dev/null"])
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            txt = (p.stdout or "") + "\n" + (p.stderr or "")
            info = _parse_hw_params(txt)
            info["device"] = dev
            info["channels_min"] = min(info["channels"]) if info["channels"] else None
            info["channels_max"] = max(info["channels"]) if info["channels"] else None
            info["formats"] = sorted(set(info["formats"]))
            info["rates"] = sorted(set(int(x) for x in info["rates"]))
            return info
        except Exception as e:
            res["notes"].append("%s 探测失败：%s" % (dev, e))
            return None

    pb = probe_dev(args.playback_device, "aplay")
    cap = probe_dev(args.capture_device, "arecord")
    res["playback"], res["capture"] = pb, cap
    res["ok"] = bool(pb or cap)
    if not res["ok"]:
        res["needs_user_choice"] = True
        res["notes"].append("未能探测到通道数：WebUI 请让用户选择输入/输出通道数（或检查设备名）")
    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
    else:
        print("playback:", json.dumps(pb, ensure_ascii=False) if pb else "unavailable")
        print("capture :", json.dumps(cap, ensure_ascii=False) if cap else "unavailable")
        for n in res["notes"]:
            print("NOTE:", n)
    return 0 if res["ok"] else 3


# ---------------- apply / rollback / profiles ----------------
def _read_state():
    try:
        return json.load(open(os.path.join(RUN_DIR, "state.json"), encoding="utf-8"))
    except Exception:
        return {}


def _detect_mode():
    m = (_read_state() or {}).get("mode") or ""
    return m if m in ("dante", "aes67", "off") else "off"


def _mode_fs(mode):
    return 96000 if mode == "dante" else 48000


def _systemctl(*argv):
    exe = shutil.which("systemctl")
    if not exe:
        return 1, "systemctl 不存在"
    p = subprocess.run([exe] + list(argv), capture_output=True, text=True, timeout=60)
    return p.returncode, (p.stdout + p.stderr).strip()


def _backup_active(path):
    os.makedirs(os.path.join(VAR_DIR, "backups"), exist_ok=True)
    if not os.path.isfile(path):
        return None
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    dst = os.path.join(VAR_DIR, "backups", "channelmap-%s.yml" % ts)
    shutil.copy2(path, dst)
    return dst


def _write_state(ok, mode, fs, source, note):
    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        json.dump({"ok": bool(ok), "ts": datetime.datetime.now().astimezone().isoformat(),
                   "mode": mode, "fs": fs, "source": source, "note": note,
                   "camilladsp_yml": CAMILLA_YML},
                  open(STATE_JSON, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    except Exception:
        pass


def motu_playback_channels(fs):
    """MOTU UltraLite-mk5 USB altset 通道数：44.1/48k → 22ch、88.2/96k → 18ch。

    192k/176.4k 的 10ch 映射已按用户硬约束删除（禁 192k；生产只用 48/96k）：
    不再回退猜通道数，由 validate_sample_rate() 显式拒绝（稳定错误码）。
    """
    fs = validate_sample_rate(fs)
    return 22 if fs <= 48000 else 18


def _json_file(path):
    try:
        with io.open(path, encoding="utf-8") as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except Exception:
        return {}


def resolve_content_mode(args):
    """用户覆盖 > detector(/run) > auto；auto 默认多声道直通。"""
    m = getattr(args, "content_mode", None)
    if m in ("auto", "stereo", "multichannel"):
        return m
    run = os.environ.get("KHAEN_INPUT_CONTENT_FILE", "/run/khaen/input-content.json")
    st = _json_file(run)
    cm = st.get("content_mode")
    if cm in ("auto", "stereo", "multichannel"):
        return cm
    ovf = os.environ.get("KHAEN_INPUT_MODE_FILE", "/etc/khaen-audio/input-mode.json")
    ov = _json_file(ovf)
    om = ov.get("mode")
    if om in ("force-stereo", "stereo"):
        return "stereo"
    if om in ("force-multichannel", "multichannel"):
        return "multichannel"
    return "auto"


def check_content_mode(args, res):
    """stereo 必须有上混矩阵（roles[].sources 显式）；multichannel 强制直通。"""
    mode = resolve_content_mode(args)
    if mode != "stereo":
        return mode, None
    roles = res.get("output", {}).get("roles") or {}
    missing = []
    for rid, r in roles.items():
        if r.get("enabled", True) and not r.get("_explicit_sources"):
            missing.append(rid)
    if missing:
        return mode, ("内容模式 stereo：profile 必须有上混矩阵（roles[].sources 显式声明），"
                      "当前未声明上混的角色：%s；请用 khaen-upmix 生成/选择上混 profile" % ", ".join(missing))
    return mode, None


def _resolve_channels(args, doc):
    """返回 (cap, pb)。优先 CLI/参数；否则 probe（若设备名可探测）；否则用 profile 值。"""
    cap = getattr(args, "capture_channels", None)
    pb = getattr(args, "playback_channels", None)
    if cap is None or pb is None:
        fs = validate_sample_rate(getattr(args, "samplerate", None) or 48000)
        # 产品输出固定为 MOTU UltraLite-mk5：默认按 USB altset 规则取通道数
        # （44.1/48k=22、88.2/96k=18；192k 已禁用），profile 的 channels 仅作无 MOTU 时的回退。
        if pb is None:
            pb = motu_playback_channels(fs)
        try:
            presets = load_presets(args.presets)
        except Exception:
            presets = {"input_layouts": {}, "output_layouts": {}, "remap_presets": {}}
        inp = doc.get("input") or {}
        il = presets["input_layouts"].get(inp.get("layout") or "", {}) or {}
        if cap is None:
            v = inp.get("channels")
            if isinstance(v, int) and not isinstance(v, bool):
                cap = v
        if cap is None:
            sv = il.get("streams")
            if isinstance(sv, list) and sv and all(isinstance(x, int) and not isinstance(x, bool) and x > 0 for x in sv):
                cap = sum(sv)
            elif isinstance(il.get("channels"), int) and not isinstance(il.get("channels"), bool):
                cap = il["channels"]
        if cap is None:
            pr = _probe_devices(args)
            if pr and pr.get("capture"):
                cap = pr["capture"].get("channels_max")
    return cap, pb


def _probe_devices(args):
    class NS:
        playback_device = getattr(args, "playback_device", None)
        capture_device = getattr(args, "capture_device", None)
        json = True
    try:
        # 简单探测（不发散输出）
        res = {"playback": None, "capture": None}
        for key, dev, tool in (("playback", NS.playback_device, "aplay"),
                               ("capture", NS.capture_device, "arecord")):
            if not dev:
                continue
            exe = shutil.which(tool)
            if not exe:
                continue
            cmd = [exe, "-D", dev, "--dump-hw-params"] + (["/dev/zero"] if tool == "aplay" else ["/dev/null"])
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            info = _parse_hw_params((p.stdout or "") + "\n" + (p.stderr or ""))
            if info["channels"]:
                info["channels_min"] = min(info["channels"])
                info["channels_max"] = max(info["channels"])
            res[key] = info
        return res
    except Exception:
        return None


def _apply_impl(args):
    mode = getattr(args, "mode", None) or _detect_mode()
    fs = getattr(args, "samplerate", None) or _mode_fs(mode)
    src = args.file or ACTIVE
    if not os.path.isfile(src):
        sys.stderr.write("channelmap 文件不存在：%s\n" % src)
        return 2
    doc = load_yaml(src)
    cap, pb = _resolve_channels(args, doc)
    if cap is None or pb is None:
        sys.stderr.write("无法确定输入/输出通道数：请先 khaen-channelmap probe 或 WebUI 选择/传入 --capture-channels/--playback-channels\n")
        return 3
    presets = load_presets(args.presets)
    ok, errors, warnings, res = resolve_and_validate(
        doc, presets, fs=fs, capture_channels=cap, playback_channels=pb,
        check_files=True, allow_fs_mismatch=args.allow_fir_fs_mismatch,
        base_dir=os.path.dirname(os.path.abspath(src)))
    if not ok:
        for e in errors:
            sys.stderr.write("ERROR [%s] %s: %s\n" % (e["kind"], e["path"], e["msg"]))
        return 2 if any(e["kind"] == "schema" for e in errors) else 3
    _finalize_sources(res, errors)
    if errors:
        for e in errors:
            sys.stderr.write("ERROR [%s] %s: %s\n" % (e["kind"], e["path"], e["msg"]))
        return 2 if any(e["kind"] == "schema" for e in errors) else 3
    for w in warnings:
        sys.stderr.write("WARN %s: %s\n" % (w["path"], w["msg"]))
    cfg = build_camilladsp(res, samplerate=fs, chunksize=args.chunksize,
                           target_level=args.target_level, adjust_period=args.adjust_period,
                           capture_device=args.capture_device, capture_format=args.capture_format,
                           playback_device=args.playback_device or res["output"].get("device") or "hw:motu,0",
                           playback_format=args.playback_format,
                           enable_rate_adjust=not args.no_rate_adjust)
    text = yaml.safe_dump(cfg, sort_keys=False, allow_unicode=True, default_flow_style=False)
    os.makedirs(RUN_DIR, exist_ok=True)
    tmp = CAMILLA_YML + ".tmp.%d" % os.getpid()
    open(tmp, "w", encoding="utf-8").write(text)
    if args.check:
        okc, msg = camilladsp_check(tmp)
        if okc is False:
            os.unlink(tmp)
            sys.stderr.write(msg + "\n")
            return 4
    os.replace(tmp, CAMILLA_YML)
    active = ACTIVE
    if getattr(args, "persist", True) and os.path.abspath(src) != os.path.abspath(active):
        if os.path.isfile(active):
            b = _backup_active(active)
            if b:
                sys.stderr.write("已备份原 active：%s\n" % b)
        os.makedirs(os.path.dirname(active), exist_ok=True)
        shutil.copy2(src, active)
        sys.stderr.write("已持久化 active：%s\n" % active)
    if mode == "off" or getattr(args, "no_restart", False):
        _write_state(True, mode, fs, src, "off/no-restart：仅校验+渲染+持久化")
        print("channelmap applied（mode=%s，未启动 CamillaDSP）：%s" % (mode, CAMILLA_YML))
        return 0
    rc, out = _systemctl("restart", UNIT)
    if rc != 0:
        sys.stderr.write("systemctl restart %s 失败：%s\n" % (UNIT, out))
        lg = os.path.join(VAR_DIR, "last-good.yml")
        if os.path.isfile(lg):
            shutil.copy2(lg, active)
            _write_state(False, mode, fs, src, "restart 失败，已回滚 last-good")
        return 9
    time.sleep(2.5)
    rc, out = _systemctl("is-active", UNIT)
    if rc != 0 or out.strip() != "active":
        sys.stderr.write("%s 未 active（%s），回滚\n" % (UNIT, out.strip()))
        lg = os.path.join(VAR_DIR, "last-good.yml")
        if os.path.isfile(lg):
            shutil.copy2(lg, active)
            _write_state(False, mode, fs, src, "未 active，已回滚 last-good")
        return 9
    os.makedirs(VAR_DIR, exist_ok=True)
    shutil.copy2(active, os.path.join(VAR_DIR, "last-good.yml"))
    _write_state(True, mode, fs, src, "CamillaDSP 已重启并 active")
    print("channelmap applied（mode=%s, fs=%d, capture=%d, playback=%d）：%s" % (mode, fs, cap, pb, CAMILLA_YML))
    return 0


def cmd_apply(args):
    return _apply_impl(args)


def cmd_rollback(args):
    lg = os.path.join(VAR_DIR, "last-good.yml")
    if not os.path.isfile(lg):
        sys.stderr.write("没有 last-good：%s\n" % lg)
        return 2
    active = ACTIVE
    b = _backup_active(active)
    if b:
        sys.stderr.write("当前 active 已备份：%s\n" % b)
    shutil.copy2(lg, active)
    ns = argparse.Namespace(**vars(args))
    ns.file = active
    return _apply_impl(ns)


def _profiles_dir():
    return PROFILES_DIR


def cmd_profiles(args):
    d = _profiles_dir()
    os.makedirs(d, exist_ok=True)
    items = []
    for fn in sorted(os.listdir(d)):
        if not fn.endswith((".yml", ".yaml")):
            continue
        p = os.path.join(d, fn)
        try:
            doc = load_yaml(p)
            presets = load_presets(args.presets)
            ok, errors, warnings, res = resolve_and_validate(doc, presets, fs=48000,
                                                             allow_fs_mismatch=True, require_channels=False)
            items.append({"name": os.path.splitext(fn)[0], "path": p, "ok": ok,
                          "profile_name": (doc or {}).get("profile", {}).get("name"),
                          "description": (doc or {}).get("profile", {}).get("description"),
                          "errors": errors[:5]})
        except Exception as e:
            items.append({"name": os.path.splitext(fn)[0], "path": p, "ok": False,
                          "errors": [{"kind": "schema", "path": "$", "msg": str(e)}]})
    if args.json:
        print(json.dumps({"dir": d, "active": ACTIVE, "profiles": items}, ensure_ascii=False, indent=2))
    else:
        print("profiles: %s  active: %s" % (d, ACTIVE))
        for it in items:
            print("  %-24s %s  %s" % (it["name"], "OK" if it["ok"] else "INVALID",
                                      it.get("description") or ""))
    return 0


PROFILE_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")


def cmd_save_profile(args):
    src = args.file or ACTIVE
    doc = load_yaml(src)
    presets = load_presets(args.presets)
    cap, pb = _resolve_channels(args, doc)
    ok, errors, warnings, _ = resolve_and_validate(doc, presets, fs=args.samplerate or 48000,
                                                   capture_channels=cap, playback_channels=pb,
                                                   allow_fs_mismatch=True)
    if not ok:
        for e in errors:
            sys.stderr.write("ERROR [%s] %s: %s\n" % (e["kind"], e["path"], e["msg"]))
        return 2 if any(e["kind"] == "schema" for e in errors) else 3
    if not PROFILE_RE.match(args.name):
        sys.stderr.write("profile 名只允许字母数字._-（1..64）\n")
        return 2
    os.makedirs(_profiles_dir(), exist_ok=True)
    dst = os.path.join(_profiles_dir(), args.name + ".yml")
    shutil.copy2(src, dst)
    print("saved profile: %s" % dst)
    return 0


def cmd_load_profile(args):
    src = os.path.join(_profiles_dir(), args.name + ".yml")
    if not os.path.isfile(src):
        sys.stderr.write("profile 不存在：%s\n" % src)
        return 2
    doc = load_yaml(src)
    presets = load_presets(args.presets)
    cap, pb = _resolve_channels(args, doc)
    ok, errors, warnings, _ = resolve_and_validate(doc, presets, fs=args.samplerate or 48000,
                                                   capture_channels=cap, playback_channels=pb,
                                                   allow_fs_mismatch=True)
    if not ok:
        for e in errors:
            sys.stderr.write("ERROR [%s] %s: %s\n" % (e["kind"], e["path"], e["msg"]))
        return 2 if any(e["kind"] == "schema" for e in errors) else 3
    os.makedirs(os.path.dirname(ACTIVE), exist_ok=True)
    if os.path.isfile(ACTIVE):
        b = _backup_active(ACTIVE)
        if b:
            sys.stderr.write("当前 active 已备份：%s\n" % b)
    shutil.copy2(src, ACTIVE)
    ns = argparse.Namespace(**vars(args))
    ns.file = ACTIVE
    return _apply_impl(ns)


def cmd_export(args):
    src = args.name if os.path.isfile(args.name) else os.path.join(_profiles_dir(), args.name + ".yml")
    if not os.path.isfile(src):
        sys.stderr.write("找不到：%s\n" % src)
        return 2
    if args.output in (None, "-"):
        sys.stdout.write(open(src, encoding="utf-8").read())
    else:
        shutil.copy2(src, args.output)
        print("exported: %s" % args.output)
    return 0


def cmd_import(args):
    if not os.path.isfile(args.file):
        sys.stderr.write("文件不存在：%s\n" % args.file)
        return 2
    if not PROFILE_RE.match(args.name):
        sys.stderr.write("profile 名只允许字母数字._-（1..64）\n")
        return 2
    doc = load_yaml(args.file)
    presets = load_presets(args.presets)
    cap, pb = _resolve_channels(args, doc)
    ok, errors, warnings, _ = resolve_and_validate(doc, presets, fs=args.samplerate or 48000,
                                                   capture_channels=cap, playback_channels=pb,
                                                   allow_fs_mismatch=True)
    if not ok:
        for e in errors:
            sys.stderr.write("ERROR [%s] %s: %s\n" % (e["kind"], e["path"], e["msg"]))
        return 2 if any(e["kind"] == "schema" for e in errors) else 3
    os.makedirs(_profiles_dir(), exist_ok=True)
    dst = os.path.join(_profiles_dir(), args.name + ".yml")
    shutil.copy2(args.file, dst)
    print("imported: %s" % dst)
    return 0


# ---------------- CLI ----------------
def add_common(p):
    p.add_argument("--presets", default=PRESETS, help="layout-presets.yml 路径")
    p.add_argument("--samplerate", type=int, help="当前模式采样率（默认按模式 48k/96k）")
    p.add_argument("--capture-channels", type=int, dest="capture_channels")
    p.add_argument("--playback-channels", type=int, dest="playback_channels")
    p.add_argument("--allow-fir-fs-mismatch", action="store_true")
    p.add_argument("--no-persist", dest="persist", action="store_false", default=True)
    p.add_argument("--content-mode", choices=("auto", "stereo", "multichannel"),
                   help="节目内容模式（默认 auto：读 /run/khaen/input-content.json，再读 /etc/khaen-audio/input-mode.json）")


def add_render_opts(p):
    p.add_argument("--capture-device", default="hw:ravenna,0")
    p.add_argument("--capture-format", default="S32_LE")
    p.add_argument("--playback-device", default=None)
    p.add_argument("--playback-format", default="S24_3_LE")
    p.add_argument("--chunksize", type=int, default=128)
    p.add_argument("--target-level", type=int, dest="target_level", default=512)
    p.add_argument("--adjust-period", type=int, dest="adjust_period", default=10)
    p.add_argument("--no-rate-adjust", action="store_true")
    p.add_argument("--check", dest="check", action="store_true", default=True)
    p.add_argument("--no-check", dest="check", action="store_false")


def _validate_cmd(args, do_print=False):
    presets = load_presets(args.presets)
    doc = load_yaml(args.file)
    cap, pb = _resolve_channels(args, doc)
    ok, errors, warnings, res = resolve_and_validate(
        doc, presets, fs=args.samplerate or 48000, capture_channels=cap, playback_channels=pb,
        check_files=getattr(args, "check_files", False),
        allow_fs_mismatch=args.allow_fir_fs_mismatch,
        base_dir=os.path.dirname(os.path.abspath(args.file)))
    if ok:
        _finalize_sources(res, errors)
        ok = not errors
    if do_print:
        if args.json:
            print(json.dumps({"ok": ok, "errors": errors, "warnings": warnings, "resolved": res},
                             ensure_ascii=False, indent=2, default=str))
        elif res:
            print("profile: %s  input: %s（%s ch） output: %s（%s ch）" % (
                res.get("name"), res.get("input_layout"), res["input"]["channels"],
                res.get("output_layout"), res["output"]["channels"]))
            print("input roles:", json.dumps(res["input"]["roles"], ensure_ascii=False, sort_keys=True))
            print("%-8s %-8s %-4s %-6s %-6s %-5s %-3s %-3s %-4s %s" % (
                "role", "outputs", "en", "gain", "delay", "pol", "hp", "lp", "peq", "sources"))
            for rid, v in res["output"]["roles"].items():
                srcs = ",".join(s.get("src", "") for s in (v.get("sources") or [])) or "-"
                print("%-8s %-8s %-4s %-6s %-6s %-5s %-3s %-3s %-4s %s" % (
                    rid, v.get("outputs"), v.get("enabled"), v.get("gain_db"), v.get("delay_ms"),
                    v.get("polarity"), "Y" if v.get("highpass") else "-",
                    "Y" if v.get("lowpass") else "-", len(v.get("peq") or []), srcs))
            print("bass_management:", json.dumps(res["bass_management"], ensure_ascii=False, sort_keys=True))
            for e in errors:
                print("  ERROR [%s] %s: %s" % (e["kind"], e["path"], e["msg"]))
            for w in warnings:
                print("  WARN  %s: %s" % (w["path"], w["msg"]))
    else:
        if args.json:
            print(json.dumps({"ok": ok, "errors": errors, "warnings": warnings}, ensure_ascii=False, indent=2))
        else:
            print("channelmap: %s  (%s)" % ("OK" if ok else "INVALID", args.file))
            for e in errors:
                print("  ERROR [%s] %s: %s" % (e["kind"], e["path"], e["msg"]))
            for w in warnings:
                print("  WARN  %s: %s" % (w["path"], w["msg"]))
    if not ok:
        return 2 if any(e["kind"] == "schema" for e in errors) else 3
    return 0


def cmd_validate(args):
    return _validate_cmd(args, do_print=False)


def cmd_print(args):
    return _validate_cmd(args, do_print=True)


def cmd_render(args):
    presets = load_presets(args.presets)
    doc = load_yaml(args.file)
    cap, pb = _resolve_channels(args, doc)
    if cap is None or pb is None:
        sys.stderr.write("无法确定输入/输出通道数：需 probe 或传 --capture-channels/--playback-channels\n")
        return 3
    fs = int(args.samplerate or 48000)
    ok, errors, warnings, res = resolve_and_validate(
        doc, presets, fs=fs, capture_channels=cap, playback_channels=pb,
        check_files=True, allow_fs_mismatch=args.allow_fir_fs_mismatch,
        base_dir=os.path.dirname(os.path.abspath(args.file)))
    if ok:
        _finalize_sources(res, errors)
        ok = not errors
    if not ok:
        for e in errors:
            sys.stderr.write("ERROR [%s] %s: %s\n" % (e["kind"], e["path"], e["msg"]))
        return 2 if any(e["kind"] == "schema" for e in errors) else 3
    mode, merr = check_content_mode(args, res)
    if merr:
        sys.stderr.write("ERROR [value] content_mode: %s\n" % merr)
        return 3
    for w in warnings:
        sys.stderr.write("WARN %s: %s\n" % (w["path"], w["msg"]))
    # 渲染 fs 精校验（48k 更严在 validate 已做；这里针对实际 fs）
    lim = fs / 2.0
    bad = []
    for rid, r in res["output"]["roles"].items():
        for key in ("highpass", "lowpass"):
            xo = r.get(key)
            if xo and xo.get("freq") and xo["freq"] >= lim:
                bad.append("%s.%s.freq=%s >= fs/2" % (rid, key, xo["freq"]))
        for i, p in enumerate(r.get("peq") or []):
            if p["freq"] >= lim:
                bad.append("%s.peq[%d].freq=%s >= fs/2" % (rid, i, p["freq"]))
    if bad:
        sys.stderr.write("ERROR 渲染采样率校验失败：\n  %s\n" % "\n  ".join(bad))
        return 3
    cfg = build_camilladsp(res, samplerate=fs, chunksize=args.chunksize,
                           target_level=args.target_level, adjust_period=args.adjust_period,
                           capture_device=args.capture_device, capture_format=args.capture_format,
                           playback_device=args.playback_device or res["output"].get("device") or "hw:motu,0",
                           playback_format=args.playback_format,
                           enable_rate_adjust=not args.no_rate_adjust)
    text = yaml.safe_dump(cfg, sort_keys=False, allow_unicode=True, default_flow_style=False)
    if args.output in (None, "-"):
        sys.stdout.write(text)
        return 0
    tmp = args.output + ".tmp.%d" % os.getpid()
    open(tmp, "w", encoding="utf-8").write(text)
    if args.check:
        okc, msg = camilladsp_check(tmp)
        if okc is False:
            os.unlink(tmp)
            sys.stderr.write(msg + "\n")
            return 4
        sys.stderr.write((msg or "") + "\n")
    os.replace(tmp, args.output)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="khaen-channelmap", description="通用 channelmap v2 工具")
    ap.add_argument("--version", action="version", version="khaen-channelmap " + TOOL_VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("probe", help="探测 ALSA 输入/输出通道与格式")
    p.add_argument("--capture-device", default=None)
    p.add_argument("--playback-device", default=None)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_probe)

    p = sub.add_parser("validate", help="校验 channelmap")
    p.add_argument("file", nargs="?", default=ACTIVE)
    p.add_argument("--json", action="store_true")
    p.add_argument("--check-files", action="store_true")
    add_common(p)
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("print", help="打印解析后的 profile")
    p.add_argument("file", nargs="?", default=ACTIVE)
    p.add_argument("--json", action="store_true")
    add_common(p)
    p.set_defaults(func=cmd_print)

    p = sub.add_parser("render", help="渲染 CamillaDSP 配置")
    p.add_argument("file", nargs="?", default=ACTIVE)
    p.add_argument("--output", "-o", default="-")
    add_common(p)
    add_render_opts(p)
    p.set_defaults(func=cmd_render)

    p = sub.add_parser("apply", help="校验+渲染+持久化(+重启)")
    p.add_argument("--file", default=ACTIVE)
    p.add_argument("--mode", choices=["dante", "aes67", "off"])
    p.add_argument("--no-restart", action="store_true")
    add_common(p)
    add_render_opts(p)
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("rollback", help="回滚 last-good")
    p.add_argument("--mode", choices=["dante", "aes67", "off"])
    p.add_argument("--no-restart", action="store_true")
    add_common(p)
    add_render_opts(p)
    p.set_defaults(func=cmd_rollback)

    p = sub.add_parser("profiles", help="列出 profiles")
    p.add_argument("--json", action="store_true")
    add_common(p)
    p.set_defaults(func=cmd_profiles)

    p = sub.add_parser("save-profile", help="保存 profile")
    p.add_argument("name")
    p.add_argument("--file", default=None)
    add_common(p)
    p.set_defaults(func=cmd_save_profile)

    p = sub.add_parser("load-profile", help="加载 profile 为 active 并 apply")
    p.add_argument("name")
    p.add_argument("--mode", choices=["dante", "aes67", "off"])
    p.add_argument("--no-restart", action="store_true")
    add_common(p)
    add_render_opts(p)
    p.set_defaults(func=cmd_load_profile)

    p = sub.add_parser("export", help="导出 profile 到 stdout/文件")
    p.add_argument("name")
    p.add_argument("--output", "-o", default="-")
    p.set_defaults(func=cmd_export)

    p = sub.add_parser("import", help="导入 profile")
    p.add_argument("file")
    p.add_argument("--name", required=True)
    add_common(p)
    p.set_defaults(func=cmd_import)

    args = ap.parse_args(argv)
    try:
        return args.func(args)
    except SampleRateError as e:
        sys.stderr.write("ERROR [value] samplerate: %s\n" % e)
        return 3


if __name__ == "__main__":
    sys.exit(main())
