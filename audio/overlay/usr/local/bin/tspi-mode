#!/usr/bin/env bash
# tspi-mode — 音频栈模式切换统一入口（dante | aes67 | b2 | off），以及状态查询
#
# 契约（web-manager 依赖，勿随意改）：
#   tspi-mode dante|aes67|off [--json] [--dry-run] [--force] [--allow-unlocked-ptp]
#                              [--chunksize N] [--target-level N] [--adjust-period N] [--samplerate N]
#   tspi-mode b2 [--json] [--dry-run] [--force] [--allow-unlocked-ptp] [--ptp-only]
#                [--chunksize N] [--target-level N] [--adjust-period N] [--samplerate N]
#   tspi-mode status [--json]        只查询，不改变状态
#   tspi-mode --restore              读 /etc/tspi/last-mode 恢复（供 tspi-boot-mode.service）
#
# 模式：
#   dante = Dante/Inferno（statime 做 PTPv1 follower，需网内 Dante 主钟）
#   aes67 = AES67 B1（aes67-daemon/LKM 做 PTPv2 slave，需网内已有 GM；TSPI_AES67_PTP_ROLE=master
#           只是兼容别名，会转入下面 b2，因为 daemon/LKM 是 slave-only 且截走 PRE_ROUTING）
#   b2    = B2 板端 PTPv2 主时钟：ptp4l masterOnly GM + phc2sys -O 37（TAI），默认再起
#           PHC→usrvclock 桥 + Inferno 接收 + CamillaDSP（不经 RAVENNA LKM/daemon）。
#           --ptp-only 只起 GM 时钟栈（不动音频，适合安全预演/纯供钟）。
#   off   = 全停
#
# 退出码（固定契约，web-manager 依赖）：0 就绪；1 未知错误；2 用法/参数错误；
#   3 前置缺失（二进制/配置/LKM/内核能力）；4 设备未找到（MOTU/RAVENNA/Inferno PCM）；
#   5 PTP 未锁定（B2: GM 未进 MASTER / phc2sys 失败 / PHC 非 TAI）；6 AoIP 流未就绪；
#   7 CamillaDSP 启动失败；8 切换后自检失败（B2: PHC usrvclock 桥未就绪）；9 已回滚到切换前模式；
#   10 另一切换进行中。
#
# 互斥：dante / aes67 / b2 / off 任一时刻只有一个。本脚本负责停旧→起新；自己切自己会重启 DSP。
set -uo pipefail
. /usr/local/lib/tspi/lib.sh
tspi_load_defaults

PROG="tspi-mode"
CMD=""
DRY=0
JSON_OUT=0
FORCE=0
ALLOW_UNLOCKED="${TSPI_ALLOW_UNLOCKED_PTP}"
CHUNKSIZE_OVERRIDE=""
TARGET_LEVEL_OVERRIDE=""
ADJUST_PERIOD_OVERRIDE=""
SAMPLERATE_OVERRIDE=""
PTP_ONLY=0

usage() {
  sed -n "2,27p" "$0" | sed "s/^# \{0,1\}//" >&2
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    dante|aes67|b2|off|status) CMD="$1"; shift ;;
    --restore) CMD="restore"; shift ;;
    --json) JSON_OUT=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --force) FORCE=1; shift ;;
    --allow-unlocked-ptp) ALLOW_UNLOCKED=1; shift ;;
    --ptp-only) PTP_ONLY=1; shift ;;
    --chunksize) CHUNKSIZE_OVERRIDE="$2"; shift 2 ;;
    --target-level) TARGET_LEVEL_OVERRIDE="$2"; shift 2 ;;
    --adjust-period) ADJUST_PERIOD_OVERRIDE="$2"; shift 2 ;;
    --samplerate) SAMPLERATE_OVERRIDE="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    *) echo "unknown argument: $1" >&2; usage 2 ;;
  esac
done
[[ -n "$CMD" ]] || usage 2

# -----------------------------------------------------------------------------
# 状态/配置文件
# -----------------------------------------------------------------------------
CONFIG_FILE="$TSPI_RUN_DIR/config.json"

state_write() { # mode state last_error
  mkdir -p "$TSPI_RUN_DIR"
  jq -n --arg schema "tspi-audio/v1" --arg ts "$(date -Is)" --arg mode "$1" --arg state "$2" --arg err "${3:-}" \
    '{schema:$schema, ts:$ts, mode:$mode, state:$state, last_error:(if $err == "" then null else $err end)}' \
    > "$TSPI_STATE_FILE.tmp" 2>/dev/null && mv -f "$TSPI_STATE_FILE.tmp" "$TSPI_STATE_FILE" || true
}

config_write() { # samplerate chunksize target adjust cap_dev cap_fmt cap_ch pb_dev pb_fmt pb_ch ptp_role
  mkdir -p "$TSPI_RUN_DIR"
  jq -n --arg mode "${1}" --argjson samplerate "${2:-0}" --argjson chunksize "${3:-0}" \
    --argjson target_level "${4:-0}" --argjson adjust_period "${5:-0}" \
    --arg capture_device "${6:-}" --arg capture_format "${7:-}" --argjson capture_channels "${8:-0}" \
    --arg playback_device "${9:-}" --arg playback_format "${10:-}" --argjson playback_channels "${11:-0}" \
    --arg ptp_role "${12:-}" \
    '{mode:$mode, samplerate:$samplerate, chunksize:$chunksize, target_level:$target_level,
      adjust_period:$adjust_period, capture_device:$capture_device, capture_format:$capture_format,
      capture_channels:$capture_channels, playback_device:$playback_device,
      playback_format:$playback_format, playback_channels:$playback_channels, ptp_role:$ptp_role}' \
    > "$CONFIG_FILE.tmp" 2>/dev/null && mv -f "$CONFIG_FILE.tmp" "$CONFIG_FILE" || true
}

# -----------------------------------------------------------------------------
# 基础动作
# -----------------------------------------------------------------------------
svc_stop() { systemctl stop "$1" 2>/dev/null || true; }

wait_inactive() {
  local svc="$1" timeout="${2:-8}" i=0
  while (( i < timeout * 2 )); do
    systemctl is-active --quiet "$svc" 2>/dev/null || return 0
    sleep 0.5; i=$((i+1))
  done
  return 1
}

stop_all() {
  [[ "$DRY" == 1 ]] && { echo "DRY: stop all audio units"; return 0; }
  # 顺序：先 autodetect/DSP，再 AoIP（daemon 依赖 LKM），最后 PTP；LKM 最后卸载
  svc_stop tspi-upmix-autodetect.service
  svc_stop tspi-camilladsp.service
  wait_inactive tspi-camilladsp.service 8 || true
  svc_stop tspi-aes67-daemon.service
  wait_inactive tspi-aes67-daemon.service 8 || true
  # B2：先停 media clock 桥（socket 与 Inferno/CamillaDSP 共享），再停 GM 时钟栈
  svc_stop tspi-phc-usrvclock.service
  wait_inactive tspi-phc-usrvclock.service 5 || true
  svc_stop tspi-ptp4l-master.service
  svc_stop tspi-phc2sys.service
  svc_stop tspi-statime-inferno.service
  svc_stop tspi-ravenna-lkm.service
  wait_inactive tspi-ravenna-lkm.service 8 || true
  svc_stop tspi-audio.target
  rm -f "$TSPI_RUN_DIR"/active-dante "$TSPI_RUN_DIR"/active-aes67 "$TSPI_RUN_DIR"/active-aes67-master
  # 运行期标记/残留 socket：桥或 statime 退出后可能留下 usrvclock 文件，必须清掉避免被误当成就绪
  rm -f "$TSPI_RUN_DIR"/b2-audio
  rm -f /tmp/ptp-usrvclock
  rm -f "$TSPI_LOCK_FILE"
  return 0
}

# -----------------------------------------------------------------------------
# 渲染配置
# -----------------------------------------------------------------------------

# 解析 MOTU 卡序号并探测播放能力；输出全局 PB_CH / PB_FMT / MOTU_PCM
prepare_motu() {
  local idx
  idx="$(tspi_card_index "$TSPI_MOTU_CARD_ID" "UltraLite")"
  if [[ -z "$idx" ]]; then
    ERR="MOTU UltraLite-mk5 未找到（/proc/asound/cards 无 $TSPI_MOTU_CARD_ID/UltraLite）"
    return 4
  fi
  MOTU_PCM="hw:$idx,0"
  local probe chmin chmax fmts
  probe="$(tspi_probe_pcm playback "$idx" 0 || true)"
  if [[ -n "$probe" ]]; then
    read -r chmin chmax fmts <<<"$probe"
    if [[ -n "$chmax" && "$chmax" -ge "${TSPI_CHANNELS:-2}" ]]; then
      PB_CH="$chmax"
      [[ "$PB_CH" -gt "${TSPI_MAX_PLAYBACK_CHANNELS:-22}" ]] && PB_CH="${TSPI_MAX_PLAYBACK_CHANNELS:-22}"
    else
      ERR="MOTU 播放通道不足：设备 CHANNELS=$chmin-$chmax，需要 >= $TSPI_CHANNELS"
      return 4
    fi
    if [[ " $fmts " == *" S24_3LE "* ]]; then PB_FMT="S24_3_LE"
    elif [[ " $fmts " == *" S32_LE "* ]]; then PB_FMT="S32_LE"; WARNINGS+="MOTU 不支持 S24_3LE，回落 S32_LE; "
    else
      local f; f="$(tspi_camilla_format "$(echo "$fmts" | awk '{print $1}')")"
      [[ -n "$f" ]] || { ERR="MOTU 无可用 24/32bit 整数格式（FORMAT: $fmts）"; return 4; }
      PB_FMT="$f"; WARNINGS+="MOTU 24bit packed 不可用，回落 $f; "
    fi
  else
    PB_CH="${TSPI_MAX_PLAYBACK_CHANNELS:-22}"; PB_FMT="S24_3_LE"
    WARNINGS+="无法探测 MOTU hw params（设备忙?），按默认 ${PB_CH}ch/${PB_FMT} 渲染; "
  fi
  # 5.3.2 布局要求硬件 playback 通道 >= 10（信号映射到 0..9，其余补零）
  if [[ "${PB_CH:-0}" -lt "${TSPI_OUTPUTS:-10}" ]]; then
    ERR="MOTU 播放通道 ${PB_CH} < ${TSPI_OUTPUTS:-10}（5.3.2 布局需要至少 10 路；请检查 96k 下的通道数）"
    return 4
  fi
  return 0
}

render_camilladsp() { # mode  (读取全局 TSPI_* 与 override)
  local mode="$1" tpl sr chunk target adjust cap_dev cap_fmt cap_ch
  WARNINGS=""
  case "$mode" in
    dante)
      sr="${SAMPLERATE_OVERRIDE:-$TSPI_DANTE_SAMPLERATE}"
      chunk="${CHUNKSIZE_OVERRIDE:-$TSPI_DANTE_CHUNKSIZE}"
      target="${TARGET_LEVEL_OVERRIDE:-$TSPI_DANTE_TARGET_LEVEL}"
      cap_dev="inferno"; cap_fmt="S32_LE"; cap_ch="${TSPI_CHANNELS}"
      tpl="/etc/camilladsp/dante.yml"
      ;;
    aes67)
      sr="${SAMPLERATE_OVERRIDE:-$TSPI_AES67_SAMPLERATE}"
      chunk="${CHUNKSIZE_OVERRIDE:-$TSPI_AES67_CHUNKSIZE}"
      target="${TARGET_LEVEL_OVERRIDE:-$TSPI_AES67_TARGET_LEVEL}"
      RA_CARD="$(tspi_card_index "$TSPI_RAVENNA_CARD_ID" "RAVENNA")"
      [[ -n "$RA_CARD" ]] || { ERR="RAVENNA ALSA 卡未出现（LKM 未加载？）"; return 4; }
      cap_dev="hw:$RA_CARD,0"; cap_fmt="S32_LE"; cap_ch="${TSPI_CHANNELS}"
      tpl="/etc/camilladsp/aes67.yml"
      ;;
    b2)
      # B2：本机是 PTPv2 GM，没有 PTP slave 可给 Inferno；媒体时钟来自 PHC usrvclock 桥。
      # 接收端仍是 Inferno ALSA 插件（与 dante 同为 S32_LE/named PCM），采样率默认 AES67 48k，
      # 可用 --samplerate 覆盖（B2/H16 的真实采样率口径仍未实测，见 evidence/b2-mode/REPORT.md）。
      sr="${SAMPLERATE_OVERRIDE:-$TSPI_AES67_SAMPLERATE}"
      chunk="${CHUNKSIZE_OVERRIDE:-$TSPI_AES67_CHUNKSIZE}"
      target="${TARGET_LEVEL_OVERRIDE:-$TSPI_AES67_TARGET_LEVEL}"
      cap_dev="inferno"; cap_fmt="S32_LE"; cap_ch="${TSPI_CHANNELS}"
      tpl="/etc/camilladsp/dante.yml"   # Inferno capture 模板；title/description 在下面按 b2 改写
      ;;
    *) ERR="render_camilladsp: bad mode $mode"; return 3 ;;
  esac
  adjust="${ADJUST_PERIOD_OVERRIDE:-$TSPI_ADJUST_PERIOD}"
  # 只给了 --chunksize 时按 4x 自动定 target_level（否则沿用默认值可能与新 chunk 不匹配）
  if [[ -n "$CHUNKSIZE_OVERRIDE" && -z "$TARGET_LEVEL_OVERRIDE" ]]; then
    target=$((chunk * 4))
  fi
  prepare_motu || return $?
  [[ -f "$tpl" ]] || { ERR="缺少配置模板: $tpl"; return 3; }

  sed -e "s/__SAMPLERATE__/$sr/g" \
      -e "s/__CHUNKSIZE__/$chunk/g" \
      -e "s/__TARGET_LEVEL__/$target/g" \
      -e "s/__ADJUST_PERIOD__/$adjust/g" \
      -e "s/__CAPTURE_CHANNELS__/$cap_ch/g" \
      -e "s#__CAPTURE_DEVICE__#$cap_dev#g" \
      -e "s/__CAPTURE_FORMAT__/$cap_fmt/g" \
      -e "s/__PLAYBACK_CHANNELS__/$PB_CH/g" \
      -e "s#__PLAYBACK_DEVICE__#$MOTU_PCM#g" \
      -e "s/__PLAYBACK_FORMAT__/$PB_FMT/g" \
      "$tpl" > "$TSPI_RUN_DIR/camilladsp.yml" || { ERR="渲染 camilladsp.yml 失败"; return 3; }
  if [[ "$mode" == "b2" ]]; then
    sed -i -e 's/^title: .*/title: "tspi audio - B2 (board PTPv2 GM + Inferno PHC clock)"/' \
           -e 's/^description: .*/description: "ptp4l GM + phc2sys TAI -> PHC usrvclock -> Inferno ALSA (S32_LE) -> CamillaDSP -> MOTU 5.3.2"/' \
           "$TSPI_RUN_DIR/camilladsp.yml" || { ERR="改写 b2 camilladsp.yml 标题失败"; return 3; }
  fi

  if command -v camilladsp >/dev/null 2>&1; then
    if ! camilladsp --check "$TSPI_RUN_DIR/camilladsp.yml" >"$TSPI_RUN_DIR/camilladsp-check.log" 2>&1; then
      ERR="camilladsp --check 失败：$(tail -3 "$TSPI_RUN_DIR/camilladsp-check.log" | tr "\n" " ")"; return 3
    fi
  fi

  # Inferno 环境（dante/b2 都需要：B2 的 CLOCK_PATH 指向 PHC usrvclock 桥而不是 statime）
  : > "$TSPI_RUN_DIR/camilladsp.env"
  printf "TSPI_CAMILLADSP_PORT=%s\nTSPI_CAMILLADSP_BIND=%s\n" "$TSPI_CAMILLADSP_PORT" "$TSPI_CAMILLADSP_BIND" >> "$TSPI_RUN_DIR/camilladsp.env"
  if [[ "$mode" == "dante" || "$mode" == "b2" ]]; then
    local devid="$TSPI_INFERNO_DEVICE_ID"
    if [[ "$devid" == "auto" ]]; then
      devid="$(tr -d ":" < "/sys/class/net/$TSPI_IFACE/address" 2>/dev/null | tr "A-F" "a-f")0000"
      [[ "$devid" =~ ^[0-9a-f]{16}$ ]] || devid="0000000000000001"
    fi
    {
      echo "INFERNO_NAME=$TSPI_INFERNO_NAME"
      echo "INFERNO_DEVICE_ID=$devid"
      echo "INFERNO_BIND_IP=$TSPI_IFACE"
      echo "INFERNO_SAMPLE_RATE=$sr"
      echo "INFERNO_RX_CHANNELS=$cap_ch"
      echo "INFERNO_TX_CHANNELS=0"
      echo "INFERNO_CLOCK_PATH=/tmp/ptp-usrvclock"
      echo "INFERNO_RX_LATENCY_NS=$TSPI_RX_LATENCY_NS"
      echo "INFERNO_TX_LATENCY_NS=$TSPI_TX_LATENCY_NS"
    } >> "$TSPI_RUN_DIR/camilladsp.env"
  fi

  local ptp_role=""
  case "$mode" in
    dante) ptp_role="slave" ;;
    b2)    ptp_role="master" ;;
  esac
  config_write "$mode" "$sr" "$chunk" "$target" "$adjust" "$cap_dev" "$cap_fmt" "$cap_ch" "$MOTU_PCM" "$PB_FMT" "$PB_CH" \
    "$ptp_role" 2>/dev/null || true
  # aes67 的 ptp_role 由 /etc/default 的 TSPI_AES67_PTP_ROLE 决定（slave=B1；master 会转入 b2）
  if [[ "$mode" == "aes67" ]]; then
    jq --arg role "${TSPI_AES67_PTP_ROLE:-slave}" '.ptp_role=$role' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null && mv -f "$CONFIG_FILE.tmp" "$CONFIG_FILE" || true
  fi
  # 5.3.2 布局元数据（status JSON / web-manager 用）
  jq --arg layout "${TSPI_LAYOUT:-5.3.2}" --argjson outputs "${TSPI_OUTPUTS:-10}" \
    '.layout=$layout | .outputs=$outputs' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null \
    && mv -f "$CONFIG_FILE.tmp" "$CONFIG_FILE" || true
  return 0
}

render_statime() {
  local tpl="/etc/statime/inferno-ptpv1.toml"
  [[ -f "$tpl" ]] || { ERR="缺少 $tpl"; return 3; }
  sed -e "s/__IFACE__/$TSPI_IFACE/g" "$tpl" > "$TSPI_RUN_DIR/statime.toml" || { ERR="渲染 statime.toml 失败"; return 3; }
  return 0
}

render_daemon_conf() {
  local tpl="/etc/aes67-daemon/daemon.conf"
  [[ -f "$tpl" ]] || { ERR="缺少 $tpl"; return 3; }
  sed -e "s/__IFACE__/$TSPI_IFACE/g" "$tpl" > "$TSPI_RUN_DIR/aes67-daemon.conf" || { ERR="渲染 aes67-daemon.conf 失败"; return 3; }
  return 0
}

# -----------------------------------------------------------------------------
# 等待就绪
# -----------------------------------------------------------------------------
wait_ptp_lock() {
  local timeout="${TSPI_WAIT_PTP_SECS:-20}" i=0 lock
  while (( i < timeout * 2 )); do
    lock="$(tspi-ptp-status --json 2>/dev/null | jq -r '.lock // "null"' 2>/dev/null || echo null)"
    [[ "$lock" == "true" ]] && return 0
    sleep 0.5; i=$((i+1))
  done
  ERR="PTP 在 ${timeout}s 内未锁定（当前状态：$(tspi-ptp-status --json 2>/dev/null | jq -r '.lock_raw // "unknown"' 2>/dev/null)）"
  return 1
}

# -----------------------------------------------------------------------------
# B2：板端 PTP 主时钟（ptp4l GM + phc2sys）+ PHC usrvclock 桥
# -----------------------------------------------------------------------------

# PHC 字符设备：TSPI_PHC_DEV 显式指定 > sysfs(网卡→ptp) > 唯一 /dev/ptp* > /dev/ptp0。
# 探测顺序与 /usr/local/lib/tspi/phc-usrvclock 保持一致；找不到输出空串。
phc_dev() {
  local d="${TSPI_PHC_DEV:-}" g
  [[ -n "$d" ]] && { echo "$d"; return 0; }
  for g in "/sys/class/net/$TSPI_IFACE/ptp/ptp*" "/sys/class/net/$TSPI_IFACE/device/ptp/ptp*"; do
    d="$(compgen -G "$g" 2>/dev/null | head -1)"
    [[ -n "$d" ]] && { echo "/dev/$(basename "$d")"; return 0; }
  done
  local all=(/dev/ptp*)
  if [[ -e "${all[0]}" ]]; then
    if (( ${#all[@]} == 1 )); then echo "${all[0]}"; else echo "/dev/ptp0"; fi
    return 0
  fi
  echo ""
}

# 一次 pmc 查询（UDS；pmc/超时/无输出都返回空）。pmc 不在 PATH 时退回 /usr/sbin/pmc。
gm_pmc() {
  local pmc_bin; pmc_bin="$(command -v pmc 2>/dev/null || { [[ -x /usr/sbin/pmc ]] && echo /usr/sbin/pmc; })"
  [[ -n "$pmc_bin" ]] || return 0
  timeout 5 "$pmc_bin" -s /run/ptp4l/uds -u -b 0 "$1" 2>/dev/null || true
}

# 端口状态（MASTER/SLAVE/LISTENING/...）。pmc 不可用时回退 journal 关键字；未知输出空串。
gm_port_state() {
  local out
  out="$(gm_pmc 'GET PORT_DATA_SET')"
  if [[ -n "$out" ]]; then
    printf "%s\n" "$out" | sed -n 's/^[[:space:]]*portState[[:space:]]\{1,\}\([A-Z_]*\).*/\1/p' | head -1
    return 0
  fi
  if command -v journalctl >/dev/null 2>&1; then
    if journalctl -u tspi-ptp4l-master.service --no-pager -n 80 2>/dev/null | grep -q "assuming the grand master role"; then
      echo MASTER; return 0
    fi
  fi
  echo ""
}

# GM 自身 clockIdentity（PORT_DATA_SET.portIdentity 的 clock 部分；pmc 不可用则空）
gm_identity() {
  local out
  out="$(gm_pmc 'GET PORT_DATA_SET')"
  [[ -n "$out" ]] || { echo ""; return 0; }
  printf "%s\n" "$out" | sed -n 's/^[[:space:]]*portIdentity[[:space:]]\{1,\}\([0-9a-fA-F.]*\)-[0-9][0-9]*.*/\1/p' | head -1
}

# 等 ptp4l 进入 MASTER（GM 就绪）。超时返回 5（--allow-unlocked-ptp 时降级为 warning）。
wait_gm_master() {
  local timeout="${TSPI_WAIT_PTP_SECS:-20}" i=0 st=""
  while (( i < timeout * 2 )); do
    tspi_svc_active tspi-ptp4l-master.service \
      || { ERR="ptp4l GM 服务未运行（journalctl -u tspi-ptp4l-master 查看）"; return 5; }
    st="$(gm_port_state)"
    [[ "$st" == "MASTER" ]] && return 0
    sleep 0.5; i=$((i+1))
  done
  ERR="PTP GM 在 ${timeout}s 内未进入 MASTER（当前 ${st:-unknown}）"
  [[ "$ALLOW_UNLOCKED" == 1 ]] && { tspi_warn "$ERR（--allow-unlocked-ptp 继续）"; return 0; }
  return 5
}

# PHC 工具路径（phc_ctl 属于 linuxptp 包，通常 /usr/sbin；不在 PATH 时退回绝对路径）。
phc_ctl_bin() {
  command -v phc_ctl 2>/dev/null || { [[ -x /usr/sbin/phc_ctl ]] && echo /usr/sbin/phc_ctl; } || true
}

# PHC(TAI) − CLOCK_REALTIME（秒，3 位小数）；phc_ctl 缺失/解析失败输出空串。
phc_minus_realtime() {
  local dev="$1" phc_t ts ctl
  ctl="$(phc_ctl_bin)"
  [[ -n "$ctl" ]] || return 1
  phc_t="$(timeout 3 "$ctl" "$dev" get 2>/dev/null | sed -n 's/.*clock time is \([0-9][0-9]*\.[0-9]*\).*/\1/p' | head -1)"
  [[ -n "$phc_t" ]] || return 1
  ts="$(date +%s.%N)"
  awk -v p="$phc_t" -v t="$ts" 'BEGIN{printf "%.3f", p-t}'
}

# 自检 GM 时标：PHC 必须 ≈ CLOCK_REALTIME + TAI 偏移（-O 37；闰秒变化时改 TSPI_GM_TAI_OFFSET）。
# 不做/失败时按 5（PTP 未就绪）失败；--allow-unlocked-ptp 降级为 warning。
wait_phc_tai() {
  local dev want="${TSPI_GM_TAI_OFFSET:-37}" i=0 delta="" retries="${TSPI_GM_TAI_RETRIES:-10}"
  dev="$(phc_dev)"
  [[ -n "$dev" ]] || { tspi_warn "未找到 PHC 设备（/dev/ptp*），跳过 TAI 自检"; return 0; }
  [[ -n "$(phc_ctl_bin)" ]] || { tspi_warn "缺少 phc_ctl，跳过 TAI 自检"; return 0; }
  (( retries > 0 )) || retries=1
  while (( i < retries )); do
    delta="$(phc_minus_realtime "$dev" 2>/dev/null || true)"
    if [[ -n "$delta" ]] && awk -v d="$delta" -v w="$want" 'BEGIN{x=d-w; if(x<0)x=-x; exit !(x<=5)}'; then
      tspi_log "B2: PHC($dev) 比系统时钟快 ${delta}s ≈ TAI 偏移 ${want}s"
      return 0
    fi
    sleep 1; i=$((i+1))
  done
  ERR="PHC 与系统时钟差 ${delta:-?}s，期望 TAI 偏移 ${want}s（phc2sys -O 37 未生效？）"
  [[ "$ALLOW_UNLOCKED" == 1 ]] && { tspi_warn "$ERR（--allow-unlocked-ptp 继续）"; return 0; }
  return 5
}

# 等 PHC usrvclock 桥就绪：unit active 且 socket 文件存在（桥先测频后 bind，约 4 s）。
wait_usrvclock_bridge() {
  local sock="/tmp/ptp-usrvclock" timeout="${TSPI_WAIT_BRIDGE_SECS:-15}" i=0 st
  while (( i < timeout * 2 )); do
    if tspi_svc_active tspi-phc-usrvclock.service && [[ -e "$sock" ]]; then return 0; fi
    st="$(systemctl is-active tspi-phc-usrvclock.service 2>/dev/null || true)"
    [[ "$st" == "failed" ]] \
      && { ERR="PHC usrvclock 桥启动失败（journalctl -u tspi-phc-usrvclock 查看）"; return 8; }
    sleep 0.5; i=$((i+1))
  done
  ERR="PHC usrvclock 桥在 ${timeout}s 内未就绪（socket=$sock；journalctl -u tspi-phc-usrvclock）"
  return 8
}

start_input_autodetect() {
  # 输入内容模式 autodetect（可选）：只读 CamillaDSP websocket RMS，不重启音频、不占声卡。
  # unit 不存在或 CLI 缺失时静默跳过（非致命）；覆盖优先级在 CLI 内处理。
  [[ "$DRY" == 1 ]] && return 0
  systemctl list-unit-files tspi-upmix-autodetect.service >/dev/null 2>&1 || return 0
  command -v tspi-upmix >/dev/null 2>&1 || return 0
  systemctl reset-failed tspi-upmix-autodetect.service 2>/dev/null || true
  systemctl start tspi-upmix-autodetect.service 2>/dev/null \
    || tspi_warn "input autodetect 启动失败（非致命；tspi-mode status 可查）"
  return 0
}

verify_camilladsp() {
  [[ "$DRY" == 1 ]] && { echo "DRY: start tspi-camilladsp + verify ${TSPI_VERIFY_SECS}s"; return 0; }
  systemctl reset-failed tspi-camilladsp.service 2>/dev/null || true
  systemctl start tspi-camilladsp.service || { ERR="systemctl start tspi-camilladsp 失败"; return 1; }
  sleep "${TSPI_VERIFY_SECS:-3}"
  if ! tspi_svc_active tspi-camilladsp.service; then
    ERR="CamillaDSP 启动后退出（journalctl -u tspi-camilladsp 查看）"
    return 1
  fi
  start_input_autodetect
  return 0
}

# -----------------------------------------------------------------------------
# 起模式
# -----------------------------------------------------------------------------
require_bin() { [[ -x "$1" ]] || { ERR="缺少可执行文件 $1（构建/安装未完成）"; return 1; }; }

start_dante() {
  require_bin /usr/local/bin/camilladsp || return 3
  require_bin /usr/local/bin/statime || return 3
  [[ -n "$(ls /usr/lib/aarch64-linux-gnu/alsa-lib/libasound_module_pcm_inferno*.so 2>/dev/null)" ]] \
    || { ERR="缺少 Inferno ALSA 插件（libasound_module_pcm_inferno.so）"; return 3; }
  ip link show dev "$TSPI_IFACE" >/dev/null 2>&1 || { ERR="网卡不存在: $TSPI_IFACE"; return 3; }

  render_statime || return "$?"
  render_camilladsp dante || return "$?"
  [[ -n "$WARNINGS" ]] && tspi_warn "$WARNINGS"
  tspi_log "Dante: sr=${SAMPLERATE_OVERRIDE:-$TSPI_DANTE_SAMPLERATE} chunksize=${CHUNKSIZE_OVERRIDE:-$TSPI_DANTE_CHUNKSIZE} motu=$MOTU_PCM(${PB_CH}ch/$PB_FMT)"

  if [[ "$DRY" == 1 ]]; then
    echo "DRY: dante plan: statime(/run/tspi/statime.toml) -> camilladsp($MOTU_PCM, ${PB_CH}ch, $PB_FMT)";
    return 0
  fi

  mkdir -p "$TSPI_RUN_DIR"
  echo dante > "$TSPI_MODE_FILE"
  touch "$TSPI_RUN_DIR/active-dante"
  systemctl reset-failed tspi-statime-inferno.service 2>/dev/null || true
  systemctl start tspi-audio.target 2>/dev/null || true
  systemctl start tspi-statime-inferno.service || { ERR="statime 启动失败"; return 8; }
  tspi_wait_svc tspi-statime-inferno.service 5 || { ERR="statime 未能 active"; return 8; }
  if ! wait_ptp_lock; then
    [[ "$ALLOW_UNLOCKED" == 1 ]] && tspi_warn "$ERR（--allow-unlocked-ptp 继续）" || return 5
  fi
  verify_camilladsp || return 7
  return 0
}

start_aes67() {
  if [[ "${TSPI_AES67_PTP_ROLE:-slave}" != "slave" ]]; then
    ERR="AES67 PTP 角色=${TSPI_AES67_PTP_ROLE}：B2/B3（本机 ptp4l GM）与 aes67-daemon 不兼容（LKM 只收 PRE_ROUTING、且 PTP slave-only），见 RISKS-AND-DECISIONS.md D1"
    return 3
  fi
  require_bin /usr/local/bin/camilladsp || return 3
  require_bin /usr/local/bin/aes67-daemon || return 3
  [[ -f "/lib/modules/$(uname -r)/extra/MergingRavennaALSA.ko" ]] \
    || { ERR="缺少内核模块 /lib/modules/$(uname -r)/extra/MergingRavennaALSA.ko（目标内核版本不匹配？）"; return 3; }
  command -v modprobe >/dev/null 2>&1 || { ERR="缺少 modprobe"; return 3; }
  ip link show dev "$TSPI_IFACE" >/dev/null 2>&1 || { ERR="网卡不存在: $TSPI_IFACE"; return 3; }

  render_daemon_conf || return "$?"

  if [[ "$DRY" == 1 ]]; then
    echo "DRY: aes67 plan: modprobe MergingRavennaALSA -> aes67-daemon(/run/tspi/aes67-daemon.conf) -> camilladsp(hw:RAVENNA -> $TSPI_MOTU_CARD_ID)";
    return 0
  fi

  mkdir -p "$TSPI_RUN_DIR"
  echo aes67 > "$TSPI_MODE_FILE"
  touch "$TSPI_RUN_DIR/active-aes67"
  systemctl reset-failed tspi-ravenna-lkm.service tspi-aes67-daemon.service 2>/dev/null || true
  systemctl start tspi-audio.target 2>/dev/null || true
  systemctl start tspi-ravenna-lkm.service || { ERR="modprobe MergingRavennaALSA 失败"; return 3; }
  if ! tspi_wait_card "$TSPI_RAVENNA_CARD_ID" "RAVENNA" "${TSPI_WAIT_DEVICE_SECS:-10}"; then
    ERR="RAVENNA ALSA 卡未出现（modprobe 后 /proc/asound/cards 无 ravenna）"; return 4
  fi
  render_camilladsp aes67 || return "$?"
  [[ -n "$WARNINGS" ]] && tspi_warn "$WARNINGS"
  tspi_log "AES67: sr=${SAMPLERATE_OVERRIDE:-$TSPI_AES67_SAMPLERATE} chunksize=${CHUNKSIZE_OVERRIDE:-$TSPI_AES67_CHUNKSIZE} capture=hw:${RA_CARD},0 motu=$MOTU_PCM(${PB_CH}ch/$PB_FMT)"

  systemctl start tspi-aes67-daemon.service || { ERR="aes67-daemon 启动失败"; return 8; }
  tspi_wait_svc tspi-aes67-daemon.service 15 || { ERR="aes67-daemon 未能 active"; return 8; }
  if ! wait_ptp_lock; then
    [[ "$ALLOW_UNLOCKED" == 1 ]] && tspi_warn "$ERR（--allow-unlocked-ptp 继续）" || return 5
  fi
  verify_camilladsp || return 7
  return 0
}

start_b2() {
  # 板端 GM：ptp4l masterOnly + phc2sys -O 37；默认再接 PHC usrvclock 桥 + Inferno + CamillaDSP。
  # --ptp-only 只起 GM 时钟栈（不开声卡、不播放），用于安全预演/纯供钟。
  require_bin /usr/sbin/ptp4l || return 3
  require_bin /usr/sbin/phc2sys || return 3
  [[ -f /etc/ptp4l-master-aes67.conf ]] \
    || { ERR="缺少 /etc/ptp4l-master-aes67.conf（linuxptp GM 配置）"; return 3; }
  ip link show dev "$TSPI_IFACE" >/dev/null 2>&1 || { ERR="网卡不存在: $TSPI_IFACE"; return 3; }
  local phc; phc="$(phc_dev)"
  [[ -n "$phc" ]] || tspi_warn "未找到 PHC 设备（TSPI_PHC_DEV/sysfs//dev/ptp*）：GM 仍可启动，TAI 自检会跳过"

  local sr="" chunk="" target="" audio=1
  [[ "$PTP_ONLY" == 1 ]] && audio=0
  if [[ "$audio" == 1 ]]; then
    require_bin /usr/local/bin/camilladsp || return 3
    [[ -n "$(ls /usr/lib/aarch64-linux-gnu/alsa-lib/libasound_module_pcm_inferno*.so 2>/dev/null)" ]] \
      || { ERR="缺少 Inferno ALSA 插件（libasound_module_pcm_inferno.so）"; return 3; }
    render_camilladsp b2 || return "$?"
    [[ -n "$WARNINGS" ]] && tspi_warn "$WARNINGS"
    sr="${SAMPLERATE_OVERRIDE:-$TSPI_AES67_SAMPLERATE}"
    chunk="${CHUNKSIZE_OVERRIDE:-$TSPI_AES67_CHUNKSIZE}"
  fi

  tspi_log "B2: ptp_role=master(grandmaster) iface=$TSPI_IFACE phc=${phc:-auto} $( [[ "$audio" == 1 ]] && echo "audio=sr=$sr/chunk=$chunk motu=$MOTU_PCM(${PB_CH}ch/$PB_FMT)" || echo "ptp-only" )"

  if [[ "$DRY" == 1 ]]; then
    echo "DRY: b2 plan: ptp4l GM -H -i $TSPI_IFACE -f /etc/ptp4l-master-aes67.conf -m -> phc2sys -s CLOCK_REALTIME -c $TSPI_IFACE -O ${TSPI_GM_TAI_OFFSET:-37} -m"
    if [[ "$audio" == 1 ]]; then
      echo "DRY: b2 audio plan: tspi-phc-usrvclock(/tmp/ptp-usrvclock) -> inferno capture -> camilladsp($MOTU_PCM, ${PB_CH}ch, $PB_FMT, sr=$sr)"
    else
      echo "DRY: b2 ptp-only: 不起 PHC usrvclock 桥 / Inferno capture / CamillaDSP（不打开任何声卡）"
    fi
    return 0
  fi

  mkdir -p "$TSPI_RUN_DIR"
  echo b2 > "$TSPI_MODE_FILE"
  touch "$TSPI_RUN_DIR/active-aes67-master"
  if [[ "$audio" == 1 ]]; then echo 1 > "$TSPI_RUN_DIR/b2-audio"; else echo 0 > "$TSPI_RUN_DIR/b2-audio"; fi
  systemctl reset-failed tspi-ptp4l-master.service tspi-phc2sys.service tspi-phc-usrvclock.service 2>/dev/null || true
  systemctl start tspi-audio.target 2>/dev/null || true
  systemctl start tspi-ptp4l-master.service || { ERR="ptp4l GM 启动失败（journalctl -u tspi-ptp4l-master 查看）"; return 5; }
  wait_gm_master || return "$?"
  systemctl start tspi-phc2sys.service || { ERR="phc2sys 启动失败（journalctl -u tspi-phc2sys 查看）"; return 5; }
  tspi_wait_svc tspi-phc2sys.service 5 || { ERR="phc2sys 未能 active"; return 5; }
  wait_phc_tai || return "$?"
  if [[ "$audio" == 0 ]]; then return 0; fi
  systemctl start tspi-phc-usrvclock.service || { ERR="PHC usrvclock 桥启动失败"; return 8; }
  wait_usrvclock_bridge || return "$?"
  verify_camilladsp || return 7
  return 0
}

start_mode() {
  case "$1" in
    dante) start_dante ;;
    aes67) start_aes67 ;;
    b2) start_b2 ;;
    *) ERR="unknown mode $1"; return 2 ;;
  esac
}

# -----------------------------------------------------------------------------
# 切换/回滚
# -----------------------------------------------------------------------------
do_off() {
  tspi_log "切换到 off（全停）"
  [[ "$DRY" == 1 ]] && { echo "DRY: off (stop all audio units)"; exit 0; }
  stop_all
  : > "$TSPI_MODE_FILE"
  rm -f "$TSPI_MODE_FILE"
  echo off > /etc/tspi/last-mode 2>/dev/null || true
  state_write off off ""
  [[ "$JSON_OUT" == 1 ]] && do_status
  exit 0
}

# b2 运行态变体：audio=1（GM+Inferno+DSP）/ audio=0（--ptp-only，仅 GM 时钟栈）。
# 记在 /run/tspi/b2-audio，供 status 与「b2 全量 ↔ --ptp-only 互切」判断用。
b2_audio_flag() { cat "$TSPI_RUN_DIR/b2-audio" 2>/dev/null || echo 1; }

b2_running() { # PTP_ONLY 目标变体是否已完整就绪
  if [[ "${PTP_ONLY:-0}" == 1 ]]; then
    tspi_svc_active tspi-ptp4l-master.service && tspi_svc_active tspi-phc2sys.service \
      && [[ "$(b2_audio_flag)" == "0" ]]
  else
    tspi_svc_active tspi-ptp4l-master.service && tspi_svc_active tspi-phc2sys.service \
      && tspi_svc_active tspi-phc-usrvclock.service && tspi_svc_active tspi-camilladsp.service \
      && [[ "$(b2_audio_flag)" == "1" ]]
  fi
}

do_transition() {
  local target="$1"
  local prev; prev="$(cat "$TSPI_MODE_FILE" 2>/dev/null || echo off)"
  local prev_b2_audio; prev_b2_audio="$(b2_audio_flag)"
  ERR=""

  # 指定了调参（chunksize 等）时即使同模式也要重启 DSP；--force 同理
  local tuning_changed=0
  [[ -n "$CHUNKSIZE_OVERRIDE" || -n "$TARGET_LEVEL_OVERRIDE" || -n "$ADJUST_PERIOD_OVERRIDE" || -n "$SAMPLERATE_OVERRIDE" ]] && tuning_changed=1
  # b2 的 --ptp-only 变体切换：GM-only 与全量是不同的运行态，必须重启（即便模式 token 相同）
  local variant_changed=0
  if [[ "$target" == "b2" ]]; then
    local want_audio=1; [[ "$PTP_ONLY" == 1 ]] && want_audio=0
    [[ "$prev_b2_audio" != "$want_audio" ]] && variant_changed=1
  fi
  if [[ "$target" == "$prev" && "$FORCE" != 1 && "$tuning_changed" == 0 && "$variant_changed" == 0 ]]; then
    # 已在该模式：运行态完整则直接成功，否则重启该模式
    local already=0
    if [[ "$target" == "b2" ]]; then
      b2_running && already=1
    elif tspi_svc_active tspi-camilladsp.service; then
      already=1
    fi
    if [[ "$already" == 1 ]]; then
      tspi_log "已处于 $target 且运行态完整（幂等）"
      state_write "$target" active ""
      [[ "$JSON_OUT" == 1 ]] && do_status
      exit 0
    fi
    tspi_warn "已处于 $target 但运行态不完整，重启该模式"
  fi

  tspi_log "模式切换: $prev -> $target（DRY=$DRY）"
  [[ "$DRY" == 0 ]] && state_write "$target" transitioning ""
  stop_all
  local rc=0
  start_mode "$target" || rc=$?

  if [[ "$rc" -ne 0 ]]; then
    tspi_warn "目标模式 $target 失败（rc=$rc）：$ERR"
    if [[ "$DRY" == 0 && "${TSPI_ROLLBACK:-1}" == 1 && "$prev" != "off" && "$prev" != "$target" ]]; then
      tspi_log "回滚到 $prev …"
      stop_all
      local rc2=0
      local saved_ptp_only="$PTP_ONLY"
      # 回滚到 b2 时恢复切换前的变体（全量/--ptp-only），而不是本次请求的变体
      if [[ "$prev" == "b2" ]]; then
        if [[ "$prev_b2_audio" == "1" ]]; then PTP_ONLY=0; else PTP_ONLY=1; fi
      fi
      start_mode "$prev" || rc2=$?
      PTP_ONLY="$saved_ptp_only"
      if [[ "$rc2" -eq 0 ]]; then
        echo "$prev" > "$TSPI_MODE_FILE"
        echo "$prev" > /etc/tspi/last-mode 2>/dev/null || true
        state_write "$prev" active "切换到 $target 失败，已回滚（$ERR）"
        [[ "$JSON_OUT" == 1 ]] && do_status
        exit 9
      fi
      tspi_warn "回滚也失败（rc=$rc2）：$ERR；进入 off"
    fi
    stop_all
    rm -f "$TSPI_MODE_FILE"
    echo off > /etc/tspi/last-mode 2>/dev/null || true
    state_write off error "$ERR"
    [[ "$JSON_OUT" == 1 ]] && do_status
    exit "$rc"
  fi

  if [[ "$DRY" == 0 ]]; then
    echo "$target" > "$TSPI_MODE_FILE"
    mkdir -p /etc/tspi 2>/dev/null || true
    echo "$target" > /etc/tspi/last-mode 2>/dev/null || true
    state_write "$target" active ""
    tspi_log "模式 $target 就绪"
    [[ "$JSON_OUT" == 1 ]] && do_status
  fi
  exit 0
}

# -----------------------------------------------------------------------------
# 状态
# -----------------------------------------------------------------------------

# B2（板端 GM）的 PTP 状态对象：role=master；lock=端口已进入 MASTER。
# 由 tspi-mode 直接查 pmc，不经过 tspi-ptp-status（后者只认 dante/aes67 两种接收端）。
b2_ptp_json() {
  local st id lockv rawv offv
  st="$(gm_port_state)"
  id="$(gm_identity)"
  case "$st" in
    MASTER) lockv=true; rawv="master" ;;
    "")     lockv=null; rawv="unknown" ;;
    *)      lockv=false; rawv="not-master" ;;
  esac
  if [[ "$lockv" == true ]]; then offv=0; else offv=null; fi
  jq -n --arg st "$st" --arg id "$id" --argjson lock "$lockv" --arg raw "$rawv" \
        --argjson off "$offv" --arg svc "tspi-ptp4l-master.service" \
    '{role:"master", source:"ptp4l", lock:$lock, lock_raw:$raw, offset_ns:$off,
      port_state:(if $st == "" then null else $st end),
      grandmaster:(if $id == "" then null else $id end), service:$svc}'
}

do_status() {
  local mode state ptp_json cfg_json cdsp_state cdsp_pid ptp_role aoip_kind aoip_svc aoip_ready last_err
  mode="$(cat "$TSPI_MODE_FILE" 2>/dev/null || echo off)"
  state="$(jq -r '.state // "off"' "$TSPI_STATE_FILE" 2>/dev/null || echo off)"
  last_err="$(jq -r '.last_error // ""' "$TSPI_STATE_FILE" 2>/dev/null || echo "")"
  cfg_json="$(cat "$CONFIG_FILE" 2>/dev/null || echo "{}")"
  ptp_json="$(tspi-ptp-status --json 2>/dev/null || echo "{}")"
  [[ "$mode" == "b2" ]] && ptp_json="$(b2_ptp_json)"
  input_json="$(cat "$TSPI_RUN_DIR/input-content.json" 2>/dev/null || echo "{}")"
  cdsp_state="$(systemctl is-active tspi-camilladsp.service 2>/dev/null || true)"
  cdsp_pid="$(systemctl show -p MainPID --value tspi-camilladsp.service 2>/dev/null || echo 0)"
  case "$mode" in
    dante) aoip_kind="inferno"; aoip_svc="tspi-statime-inferno.service";
           tspi_svc_active "$aoip_svc" && aoip_ready=true || aoip_ready=false ;;
    aes67) aoip_kind="aes67-daemon"; aoip_svc="tspi-aes67-daemon.service";
           tspi_svc_active "$aoip_svc" && aoip_ready=true || aoip_ready=false ;;
    b2)
           # B2：接收端=Inferno（无独立 daemon），媒体时钟=PHC usrvclock 桥；--ptp-only 时无音频
           if [[ "$(b2_audio_flag)" == "0" ]]; then
             aoip_kind="none"; aoip_svc="-"; aoip_ready=false
           else
             aoip_kind="inferno"; aoip_svc="tspi-phc-usrvclock.service"
             tspi_svc_active "$aoip_svc" && [[ -e /tmp/ptp-usrvclock ]] && aoip_ready=true || aoip_ready=false
           fi ;;
    *) aoip_kind="none"; aoip_svc="-"; aoip_ready=false ;;
  esac

  if [[ "$JSON_OUT" == 1 || "${1:-}" == "--json" ]]; then
    # 顶层 ptp_role/ptp_lock/pid 是给 web-manager 的便捷字段（与 ptp/camilladsp 嵌套字段同值）
    jq -n --arg schema "tspi-audio/v1" --arg ts "$(date -Is)" --arg mode "$mode" --arg state "$state" \
      --argjson ptp "$ptp_json" --argjson cfg "$cfg_json" --argjson input "$input_json" \
      --arg cdsp_state "${cdsp_state:-inactive}" --arg cdsp_pid "${cdsp_pid:-0}" \
      --arg aoip_kind "$aoip_kind" --arg aoip_svc "$aoip_svc" --argjson aoip_ready "$aoip_ready" \
      --arg last_err "$last_err" \
      '{schema:$schema, ts:$ts, mode:$mode, state:$state,
        layout:($cfg.layout // null), outputs:($cfg.outputs // null),
        ptp_role:($ptp.role // null), ptp_lock:($ptp.lock // null), pid:($cdsp_pid|tonumber? // null),
        ptp:$ptp,
        input_content:$input,
        aoip:{kind:$aoip_kind, service:$aoip_svc, ready:$aoip_ready},
        camilladsp:{service:"tspi-camilladsp.service", state:$cdsp_state, pid:($cdsp_pid|tonumber? // null),
                    config:($cfg.mode // null), samplerate:($cfg.samplerate // null),
                    chunksize:($cfg.chunksize // null), target_level:($cfg.target_level // null),
                    adjust_period:($cfg.adjust_period // null)},
        alsa:{playback:($cfg.playback_device // null), playback_channels:($cfg.playback_channels // null),
              playback_format:($cfg.playback_format // null), capture:($cfg.capture_device // null),
              capture_format:($cfg.capture_format // null), capture_channels:($cfg.capture_channels // null)},
        last_error:(if $last_err == "" then null else $last_err end)}'
  else
    printf "mode:       %s\nstate:      %s\n" "$mode" "$state"
    printf "ptp:        role=%s source=%s lock=%s offset_ns=%s\n" \
      "$(printf "%s" "$ptp_json" | jq -r '.role // "?"')" \
      "$(printf "%s" "$ptp_json" | jq -r '.source // "?"')" \
      "$(printf "%s" "$ptp_json" | jq -r '.lock // "?"')" \
      "$(printf "%s" "$ptp_json" | jq -r '.offset_ns // "?"')"
    if [[ "$mode" == "b2" ]]; then
      printf "ptp_gm:     port_state=%s grandmaster=%s\n" \
        "$(printf "%s" "$ptp_json" | jq -r '.port_state // "?"')" \
        "$(printf "%s" "$ptp_json" | jq -r '.grandmaster // "?"')"
    fi
    printf "aoip:       %s (%s) ready=%s\n" "$aoip_kind" "$aoip_svc" "$aoip_ready"
    printf "camilladsp: %s pid=%s config=%s\n" "${cdsp_state:-inactive}" "${cdsp_pid:-0}" "$(printf "%s" "$cfg_json" | jq -r '.mode // "?"')"
    printf "samplerate: %s\nchunksize:  %s\ntarget:     %s\n" \
      "$(printf "%s" "$cfg_json" | jq -r '.samplerate // "?"')" \
      "$(printf "%s" "$cfg_json" | jq -r '.chunksize // "?"')" \
      "$(printf "%s" "$cfg_json" | jq -r '.target_level // "?"')"
    printf "alsa:       pb=%s (%sch/%s) cap=%s (%sch/%s)\n" \
      "$(printf "%s" "$cfg_json" | jq -r '.playback_device // "?"')" \
      "$(printf "%s" "$cfg_json" | jq -r '.playback_channels // "?"')" \
      "$(printf "%s" "$cfg_json" | jq -r '.playback_format // "?"')" \
      "$(printf "%s" "$cfg_json" | jq -r '.capture_device // "?"')" \
      "$(printf "%s" "$cfg_json" | jq -r '.capture_channels // "?"')" \
      "$(printf "%s" "$cfg_json" | jq -r '.capture_format // "?"')"
    [[ -n "$last_err" ]] && printf "last_error: %s\n" "$last_err"
  fi
}

# -----------------------------------------------------------------------------
# main
# -----------------------------------------------------------------------------
case "$CMD" in
  status) do_status; exit 0 ;;
  restore)
    last="$(cat /etc/tspi/last-mode 2>/dev/null || true)"
    case "$last" in
      dante|aes67|b2) CMD="$last" ;;
      *) tspi_log "无 last-mode 或为 off，不自动恢复"; exit 0 ;;
    esac
    ;;
esac

# AES67 PTP 角色=master 兼容别名：转入 b2（板端 GM）。
# 不能沿用 aes67 分支：aes67-daemon/LKM 是 PTP slave-only 且只在 PRE_ROUTING 收包，
# 本机 ptp4l 的包走 LOCAL_OUT 永远收不到（RISKS D1），所以 B2 的接收端是 Inferno+PHC 桥。
if [[ "$CMD" == "aes67" && "${TSPI_AES67_PTP_ROLE:-slave}" == "master" ]]; then
  tspi_warn "TSPI_AES67_PTP_ROLE=master → 按 B2 启动（板端 ptp4l GM；不启 aes67-daemon/LKM）"
  CMD="b2"
fi
[[ "$PTP_ONLY" == 1 && "$CMD" != "b2" ]] && { echo "--ptp-only 仅适用于 b2 模式" >&2; usage 2; }

# 串行化：同一时刻只允许一个切换
mkdir -p /run/lock "$TSPI_RUN_DIR"
exec 9>"/run/lock/tspi-mode.lock" || tspi_die "无法打开锁文件" 1
if ! flock -n 9; then
  if [[ "$JSON_OUT" == 1 ]]; then do_status; fi
  echo "another tspi-mode transition is in progress" >&2
  exit 10
fi

case "$CMD" in
  off) do_off ;;
  dante|aes67|b2) do_transition "$CMD" ;;
  *) usage 2 ;;
esac
