#!/usr/bin/env bash
# tspi-ptp-status — 当前模式的 PTP 状态（给 tspi-mode status 与 web-manager 用）
#
# 输出（--json，默认）：
#   {"role":"slave","source":"statime-ptpv1","lock":true,"lock_raw":"slave",
#    "offset_ns":1234,"port_state":"Slave","grandmaster":"...","service":"tspi-statime-inferno.service"}
# 说明：
#   - Dante 模式：读 statime 观测 socket（/run/tspi/statime-observe.sock，JSON 里 current_ds.offset_from_master
#     是 i128 定点，数值 ≈ nanoseconds*2^32；本脚本换算为 ns（近似））；lock = port_state==Slave 且 |offset|<阈值。
#   - AES67 模式（B1）：读 aes67-daemon 的 ptp_status_script 写出的 /run/tspi/ptp-lock，回退 REST /api/ptp/status。
#   - off/其它：lock=null。
#
# 用法：tspi-ptp-status [--json|--human]
set -uo pipefail
. /usr/local/lib/tspi/lib.sh
tspi_load_defaults 2>/dev/null || true

JSON=1
[[ "${1:-}" == "--human" ]] && JSON=0

MODE="$(cat "$TSPI_MODE_FILE" 2>/dev/null || echo off)"
ROLE="none"; SRC="none"; SVC="-"; LOCK="null"; RAW="unknown"; OFF="null"; PSTATE="null"; GM="null"

bits_to_ns() {
  local b="$1"
  [[ -z "$b" || "$b" == "null" ]] && { echo ""; return 1; }
  case "$b" in *[eE]*) b="$(awk -v x="$b" 'BEGIN{printf "%.0f", x}')" ;; esac
  # I96F32: value = bits / 2^32 (nanoseconds)，取整到 ns
  awk -v x="$b" 'BEGIN{printf "%.0f", x/4294967296}'
}

case "$MODE" in
  dante)
    ROLE="slave"; SRC="statime-ptpv1"; SVC="tspi-statime-inferno.service"
    RAWJSON="$(tspi_statime_observe 2>/dev/null || true)"
    if [[ -n "$RAWJSON" ]]; then
      PSTATE="$(printf "%s" "$RAWJSON" | jq -r '.instance.port_ds[0].port_state // "unknown"' 2>/dev/null || echo unknown)"
      GM="$(printf "%s" "$RAWJSON" | jq -r '.instance.parent_ds.grandmaster_identity // "unknown"' 2>/dev/null || echo unknown)"
      BITS="$(printf "%s" "$RAWJSON" | jq -r '.instance.current_ds.offset_from_master // empty' 2>/dev/null || true)"
      NS="$(bits_to_ns "$BITS" 2>/dev/null || true)"
      [[ -n "$NS" ]] && OFF="$NS"
      ABS="${NS#-}"
      if [[ "$PSTATE" == "Slave" && -n "$ABS" && "$ABS" -lt "${TSPI_LOCK_THRESHOLD_NS:-1000000}" ]]; then LOCK="true"; RAW="locked"
      elif [[ "$PSTATE" == "Slave" ]]; then LOCK="false"; RAW="locking"
      else LOCK="false"; RAW="unlocked"; fi
    else
      RAW="unknown"; LOCK="null"
    fi
    ;;
  aes67)
    ROLE="slave"; SRC="aes67-daemon"; SVC="tspi-aes67-daemon.service"
    RAW="$(tspi_aes67_ptp_status 2>/dev/null || echo unknown)"
    case "$RAW" in
      locked)   LOCK="true" ;;
      locking)  LOCK="false" ;;
      unlocked) LOCK="false" ;;
      *)        LOCK="null"; RAW="${RAW:-unknown}" ;;
    esac
    if [[ "$TSPI_AES67_PTP_ROLE" == "master" ]]; then ROLE="master"; SRC="ptp4l"; SVC="tspi-ptp4l-master.service"; fi
    ;;
  *) LOCK="null"; RAW="none" ;;
esac

if [[ "$JSON" == 1 ]]; then
  jq -n \
    --arg role "$ROLE" --arg source "$SRC" --arg lock_raw "$RAW" --arg service "$SVC" \
    --argjson lock "$LOCK" --argjson offset_ns "${OFF}" --arg port_state "$PSTATE" --arg gm "$GM" \
    '{role:$role, source:$source, lock:$lock, lock_raw:$lock_raw, offset_ns:$offset_ns,
      port_state:$port_state, grandmaster:$gm, service:$service}'
else
  printf "mode: %s\nrole: %s\nsource: %s\nlock: %s (%s)\noffset_ns: %s\nport_state: %s\ngrandmaster: %s\nservice: %s\n" \
    "$MODE" "$ROLE" "$SRC" "$LOCK" "$RAW" "${OFF:-null}" "$PSTATE" "$GM" "$SVC"
fi
