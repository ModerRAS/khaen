#!/usr/bin/env bash
# ptp-status-hook — aes67-daemon 的 ptp_status_script 回调
# 上游 daemon 在 PTP 状态变化时以第一个参数传 unlocked|locking|locked 调用本脚本。
# 作用：把状态写到 /run/tspi/ptp-lock，供 tspi-mode / web-manager 查询（避免每次轮询 REST）。
set -u
STATE="${1:-unknown}"
OUT=/run/tspi/ptp-lock
mkdir -p /run/tspi 2>/dev/null || true
TMP="$OUT.tmp.$$"
printf "%s %s %s\n" "$STATE" "$(date +%s)" "$(date -Is)" > "$TMP" 2>/dev/null && mv -f "$TMP" "$OUT" 2>/dev/null || true
logger -t tspi-audio-ptp -- "aes67 daemon PTP status: $STATE" 2>/dev/null || true
exit 0
